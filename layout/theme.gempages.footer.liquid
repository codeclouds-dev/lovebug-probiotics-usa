       {% render 'datalayer' %}
        <!-- End Google Tag Manager -->
      {% endunless %}

      <script src="{{ 'preloads.js' | asset_url }}" defer></script>

<!-- Cookie Consent Banner -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.css" />
<script src="https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.js"></script>
<script>
  window.addEventListener("load", function(){
    window.cookieconsent.initialise({
      palette: {
        popup: { background: "#000" },
        button: { background: "#f1d600" }
      },
      theme: "classic",
      position: "bottom",
      content: {
        message: "This website uses cookies to ensure you get the best experience.",
        dismiss: "Got it!",
        link: "Learn more",
        href: "/policies/privacy-policy"
      }
    });
  });
</script>

       {% render 'rebuy-extensions' %} 
       
       <script src="https://analytics.ahrefs.com/analytics.js" data-key="bZ/7uAiSsxNDya+XPBuYhQ" async></script>
  </head>
  
  
    {% if settings.top_offset_element == "main" %}
      {% assign top_offset_class = "top-offset-to-main" %}
    {% elsif settings.top_offset_element == "first_section" %}
      {% assign top_offset_class = "top-offset-to-first-section" %}
    {% endif %}
    {% assign top_offset = "--top-offset: " | append: settings.top_offset | append: "px;" %}
    {% assign top_offset_mobile = "--top-offset-mobile: " | append: settings.top_offset_mobile | append: "px;" %}
  
    {% assign header_style = "" %}
  
    {% if page.metafields.mfr_fields.header_style %}
      {% assign header_style = "dark-theme-header" %}
    {% endif %}
  
    <body id="{{ page_title | handle }}" class="template-{{ template.name | handle }} {{ top_offset_class }} {{ header_style }} {% if customer != blank %}customer-logged-in{% endif %}" 
      style="{{ top_offset }} {{ top_offset_mobile }}"
      x-data>
      {% unless request.design_mode %}
       <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MHLTQQDZ"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
      {% endunless %}
      
      <div style="display:none"> {% section 'preloader' %} </div>
  
      <a class="skip-to-content-link button visually-hidden" href="#MainContent">
        {{ "accessibility.skip_to_text" | t }}
      </a>
  
      
  
      <div style="display:none"> {% sections 'offcanvas-group' %} </div>
  
      <ul hidden>
        <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      </ul>
  
      <style>
        .off-canvas:not(.is-loaded) {
          display: none;
        }
      </style>
  
      <header class="header" id="header" data-inview>
        <div style="display:none"> {% sections 'header-group' %} </div>
      </header>
      <main 
        id="MainContent" 
        class="content-for-layout focus-none" 
        role="main" 
        tabindex="-1">
        <h1 class="visually-hidden"> {{ page_title }}</h1>
        {{ content_for_layout }}
      </main>
      <footer class="footer" id="footer">
        {% sections 'footer-group' %}
      </footer>

      {% sections 'modals-group' %}
      
      <script>
        window.routes = {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}'
        };
  
        window.cartStrings = {
          error: `{{ 'sections.cart.cart_error' | t }}`,
          quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t }}`
        }
  
        window.variantStrings = {
          addToCart: `{{ 'products.product.add_to_cart' | t }}`,
          soldOut: `{{ 'products.product.sold_out' | t }}`,
          unavailable: `{{ 'products.product.unavailable' | t }}`,
        }
      </script>

      <script>
      const url = new URL(window.location.href);
      const fullCanonical = url.origin + url.pathname + url.search;
      let canonicalTag = document.querySelector('link[rel="canonical"]');
      console.log("canonicalTag",canonicalTag);
      canonicalTag.setAttribute('href', fullCanonical);
      console.log("canonicalTag",canonicalTag);
      </script>

      {% render 'scripts__deferred-tags', position: "footer" %}
  
      {% capture CFH %}{{ content_for_header  }}{% endcapture %}
      {% if CFH contains 'preview_bar_injector-' %}
        {% unless request.design_mode %}
          {{ settings.external_scripts }}
        {% endunless %}
      {% endif %}
      
      {% render 'dress-up__character',
        cloud_text: settings.dress_up_cloud_text,
        cloud_url_mobile: settings.dress_up_cloud_url_mobile,
        cloud_url_desktop: settings.dress_up_cloud_url_desktop %}

  
    </body>
  </html>