<div class="animated-login-hero"
  x-ref='animatedHero'
  x-data='{
    usernameIsFocused: document.activeElement == $refs.usernameField,
    pupilPosition: 0,
    passwordIsFocused: document.activeElement == $refs.passwordField,
  }'
  @username-focus.window='usernameIsFocused = true'
  @username-unfocus.window='usernameIsFocused = false'
  @password-focus.window='passwordIsFocused = true'
  @password-unfocus.window='passwordIsFocused = false'
  @pupil-update.window='
    pupilPosition = $event.detail.data
  '>
  <div class="animated-login-hero__white-eye">
    {% render 'component__svg-encoder',
      svg_code: white_eye,
      width: 120,
      alt: "hero eye" %}
  </div>
  <div class="animated-login-hero__pupils"
    :style='
      usernameIsFocused ? `transform: translate(${pupilPosition}px, 5px);` : ""
    '
    :class='usernameIsFocused ? "on-input" : ""'>
    {% render 'component__svg-encoder',
      svg_code: pupils,
      width: 120,
      alt: "hero pupils" %}
  </div>
  <div class="animated-login-hero__body">
    {% render 'component__svg-encoder',
      svg_code: body,
      width: 120,
      alt: "hero body" %}
  </div>
  <div class="animated-login-hero__cape"
    :class='passwordIsFocused ? "on-input": ""'>
    {% render 'component__svg-encoder',
      svg_code: cape,
      width: 120,
      alt: "hero cape" %}
  </div>
</div>