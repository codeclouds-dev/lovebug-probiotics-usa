{% unless template == 'index' or template == 'cart' or template == 'list-collections' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "name": "Breadcrumbs",
  "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "LoveBug Probiotics",
            "item": {
                "@type": "Website",
                "@id": "https://{{ shop.domain }}",
                "url": "https://{{ shop.domain }}"
            }
        },
    {% case template.name %}
        {% when "page" %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ page.title }}",
                "item": {
                    "@type": "WebPage",
                    "@id": "https://{{ shop.domain }}{{ page.url }}",
                    "url": "https://{{ shop.domain }}{{ page.url }}"
                }
            }

        {% when "product" %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ product.title }}",
                "item": {
                    "@type": "WebPage",
                    "url": "https://{{ shop.domain }}{{ product.url }}"
                }
            }
    {% when "collection" %}
    {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ collection.title }}",
        "item": {
            "@type": "CollectionPage",
            "@id": "https://{{ shop.domain }}{{ collection.url }}",
            "url": "https://{{ shop.domain }}{{ collection.url }}"
        }
    }
        {% when "blog" %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ blog.title }}",
                "item": {
                    "@type": "WebPage",
                    "@id": "https://{{ shop.domain }}{{ blog.url }}",
                    "url": "https://{{ shop.domain }}{{ blog.url }}"
                }
            }

        {% when "article" %}
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ article.title }}",
                "item": {
                    "@type": "WebPage",
                    "@id": "https://{{ shop.domain }}{{ article.url }}",
                    "url": "https://{{ shop.domain }}{{ article.url }}"
                }
            }

    {% endcase %}
  ]
}
</script>

{% endunless %}