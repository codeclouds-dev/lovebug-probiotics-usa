{% assign alt = alt | default: "Lovebug" %}
{% assign widths = widths | default: "480,560,640,750,828,900,1023,1024,1280,1440,1600,1800,1920,2160,2560,3200,3840,4096,5120" %}
{% assign src = image | image_url %}
{% assign srcset = "" %}

{% assign image_width = image.width | default: width %}
{% assign image_height = image.height | default: height %}
{% assign aspect_ratio = image.aspect_ratio | default: 1 %}
{% assign height = width | divided_by: aspect_ratio | round: 2 %}

{%- assign class = class | append: "" -%}
{% for width_inner in widths %}
  {% assign condition1 = width_inner | times: 1 %}
  {% assign condition2 = width | times: 1 %}
  {% if condition1 <= condition2 %}
    {% assign srcset = srcset | append: src | append: "&width=" | append: width_inner | append: " " | append: width_inner | append: "w" %}
    {% unless forloop.last %}
      {% assign srcset = srcset | append: "," %}
    {% endunless %}
  {% endif %}
{% endfor %}

{%- capture styles -%}

{%- endcapture -%}

{%- assign loading_strategy = loading | default: "lazy" -%}

{% if image != blank %}
  {{ image 
    | image_url: width: width 
    | image_tag: class: class, 
      widths: widths, 
      width: width, 
      height: height, 
      alt: alt,
      loading: loading_strategy,
      sizes: sizes,
      style: styles }}
{% else %}
  {% render 'component__placeholder-image', size: placeholder_size %}
{% endif %}
