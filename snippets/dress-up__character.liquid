{% assign types = "Skin,Faces,Hair,Outfits" | split: "," %}
{% assign metaobjects = shop.metaobjects.dress_up_item.values %}
<template
  x-if='localStorage.getItem( "mfr-lb__dress-up" )'>
  <div class="dress-up__character"
    id="dressUpCharacter"
    x-data='{
      selectedItems: localStorage.getItem( "mfr-lb__dress-up" ) ? JSON.parse(localStorage.getItem( "mfr-lb__dress-up" )) : {
        {%- for type in types %}
          {%- assign first_option = metaobjects | where: "item_type", type | first -%}
          {{ type }}: "{{- first_option.label | handleize -}}",
        {%- endfor -%}
      },
      items: {
        {%- for item in metaobjects -%}
          "{{- item.item_type | handleize -}}--{{- item.label | handleize -}}": {
            label: "{{- item.label -}}",
            itemType: "{{- item.item_type -}}",
            thumbnail: "{{- item.thumbnail | image_url: width: 144 -}}",
            itemImageMobile: "{{- item.item_image_mobile | image_url: width: 1023 -}}",
            itemImageDesktop: "{{- item.item_image | image_url: width: 1023 -}}"
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      },
      show: false,
      onVisibilityChange(element, callback) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              callback(true);
            } else {
              callback(false);
            }
          });
        });

        element.forEach( (e,i) => observer.observe(e));
      },

      checkInitialVisibility(element, callback) {
        element.forEach(e => {
          // Manually check if the element is in the viewport
          const rect = e.getBoundingClientRect();
          const isVisible = rect.top >= 0 && rect.left >= 0 && rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) && rect.right <= (window.innerWidth || document.documentElement.clientWidth);
          callback(isVisible);
        });
      },

      isEinsteinShowing: false,
      einsteinTimeout: false,
      showEinstein() {
        clearTimeout(this.einsteinTimeout);
        this.isEinsteinShowing = true;

        this.einsteinTimeout = setTimeout( () => {
          this.isEinsteinShowing = false;
        }, 15000 );
      }
    }'
    x-init='
      const targetElement = document.querySelectorAll("#footer,.product-top");
      // Set up IntersectionObserver to track visibility changes
      $data.onVisibilityChange(targetElement, (isVisible) => {
        show = !isVisible;
      });
    '
    @update-character-data.window='
      selectedItems = $event.detail.data
    '
    @show-einstein.window='
      showEinstein();
    '
    x-transition:enter-start='scale-0 opacity-0'
    x-transition:leave-end='scale-0 opacity-0'
    x-show='show'
    x-cloak>
    <a href="{{ cloud_url | default: '#' }}" 
      :href='linkUrl'
      aria-label="{{ cloud_text }}"
      title="{{ cloud_text }}" class="dress-up__character-inner floating {% if cloud_text != blank %}has-cloud{% endif %}"
      x-data='{
        urlMobile: "{{ cloud_url_mobile | default: '#' }}",
        urlDesktop: "{{ cloud_url_desktop | default: '#' }}",
        linkUrl: "#",
        updateLink() {
          this.linkUrl = window.innerWidth < 1023
            ? this.urlMobile
            : this.urlDesktop;
        }
      }'
      x-on:resize.window="updateLink()"
      x-init="updateLink()">

      {%- capture einstein_svg -%}{%- render 'lb__einstein-character' -%}{%- endcapture -%}
      <span class="geek-switch__einstein"
        x-cloak
        x-show='isEinsteinShowing'
        x-transition:enter-start='showing'
        x-transition:leave-end='showing'>
        {% render 'component__svg-encoder',
          svg_code: einstein_svg,
          width: 144,
          alt: "einstein character" %}
      </span>
      <div class="dress-up__image-character"
        x-show='!isEinsteinShowing'
        x-transition:enter-start='showing'
        x-transition:leave-end='showing'>
        {%- for type in types -%}
          <div class="dress-up__image-{{ type | handleize }}">
            <template
              x-if='selectedItems.{{ type }} && selectedItems.{{ type }} != "" && window.innerWidth <= 1023'>
              <img :src='items["{{- type | handleize -}}--" + selectedItems.{{ type }}].itemImageMobile' alt="super hero background" width="856" height="629" loading="lazy">
            </template>
            <template
              x-if='selectedItems.{{ type }} && selectedItems.{{ type }} != "" && window.innerWidth >= 1024'>
              <img :src='items["{{- type | handleize -}}--" + selectedItems.{{ type }}].itemImageDesktop' alt="super hero background" width="856" height="629" loading="lazy">
            </template>
          </div>
        {%- endfor -%}
        <div class="dress-up__image-shadow">
          {%- capture shadow_svg_code -%}
            <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="204" height="46">
