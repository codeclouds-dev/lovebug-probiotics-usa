            </svg>
          {%- endcapture -%}
          {% render 'component__svg-encoder',
            svg_code: shadow_svg_code,
            alt: "shadow" %}
        </div>
      </div>

      {% comment %} {% if cloud_text != blank %}
        {%- capture cloud_svg -%}
