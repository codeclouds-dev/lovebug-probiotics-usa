        {% comment %} <div
          class="dress-up__character-cloud">
          {% render 'component__svg-encoder',
            svg_code: cloud_svg,
            alt: "cloud svg icon",
            width: 144
           %}
          {% comment %} <span>{{ cloud_text }}</span> {% endcomment %}
        </div> {% endcomment %}
      {% endif %} {% endcomment %}
