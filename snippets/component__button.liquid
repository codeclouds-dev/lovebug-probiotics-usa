{%- comment -%}
  Attributes
  - label
  - link
  - max_width

  - text_color
  - bg_color
  - border_color

  - text_color_hover
  - bg_color_hover
  - border_color_hover
{%- endcomment -%}
{% if link contains '#' %}
  {% assign scroll_to_section_class = "scroll-to-section" %}
{% else %}
  {% assign scroll_to_section_class = "" %}
{% endif %}
<a href="{{ link | default: '#' }}"
  class="button {{ color_theme | default: '' }} {{ button_width }} "
  {% if link == blank %} 
    aria-disabled="true"
  {% endif %}
  {% if new_tab %}
    target="_blank"
  {% endif %}
  data-inview
  {{ block.shopify_attributes }}>
  {% if icon %}
    <div class="icon">
      {{ icon | image_url: width: '50px' | image_tag: alt: icon.alt, width: '50px' }}
    </div>
  {% endif %}

  <span class="text">{{ label | escape }}</span>

  {% comment %} {% if button_has_arrow %} {% endcomment %}
    {% comment %} <span class="arrow {{ arrow_direction }}">
      {%- render 'icon__right-arrow' -%}
    </span> {% endcomment %}
  {% comment %} {% endif %} {% endcomment %}
</a>