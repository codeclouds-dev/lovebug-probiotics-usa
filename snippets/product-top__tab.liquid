{%- capture first_tab -%}
    {% render 'product-top__form',
        product: product,
        blocks: blocks %}
{%- endcapture -%}
{% assign light_color = light_color | default: "#DFFCA0" %}
{% assign dark_color = dark_color | default: "#DFFCA0" %}

<div class="product-top__tab product__form" data-inview>
    <ul class="tabs" data-tabs id="product-top-tabs">
        <li class="tabs-title is-active">
            <a href="#product-tab-panel-1" aria-selected="true">
                {{ first_tab_title }}
            </a>
        </li>
        {% if second_tab_embed != blank %}
            <li class="tabs-title">
                <a href="#product-tab-panel-2">
                    {{ second_tab_title }}
                </a>
            </li>
        {% endif %}
    </ul>
    <div class="tabs-content" data-tabs-content="product-top-tabs">
        <div class="tabs-panel is-active" id="product-tab-panel-1">
            {{ first_tab }}
        </div>
        {% if second_tab_embed != blank %}
            <div class="tabs-panel" id="product-tab-panel-2">
                {% for block in blocks %}
                    {% case block.type %}
                        {% when "form_caption" %}
                            {% render 'product-top__form-caption', block: block %}

                    {% endcase %}
                {% endfor %}

                <div class="tabs-panel__inner">
                    {{ second_tab_embed }}
                    <script>
                        onReady( () => {
                            if( !$( "#product-tab-panel-2 #destini-locator" ).length ) return;
                            const checkForWidget = new Promise( ( resolve, reject ) => {
                                const interval = setInterval( () => {
                                    if( $( $( "#product-tab-panel-2 #destini-locator" ).get( 0 ).shadowRoot ).find( "chakra-scope" ).length ) {
                                        clearInterval( interval );
                                        resolve();
                                    }
                                }, 1 );
                            } );

                            checkForWidget.then( () => {
                                const host = $( $( "#product-tab-panel-2 #destini-locator" ).get( 0 ).shadowRoot );
                                const customStylingForWidget = $( `
                                    <style>
                                        .chakra-portal main  { 
                                            overflow: hidden;
                                        }
                                        .chakra-portal .chakra-popover__popper {
                                            width: 100% !important;
                                            min-width: unset !important;
                                            display: flex;
                                            justify-content: stretch;
                                            align-items: stretch;
                                            max-height: 280px;
                                        }
                                        @media screen and (min-width: 1024px) {
                                            .chakra-portal .chakra-popover__popper {
                                                max-height: 190px;
                                            }
                                        }
                                        .chakra-portal .chakra-popover__popper > section {
                                            width: 90% !important;
                                            margin: 0 auto;
                                            overflow: auto;
                                        }
                                        .chakra-portal > div > div,
                                        .chakra-portal > div > header,
                                        #locator-template {
                                            background-color: {{ light_color }} !important;
                                            color: {{ dark_color }} !important;
                                        }
                                        .chakra-portal > div > div > div,
                                        .chakra-portal > div > header > div,
                                        .chakra-portal > div > div > button,
                                        .chakra-portal > div > header > button {
                                            width: 100%;
                                        }
                                        .chakra-portal > div > div,
                                        .chakra-portal > div > header { 
                                            padding: 0;
                                            margin-bottom: 30px;
                                        }
                                        .chakra-portal > div > div button,
                                        .chakra-portal > div > header button {
                                            background-color: {{ dark_color }} !important;
                                            color: white !important;
                                            stroke: currentColor;
                                            font-size: 14px;
                                            padding-left: 15px;
                                            padding-right: 15px;
                                        }
                                        .chakra-portal > div > header button svg,
                                        .chakra-portal > div > div button svg {
                                            background-color: {{ dark_color }} !important;
                                            color: white !important;
                                            stroke: currentColor;
                                        }
                                        .chakra-portal > div > header .chakra-form-control .chakra-input__right-element {
                                            width: 150px;
                                        }
                                        .chakra-portal > div > header .chakra-form-control .chakra-input__right-element button {
                                            width: 150px;
                                            right: 0;
                                        }
                                        .chakra-portal > div > div [aria-haspopup="dialog"] button {
                                            width: 100%;
                                        }
                                        .chakra-portal > div > div input {
                                            border-color: {{ dark_color }} !important;
                                            color: {{ dark_color }} !important;
                                        }
                                        .chakra-portal footer {
                                            background-color: {{ dark_color }} !important;
                                            color: white !important;
                                        }
                                        .chakra-portal footer a,
                                        .chakra-portal footer a span,
                                        .chakra-portal footer a svg path,
                                        .chakra-portal footer span  {
                                            color: white;
                                            fill: currentColor;
                                        }
                                        .chakra-portal main [role="tablist"] > button {
                                            color: {{ dark_color }} !important;
                                            border-color: {{ dark_color }} !important;
                                            font-size: 14px;
                                        }
                                        .chakra-portal main .chakra-tabs__tab-panels {
                                            #find-store-list li {
                                                background-color: white;
                                            }
                                        }
                                    </style>
                                ` );
                                host.prepend( customStylingForWidget );
                            });
                        } );
                    </script>
                </div>
            </div>
        {% endif %}
    </div>
</div>