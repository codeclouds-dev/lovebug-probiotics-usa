{% assign metafields = product.metafields %}

{% if metafields.mfr_fields.nice_title != blank %}
  <input type="hidden" name="properties[_nice_title]" value="{{ metafields.mfr_fields.nice_title }}">
{% endif %}

{% assign first_selling_plan_group = product.selling_plan_groups | first %}
{% assign first_selling_plan = first_selling_plan_group.selling_plans | first %}
{% assign first_selling_plan_id = first_selling_plan.id %}

<input type="hidden" name="properties[_bg_color]" value="{{ metafields.mfr_fields.product_card_accent_color | default: '#E50695' }}">
<input type="hidden" name="properties[_variant_nice_title]" value="{{ product.selected_or_first_available_variant.metafields.mfr_fields.variant_nice_title }}">
<input type="hidden" name="properties[_accent_color]" value="{{ metafields.mfr_fields.product_card_accent_color | default: '#E50695' }}">