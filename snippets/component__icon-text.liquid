<div class="icon-text icon-text--{{ icon_texts.size }}"
  data-stagger-inview=".icon-text__item"
    {% comment %} data-lag="0.2" {% endcomment %}
    >
    {% for icon_text in icon_texts %}
        <{% if icon_text.settings.url != blank %}a href="{{ icon_text.settings.url }}"{% else %}div{% endif %} 
          class="icon-text__item">
            <div class="icon-text__logo">
              <div class="icon-text__logo-inner">
                {% render 'component__lazyload-image',
                  image: icon_text.settings.icon,
                  width: 360,
                  alt: icon_text.settings.icon.alt %}
              </div>
            </div>
            <div class="icon-text__text color_theme_text">
                {{ icon_text.settings.text 
                | replace: "[small]", "<span class='very-small-text'>"
                | replace: "[/small]", "</span>" }}
            </div>
        </{% if icon_text.settings.url != blank %}a{% else %}div{% endif %}>
    {% endfor %}
</div>