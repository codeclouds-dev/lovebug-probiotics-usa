{%- assign metafields = product.metafields.mfr_fields -%}
<div id="product-card--{{ product.id }}" class="product-card"
  style="
    --product-card-color: {{ metafields.product_card_accent_color | default: '#E50695' }};
  ">
  {% render 'component__product-badges',
    product: product %}
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__images no-hover"
      title="Images for {{ product.title }}"
      aria-label="Images for {{ product.title }}">
      <div class="product-card__main-image">
        {% assign default_alt = "main product image for " | append: product.title %}
        {% assign alt = metafields.product_card_main_image.alt | default: default_alt %}
        {%- assign main_image = metafields.product_card_main_image | default: product.featured_image -%}
        {% render 'component__lazyload-image',
          image: main_image,
          width: 420,
          alt: alt %}
      </div>
      {% if metafields.product_card_secondary_image != blank %}
        <div class="product-card__secondary-image">
          {% assign default_alt = "secondary product image for " | append: product.title %}
          {% assign alt = metafields.product_card_secondary_image.alt | default: default_alt %}
          {%- assign secondary_image = metafields.product_card_secondary_image -%}
          {% render 'component__lazyload-image',
            image: secondary_image,
            width: 800,
            alt: alt %}
        </div>
      {% endif %}
      {% if product.selling_plan_groups != blank %}
        {% assign selling_plan_groups = product.selling_plan_groups[0] %}
        {% assign discount_percentage = selling_plan_groups.selling_plans[0].price_adjustments[0].value %}
        {%- assign discount_decimal = discount_percentage -%}
        <span class="product-card__subscription-message"
          x-data='{
            isDark(element) {
              const bgColor = "{{ metafields.product_card_accent_color | default: '#E50695' }}";
              const colorInstance = tinycolor(bgColor);
              const darkThreshold = 0.5;
              const luminance = colorInstance.getLuminance();

              return luminance < darkThreshold;
            }
          }'
          x-init='
            $el.style.color = isDark($el) ? "#fff" : "#2B3990";
          '>
          {% capture arrow_svg %}
