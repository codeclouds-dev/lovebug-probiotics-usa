    "mfr_lb_press_cards_XeyVQa": {
      "type": "mfr-lb__press-cards",
      "blocks": {
        "heading_rYwGM9": {
          "type": "heading",
          "settings": {
            "heading": "Problematic Trends",
            "disable_animation": false,
            "header_style": "h2",
            "make_xl": "",
