        "text_iVpAD3": {
          "type": "text",
          "settings": {
            "text": "<p>Probiotics are \"good\" or \"friendly\" bacteria, and they help maintain a balanced gut microbiome by promoting the growth of healthy bacteria.<\/p>",
            "disable_animation": false,
            "text_style": "xlarge",
            "color": "",
            "max_width": 0
          }
        },
        "geek_info_VMqcqV": {
          "type": "geek_info",
          "settings": {
            "title": "Probiotics are live microorganisms (good bacteria and yeasts)",
            "caption": "that naturally live in your gut and help keep it healthy. Think of them as the friendly bacteria that balance the bad ones and support your body in functioning its best."
          }
        },
        "geek_info_YydkAM": {
          "type": "geek_info",
          "settings": {
            "title": "We need probiotics because our gut is like the body’s command center",
            "caption": "—it plays a big role in digestion, immunity, mood, and even energy levels. Stress, diet, illness, and antibiotics can all throw your gut out of balance, leading to issues like bloating, fatigue, and a weakened immune system."
          }
        },
        "geek_info_bEBAmB": {
          "type": "geek_info",
          "settings": {
            "title": "They're like tiny superheroes for your body! 🦸‍♀️🦠",
