{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__banner-with-box.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- assign desktop_position = section.settings.desktop_position -%}
{%- assign mobile_alignment = section.settings.mobile_alignment -%}
{%- assign box_color = section.settings.box_color -%}
{%- assign banner_height = section.settings.banner_height -%}
{%- assign top_divider = section.settings.top_divider  -%}
{%- assign bottom_divider = section.settings.bottom_divider -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

<section class="mfr-core__banner-with-box background {{ custom_class }} {{ color_theme }}" id="{{ section_id }}" data-scroll-section>
  <div class="section-spacer" style="{{ spacer }}">
    <div class="grid-container full banner-carousel">
      <div class="banner__wrapper {{ grid_gutter }} {{ top_divider }} {{ bottom_divider }} {{ mobile_alignment }} {{ banner_height }}">        
				<div class="banner__slide {{ banner_height }}">
					<div class="banner__background">
            {% unless section.settings.video_mobile or section.settings.video or section.settings.image or collection.metafields.custom.banner_image_desktop %}
              <div class="shopify-placeholder-image">{{ 'image' | placeholder_svg_tag }}</div>
            {% endunless %}
						{% if section.settings.video_mobile != blank %}
							{% if section.settings.video_mobile != blank %}
								{% assign mobile_video = section.settings.video_mobile %}
								{% assign desktop_video = section.settings.video_mobile %}
							{% elsif section.settings.video != blank %}
								{% assign mobile_video = section.settings.video %}
								{% assign desktop_video = section.settings.video %}
							{% endif %}
							{% if section.settings.video != blank %}
								{% assign desktop_video = section.settings.video %}
							{% endif %}
							<div class="banner__video">
								<div class="banner__video--mobile">
									{% render "component__hosted-video", 
										media: mobile_video,
										controls: false,
										autoplay: false,
										muted: false,
										loop: false,
										play_on_view: false,
										fullscreen_on_play: true %}
								</div>
								<div class="banner__video--desktop">
									{% render "component__hosted-video", 
										media: video,
										controls: false,
										loop: false,
										autoplay: false,
										muted: false,
										play_on_view: false %}
								</div>
							</div>
						{% elsif section.settings.image != blank or section.settings.mobile_image != blank %}
							<div class="banner__image" data-image-parallax data-scroll>
                {%- capture mobile_sizes -%}
                  (max-width: 1023px) calc( 100vw - 32px )
                {%- endcapture -%}
                {%- capture desktop_sizes -%}
                  (min-width: 1024px) 100vw
                {%- endcapture -%}
                {% render 'component__responsive-image',
                  mobile_image: section.settings.mobile_image,
                  desktop_image: section.settings.image,
                  mobile_sizes: mobile_sizes,
                  desktop_sizes: desktop_sizes,
                  max_width: 2560,
                  alt: section.settings.image.alt,
                  loading_lazy: section.settings.lazyload_image %}
							</div>
						{% elsif collection.metafields.custom.banner_image_desktop != blank %}
							<div class="banner__image">
								<picture>
									<source media="(max-width: 639px)" srcset="{{ collection.metafields.custom.banner_image_mobile | img_url: '750x' }}">
									<source media="(min-width:640px)" srcset="{{ collection.metafields.custom.banner_image_desktop | img_url: '3600x' }}">
									<img loading="lazy" src="{{ collection.metafields.custom.banner_image_desktop | img_url: '3600x' }}" alt="{{ collection.metafields.custom.banner_image_desktop.alt }}">
								</picture>
							</div>
						{% endif %}
					</div>

					<div class="banner__box section-content  {{ desktop_position }} {{ text_alignment }} {{ content_alignment }}" style="background:{{ box_color }};">
						{% liquid
							if template.name == 'collection' and section.settings.custom_class contains 'collection-template'
								assign heading = collection.title
								assign content = collection.description
							else
								assign heading = section.settings.heading
								assign content = section.settings.text
							endif
						%}

            {%- for block in section.blocks -%}
              {% case block.type %}
                
                {%- when 'icon' -%}
                  {% render 'renderer__block-icon', block: block %} 
                
                {%- when 'small_text' -%}
                  {% render "renderer__block-small-text", block: block %}
        
                {%- when 'heading' -%}
                  {% render "renderer__block-title", block: block %}
                  
                {%- when 'text' -%}
                  {% render "renderer__block-text", block: block %}
                
                {%- when 'image' -%}
                  {%- assign image_position = block.settings.image_position -%}
                  <div class="image {{ image_position }}">
                    <img loading="lazy" src="{{ block.settings.image | img_url: '200' }}"
                      srcset="{{ block.settings.image | img_url: '200' }} 1x, {{ block.settings.image | img_url: '200', scale: 2 }} 2x"
                      alt="{{ block.settings.image.alt }}">
                  </div>

                {%- when 'button' -%}
                  {%- render 'component__button', 
                    button_link: block.settings.button_link, 
                    button_style: block.settings.button_style, 
                    button_color: block.settings.button_color, 
                    button_label: block.settings.button_label,
                    button_has_arrow: block.settings.button_has_arrow, 
                    button_width: block.settings.button_max_width
                  -%}

                {%- when 'app' -%}
                  {%- render 'block' -%}
              {%- endcase -%}
            {%- endfor -%}
					</div>
        </div>
      </div>
    </div>
  </div>

  {% render 'component__gradient-bg-styles' %}
  {% render 'component__accent-graphics' %}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
{
  "name": "Banner with Text Box",
  "disabled_on": {
    "groups": ["header","footer","custom.offcanvas","custom.modals"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": ""
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
    {
      "type": "header",
      "content": "Color Schemes Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color Scheme",
      "info": "This will be the color scheme of the header initially."
    },
    {
      "type": "color",
      "id": "box_color",
      "label": "Box Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "banner_height",
      "options": [
        { "value": "auto_height", "label": "Auto" },
        { "value": "small_height", "label": "Small" },
        { "value": "medium_height", "label": "Medium" },
        { "value": "large_height", "label": "Large" }
      ],
      "default": "medium_height",
      "label": "Banner height",
      "info": "config options in general settings"
    },
    {
      "type": "header",
      "content": "Box alignment"
    },
    {
      "type": "select",
      "id": "desktop_position",
      "options": [
          { "value": "top-left", "label": "Top Left" }, 
          { "value": "top-right", "label": "Top Right" },
          { "value": "bottom-left", "label": "Bottom Left" },
          { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "label": "Desktop Position",
      "default": "top-right"
    },
    {
      "type": "select",
      "id": "mobile_position",
      "options": [
        { "value": "mobile-align-top", "label": "Top" },
        { "value": "mobile-align-center", "label": "Center" },
        { "value": "mobile-align-bottom", "label": "Bottom" }
      ],
      "label": "Mobile Vertical Position",
      "default":   "mobile-align-bottom"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Specific Image"
    },
    {
      "type": "checkbox",
      "id": "lazyload_image",
      "label": "Lazyload Image?",
      "default": true
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "A Shopify-hosted video (Mobile)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "A Shopify-hosted video"
    },
    
    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },
    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks": [
  {
    "type": "@app"
  },
  {
    "type": "icon", 
    "name": "Icon",
    "limit": 4,
    "settings": [
      {
        "type": "image_picker",
        "id": "icon",
        "label": "Icon"
      },
      {
        "type": "text",
        "id": "file_lottie_url",
        "label": "File Lottie URL"
      },
      {
        "type": "number",
        "id": "icon_width",
        "label": "Image width",
        "default": 150,
        "info": "in pixels."
      }
    ]
  },
  {
    "type":"small_text",
    "name":"Accent Text",
    "limit":1,
    "settings":[
      {
        "type":"text",
        "id":"text",
        "default":"Accent Text",
        "label":"Text"
      },
      {
        "type": "color",
        "id": "small_text_color",
        "label": "Color"
      }
    ]
  },
  {
    "type": "heading",
    "name": "Heading",
    "limit": 4,
    "settings": [
      {
        "type": "inline_richtext",
        "id": "heading",
        "default": "Heading H1",
        "label": "Heading H1"
      },
      {
        "type": "checkbox",
        "id": "disable_animation",
        "label": "Disable Animation",
        "default": false
      },
      {
        "type": "select",
        "id": "header_style",
        "options": [
            { "value": "h1", "label": "H1"},
            { "value": "h2", "label": "H2"},
            { "value": "h3", "label": "H3"},
            { "value": "h4", "label": "H4"},
            { "value": "h5", "label": "H5"},
            { "value": "h6", "label": "H6"}
            ],
        "label": "Header Style",
        "default": "h1"
      },

      {
        "type": "header",
        "content": "Accent Settings"
      },
      {
        "type": "select",
        "id": "make_xl",
        "options": [
            { "value": "", "label": "Normal"},
            { "value": "xl-title", "label": "Oversize"}
            ],
        "label": "H1 Size",
        "default": "",
        "info": "H1s can be set to oversize if they need to be extra big"
      },

      {
          "type": "color",
          "id": "highlight_color",
          "label": "Highlight Color",
          "info": "Use [highlight][/highlight] to highlight text"
      },
      {
          "type": "color",
          "id": "underline_color",
          "label": "Underline Color",
          "info": "Use [underline][/underline] to underline text"
      },

      {
        "type": "header",
        "content": "Width Settings"
      },
      {
          "type": "range",
          "id": "max_width",
          "min": 0,
          "max": 60,
          "step": 1,
          "unit": "rem",
          "label": "Max Width",
          "default": 0
      }
    ]
  },
  {
    "type": "text",
    "name": "Text",
    "limit": 2,
    "settings": [
      {
        "type": "richtext",
        "id": "text",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum vel metus auctor.</p>",
        "label": "Text"
      },
      {
        "type":"select",
        "id":"text_style",
        "options":[
          { "value":"", "label":"Default" },
          { "value":"xsmall", "label":"xSmall" },
          { "value":"small", "label":"Small" },
          { "value":"regular", "label":"Regular" },
          { "value":"large", "label":"Large" },
          { "value":"xlarge", "label":"xLarge" }
        ],
        "label":"Style",
        "default":"regular"
      },
      {
        "type": "color",
        "id": "color",
        "label": "Color",
        "info": "Leave it blank to use system settings."
      },
      {
          "type": "range",
          "id": "max_width",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "rem",
          "label": "Width",
          "default": 0
      }
    ]
  },
  {
    "type":"button",
    "name":"Button",
    "limit":2,
    "settings":[
      {
        "type":"text",
        "id":"button_label",
        "default":"Button label",
        "label":"Button",
        "info":"Leave the label blank to hide the button."
      },
      {
        "type":"url",
        "id":"button_link",
        "label":"Button Link"
      },
      {
        "type": "select",
        "id": "color_theme",
        "label": "Color Theme",
        "options": [
          {
            "value": "primary",
            "label": "Primary"
          },
          {
            "value": "secondary",
            "label": "Secondary"
          },
          {
            "value": "tertiary",
            "label": "Tertiary"
          }
        ]
      }
    ]
  },
  {
    "type": "image", 
    "name": "Image",
