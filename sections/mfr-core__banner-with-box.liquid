      }
    ]
  }
  ],
  "presets": [
    {
      "name":"Banner with Text Box",
      "blocks":[
        {
          "type":"small_text"
        },
        {
          "type":"heading"
        },
        {
          "type":"text"
        }
      ]
    }
  ]
}
{% endschema %}
