<section class="compresontable-sec">

    <div class="grid-container">
         <!-- heading goes here -->
          {%- for block in section.blocks -%}
            {% case block.type %}

            

              {%- when 'heading' -%}
                {% render 'renderer__block-title', block: block %}    
                {%- endcase -%}
            
        {%- endfor -%} 

        <div class="compare_table1">
          
        {% if section.settings.img1 != blank %}
          <img src="{{ section.settings.img1 | image_url }}" alt="table">

        {% endif %}
        </div>
      
    </div>
 <form method="post" action="/cart/add">
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

   <button class="addtocart_notice button {{ button_class }} {{ has_price_class }} add-to-cart " {% unless product.available -%} disabled {%- endunless %} {{ open_off_canvas }}>
    <div class="button-text">
      {% if product.available %}
        {% if button_label != blank %}
          {{ button_label }}
        {% else %}
          {{ 'products.product.add_to_cart' | t }}
        {% endif %}
      {% else %} 
        {{ 'products.product.sold_out' | t }}
      {% endif %}
    </div>
    
    {%- if product.available -%}
      {%- if show_price == true or show_price == "true" -%}
        {% if for_subscription %}
          <span class="price">{{ first_selling_plan.price | money }}</span>
          <span class="price old">{{ first_selling_plan.compare_at_price | money }}</span>
        {% else %}
          {%- render 'price', product: product -%}
        {% endif %}
      {%- endif -%}
    {%- endif -%}
  </button>
</form>
</section>

{% schema %}
{
  "name": "Comparison",

  "settings": [
  
   
      {
      "type": "image_picker",
      "id": "img1",
      "label": "Icon Image"
    },
    
  ],
  "blocks": [
   
    {
      "type": "heading",
      "name": "Main Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "COMPARISON TABLE"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "label": "Header Style",
          "default": "h1",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ]
        }
      ]
    },
   
   
  ],
  "presets": [
    {
      "name": "Comparison",
      "blocks": [
      
        { "type": "heading" },
       
       
      ]
    }
  ]
}
{% endschema %}