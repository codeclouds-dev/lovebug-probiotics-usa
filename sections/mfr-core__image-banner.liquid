{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__image-banner.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign buttons = section.blocks | where: "type", "button" %}
{% assign first_button = buttons | first %}
{% if buttons.size > 1 %}
  {% assign multiple_buttons = 'multiple-buttons' %}
{% else %}
  {% assign multiple_buttons = '' %}
{% endif %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

<section class="mfr-core__banner background {{ custom_class }}" id="{{ section_id }}">
  {%- for block in section.blocks -%}
    {% case block.type %}
      {%- when 'image' -%}
      {%- if block.settings.enable_overlay -%}
        {%- assign has_overlay_class = "has-overlay" -%}
        {%- capture overlay_style -%}
          style="
            --mobile-overlay: {{ block.settings.overlay_mobile }};
            --desktop-overlay: {{ block.settings.overlay_desktop }};
          "
        {%- endcapture -%}
      {%- else -%}
        {%- assign has_overlay_class = "" -%}
        {%- assign overlay_style = "" -%}
      {% endif %}
      <div class="image {{ has_overlay_class }}" {{ overlay_style }}>
        {% unless block.settings.mobile_image != blank and block.settings.desktop_image != blank %}
          {%- capture svg_code -%}{{- 'lifestyle-2' | placeholder_svg_tag -}}{%- endcapture -%}
          {% render 'component__svg-encoder', svg_code: svg_code, alt: "placeholder image" %}
        {% else %}
          {% render 'component__responsive-image',
            mobile_image: block.settings.mobile_image,
            desktop_image: block.settings.desktop_image,
            max_width: 3600,
            loading_lazy: false %}
        {% endunless %}
        </div>
      {%- when 'video' -%}
        <div class="video-player">
          <video playsinline autoplay muted loop preload="auto" poster="{{ block.settings.poster_image | img_url: '1200x' }}">
            <source src="{{ block.settings.slide_video_url | url }}"  type="video/mp4">
          </video>
        </div>
    {%- endcase -%}
  {%- endfor -%}

  <div class="section-spacer {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="banner-wrapper {{ mobile_alignment }} {{ banner_height }}">
        <div class="inner {{ content_alignment }}">
          <div class="section-content {{ color_theme }} {{ text_alignment }}">
            {%- for block in section.blocks -%}
              {% case block.type %}
                
                {%- when 'icon' -%}
                  {% render 'renderer__block-icon', block: block %} 
                
                {%- when 'small_text' -%}
                  {% render "renderer__block-small-text", block: block %}
                
                {%- when 'heading' -%}
                  {% render "renderer__block-title", block: block %}

                {%- when 'text' -%}
                  {% render "renderer__block-text", block: block %}

                {% when "button" %}
                  {% if first_button == block %}
                  <div class="button-set {{ multiple_buttons }} {{ content_alignment }}">
                      {% for block in buttons %}
                        {% render 'renderer__block-button', block: block %}
                      {% endfor %}
                    </div>
                  {% endif %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  {% render "component__gradient-bg-styles" %}
  {%- render "component__accent-graphics" -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
