{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% if section.settings.border_bottom %}
  <style>
    #shopify-section-{{ section.id }} {
      position: relative;
      &:before {
        content: '';
        pointer-events: none;
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1.5px;
        background: linear-gradient(130deg,#795A2E,#4F391F);
        z-index: 2;
      }
    }
  </style>
{% endif %}

{% render 'style-tags__section', asset_file_name: "mfr-core__stacked-cards.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign cards = section.blocks | where: "type", "card" %}
{% assign card_entries = section.blocks | where: "type", "card_entry" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  {% if section.settings.render_as == "stacked_cards" or section.settings.render_as == "stacked_cards_with_animation" %}
    <div class="stacked-cards
      {% if section.settings.render_as == "stacked_cards_with_animation" %}
        with-pinning
      {% endif %}"
      data-stacked-cards-with-animation>
      {% assign index = 0 %}
      {% for card in section.blocks %}
        {% case card.type %}
          {% when "card" or "card_metaobject"%}
            {% assign id = card.settings.card_id | default: card.id %}
            {% assign bg_color = card.settings.header_bg_color %}
            {% assign text_color = card.settings.header_text_color %}
            {% assign title = card.settings.title %}
            {% if title != blank %}
              {% assign entries = card_entries | map: "settings" | where: "card_title", card.settings.title %}
              {% assign metaobject_entries = shop.metaobjects["menu"].values | where: "card_title", card.settings.title %}
            {% else %}
              {% assign entries = blank %}
              {% assign metaobject_entries = blank %}
            {% endif %}

            {% if card.type == "card_metaobject" %}
              {% assign metaobject_entry = shop.metaobjects[card.settings.namespace][card.settings.handle] %}
              {% assign id = card.settings.handle | default: card.id %}
              {% assign bg_color = metaobject_entry.header_background_color %}
              {% assign text_color = metaobject_entry.header_text_color %}
              {% assign title = metaobject_entry.title %}
              {% assign metaobject_menu_groups = metaobject_entry.menu_groups.value %}
              {% assign metaobject_menus = metaobject_entry.menus.value %}
            {% endif %}
            <div class="stacked-cards__card"
              id="{{ id }}"
              data-index="{{ index }}"
              style="
                --card-header-bg-color: {{ bg_color }};
                --card-header-text-color: {{ text_color }};
              ">
              <div class="stacked-cards__card-header">
                {{ title }}
                <span></span>
              </div>
              
              <div class="stacked-cards__card-body">
                <div class="stacked-cards__card-inner">
                  {% for entry in entries %}
                    <div class="stacked-cards__entry">
                      <div class="stacked-cards__entry-title">
                        {{ entry.title }} 
                        {% if entry.sub_title != blank %}
                          <span>- {{ entry.sub_title }}</span>
                        {% endif %}
                      </div>
                      {% if entry.caption != blank %}
                        <div class="stacked-cards__entry-caption">
                            {{ entry.caption }}
                        </div>
                    {% endif %}
                    </div>
                  {% endfor %}

                  {% for entry in metaobject_menus %}
                    <div class="stacked-cards__entry">
                      <div class="stacked-cards__entry-title">
                        {{ entry.title }} 
                        {% if entry.sub_title != blank %}
                          <span>- {{ entry.sub_title }}</span>
                        {% endif %}
                      </div>
                      {% if entry.caption != blank %}
                        <div class="stacked-cards__entry-caption">
                            {{ entry.caption }}
                        </div>
                    {% endif %}
                    </div>
                  {% endfor %}

                  {% for group in metaobject_menu_groups %}
                    <div class="stacked-cards__entry-groups {% if group.show_as_list %}as-list{% endif %}">
                      <div class="stacked-cards__entry-groups-title">
                        {{ group.title }}
                      </div>
                      <div class="stacked-cards__entry-groups-menus">
                        {% for entry in group.menus.value %}
                          <div class="stacked-cards__entry">
                            <div class="stacked-cards__entry-title">
                              {{ entry.title }} 
                              {% if entry.sub_title != blank %}
                                <span>- {{ entry.sub_title }}</span>
                              {% endif %}
                            </div>
                            {% if entry.caption != blank %}
                              <div class="stacked-cards__entry-caption">
                                  {{ entry.caption }}
                              </div>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
            {% assign index = index | plus: 1 %}
        {% endcase %}
      {% endfor %}
    </div>
  {% else %}
    <ul class="stacked-cards as-accordion accordion" 
      data-accordion
      data-multi-expanded="true"
      data-allow-all-closed="true">
      {% assign index = 0 %}
      {% for card in section.blocks %}
        {% case card.type %}
          {% when "card" or "card_metaobject"%}
            {% assign id = card.settings.card_id | default: card.id %}
            {% assign bg_color = card.settings.header_bg_color %}
            {% assign text_color = card.settings.header_text_color %}
            {% assign title = card.settings.title %}
            {% if title != blank %}
              {% assign entries = card_entries | map: "settings" | where: "card_title", card.settings.title %}
            {% else %}
              {% assign entries = blank %}
            {% endif %}

            {% if card.type == "card_metaobject" %}
              {% assign metaobject_entry = shop.metaobjects[card.settings.namespace][card.settings.handle] %}
              {% if metaobject_entry != blank %}
                {% assign id = card.settings.handle | default: card.id %}
                {% assign bg_color = metaobject_entry.header_background_color %}
                {% assign text_color = metaobject_entry.header_text_color %}
                {% assign title = metaobject_entry.title %}
                {% assign metaobject_menu_groups = metaobject_entry.menu_groups.value %}
                {% assign metaobject_menus = metaobject_entry.menus.value %}
              {% else %}
                {% assign id = blank %}
                {% assign bg_color = blank %}
                {% assign text_color = blank %}
                {% assign title = blank %}
                {% assign metaobject_menu_groups = blank %}
                {% assign metaobject_menus = blank %}
              {% endif %}
            {% endif %}
            <li class="stacked-cards__card accordion-item {% if forloop.first %}is-active{% endif %}"
              id="{{ id }}"
              data-index="{{ index }}"
              style="
                --card-header-bg-color: {{ bg_color }};
                --card-header-text-color: {{ text_color }};
              "
              data-accordion-item>
              <!-- Accordion tab title -->
              <a href="#" class="accordion-title stacked-cards__card-header">
                {{ title }}
                <span></span>
              </a>
          
              <!-- Accordion tab content: it would start in the open state due to using the `is-active` state class. -->
              <div class="accordion-content stacked-cards__card-body" data-tab-content>
                <div class="stacked-cards__card-inner">
                  {% for entry in entries %}
                    <div class="stacked-cards__entry">
                      <div class="stacked-cards__entry-title">
                        {{ entry.title }} 
                        {% if entry.sub_title != blank %}
                          <span>- {{ entry.sub_title }}</span>
                        {% endif %}
                      </div>
                      {% if entry.caption != blank %}
                        <div class="stacked-cards__entry-caption">
                          {{ entry.caption }}
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}

                  {% if card.type == "card_metaobject" %}
                    {% for entry in metaobject_menus %}
                      <div class="stacked-cards__entry">
                        <div class="stacked-cards__entry-title">
                          {{ entry.title }} 
                          {% if entry.sub_title != blank %}
                            <span>- {{ entry.sub_title }}</span>
                          {% endif %}
                        </div>
                        {% if entry.caption != blank %}
                          <div class="stacked-cards__entry-caption">
                            {{ entry.caption }}
                          </div>
                        {% endif %}
                      </div>
                    {% endfor %}

                    {% for group in metaobject_menu_groups %}
                      <div class="stacked-cards__entry-groups {% if group.show_as_list %}as-list{% endif %}">
                        <div class="stacked-cards__entry-groups-title">
                          {{ group.title }}
                        </div>
                        <div class="stacked-cards__entry-groups-menus">
                          {% for entry in group.menus.value %}
                            <div class="stacked-cards__entry">
                              <div class="stacked-cards__entry-title">
                                {{ entry.title }} 
                                {% if entry.sub_title != blank %}
                                  <span>- {{ entry.sub_title }}</span>
                                {% endif %}
                              </div>
                              {% if entry.caption != blank %}
                                <div class="stacked-cards__entry-caption">
                                  {{ entry.caption }}
                                </div>
                              {% endif %}
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                  {% endif %}
                </div>
              </div>
            </li>
            {% assign index = index | plus: 1 %}

          {%- when "card_airtable" -%}
            {% assign id = card.settings.card_id | default: card.id %}
            <li class="stacked-cards__card accordion-item airtable-card {% if forloop.first %}is-active{% endif %}"
              data-title="{{- card.settings.entry_title -}}"
              id="{{ id }}"
              data-index="{{ index }}"
              style="
                --card-header-bg-color: {{ bg_color }};
                --card-header-text-color: {{ text_color }};
                display: none;
              "
              data-accordion-item>
              <!-- Accordion tab title -->
              <a href="#" class="accordion-title stacked-cards__card-header">
                {{ card.settings.entry_title }}
                <span></span>
              </a>

              <div class="accordion-content stacked-cards__card-body" data-tab-content>
                <div class="stacked-cards__card-inner">

                </div>
              </div>
            </li>

        {% endcase %}
      {% endfor %}
    </ul>
  {% endif %}
{% endcapture %}

<section class="mfr-core__stacked-cards {{ custom_class }} " id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="cell small-12 large-12 stacked-cards__wrapper"
          {% unless section.settings.render_as == "stacked_cards_with_animation" %}
            data-stacked-cards
          {% endunless %}
          {% if section.settings.public_api_key != blank %}
            data-public-api-key="{{ section.settings.public_api_key }}"
          {% endif %}>
          <div class="loading-wrapper">
            Loading additional data... {% render 'loading-spinner' %}
          </div>
          {{ custom_section_content }}
        </div>
      </div>
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>
{% if section.settings.render_as == "stacked_cards_with_animation" %}
  {% render 'script__section', file: "mfr-stacked-cards.js" %}
{% else %}
  {% render 'script__section', file: "mfr-airtable-stacked-cards.js" %}
{% endif %}

{% schema %}
{
  "name":"Stacked Cards",
  "disabled_on": {
    "groups": [
      "header", "footer", "custom.offcanvas", "custom.modals"
    ]
  },
  "settings":[
    {
      "type": "text",
      "id": "public_api_key",
      "label": "Public Access Token",
      "info": "Insert Airtable api key"
    },
    {
      "type": "select",
      "id": "render_as",
      "label": "Render As:",
      "options": [
        {
          "value": "stacked_cards",
          "label": "Stacked Cards"
        },
        {
          "value": "stacked_cards_with_animation",
          "label": "Stacked Cards - With Animation"
        },
        {
          "value": "accordion",
          "label": "Accordion"
        }
      ],
      "default": "stacked_cards"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },

    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },

    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },


    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "icon", 
      "name": "Icon",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "file_lottie_url",
          "label": "File Lottie URL"
        },
        {
          "type": "number",
          "id": "icon_width",
          "label": "Image width",
          "default": 150,
          "info": "in pixels."
        }
      ]
    },
    {
      "type":"small_text",
      "name":"Accent Text",
      "limit":1,
      "settings":[
        {
          "type":"text",
          "id":"text",
          "default":"Accent Text",
          "label":"Text"
        },
        {
          "type": "color",
          "id": "small_text_color",
          "label": "Color"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading H1",
          "label": "Heading H1"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "options": [
              { "value": "h1", "label": "H1"},
              { "value": "h2", "label": "H2"},
              { "value": "h3", "label": "H3"},
              { "value": "h4", "label": "H4"},
              { "value": "h5", "label": "H5"},
              { "value": "h6", "label": "H6"}
              ],
          "label": "Header Style",
          "default": "h1"
        },

        {
          "type": "header",
          "content": "Accent Settings"
        },
        {
          "type": "select",
          "id": "make_xl",
          "options": [
              { "value": "", "label": "Normal"},
              { "value": "xl-title", "label": "Oversize"}
              ],
          "label": "H1 Size",
          "default": "",
          "info": "H1s can be set to oversize if they need to be extra big"
        },

        {
            "type": "color",
            "id": "highlight_color",
            "label": "Highlight Color",
            "info": "Use [highlight][/highlight] to highlight text"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "info": "Use [underline][/underline] to underline text"
        },

        {
          "type": "header",
          "content": "Width Settings"
        },
        {
            "type": "range",
            "id": "max_width",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "rem",
            "label": "Max Width",
            "default": 0
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 2,
      "settings": [
        
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum vel metus auctor.</p>",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type":"select",
          "id":"text_style",
          "options":[
            { "value":"", "label":"Default" },
            { "value":"xsmall", "label":"xSmall" },
            { "value":"small", "label":"Small" },
            { "value":"regular", "label":"Regular" },
            { "value":"large", "label":"Large" },
            { "value":"xlarge", "label":"xLarge" }
          ],
          "label":"Style",
          "default":"regular"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "info": "Leave it blank to use system settings."
        },
        {
            "type": "range",
            "id": "max_width",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "rem",
            "label": "Width",
            "default": 0
        }
      ]
    },
    {
      "type":"button",
      "name":"Button",
      "limit":2,
      "settings":[
        {
          "type":"text",
          "id":"button_label",
          "default":"Button label",
          "label":"Button",
          "info":"Leave the label blank to hide the button."
        },
        {
          "type":"url",
          "id":"button_link",
          "label":"Button Link"
        },
        {
          "type": "select",
          "id": "color_theme",
          "label": "Color Theme",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ]
        }
      ]
    },
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lorem, ipsum."
        },
        {
          "type": "header",
          "content": "Color Settings"
        },
        {
          "type": "color",
          "id": "header_bg_color",
          "label": "Header Background Color",
          "default": "#333"
        },
        {
          "type": "color",
          "id": "header_text_color",
          "label": "Header Text Color",
          "default": "#fff"
        },
        {
          "type": "text",
          "id": "card_id",
          "label": "Card ID"
        }
      ]
    },
    {
      "type": "card_metaobject",
      "name": "Card (Metaobject)",
      "settings": [
        {
          "type": "text",
          "id": "namespace",
          "label": "Namespace",
          "default": "menu_category"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Handle"
        }
      ]
    },
    {
      "type": "card_entry",
      "name": "Card Entry",
      "settings": [
        {
