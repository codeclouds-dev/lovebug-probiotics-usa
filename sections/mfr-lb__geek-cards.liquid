{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-lb__geek-cards.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign entries = section.blocks | where: "type", "entry" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="geek-cards {% unless section.settings.lottie_file_url != blank %}carousel{% endunless %}"
    data-stagger-inview=".geek-cards__lottie"
    {% unless section.settings.lottie_file_url != blank %}
      data-mfr-carousel="
      {
        prevNextButtons: false,
        contain: true,
        cellAlign: 'center',
        pageDots: true,
        wrapAround: false,
        groupCells: true,
        mobileSettings: {
          cellAlign: 'left',
          contain: true,
          wrapAround: false
        }
      }
    "
    data-mfr-carousel-on-ready='
      const resizeObserver = new ResizeObserver(() => {
        if( !this.$slider.flickity ) return;
        this.$slider.flickity( "resize" );
      });

      this.$items.each((i, cell) => {
        resizeObserver.observe(cell);
      });

      this.$slider.on("destroy.flickity", () => {
        resizeObserver.disconnect();
      });
    '
    {% endunless %}>
    {% if section.settings.lottie_file_url != blank %}
      <div class="geek-cards__lottie"
        data-mfr-sticky-container>
        <div class="geek-cards__lottie-inner"
          data-mfr-sticky>
            <lottie-player src="{{ section.settings.lottie_file_url }}"  
              background="transparent"  
              speed="1"
              loop
              autoplay>
            </lottie-player>
        </div>
      </div>
    {% endif %}

    {% if entries != blank %}
      {%- capture geek_text -%}
        {% assign block_id = block.id | replace: "-", " " | replace: "_", " " | camelcase %}
        <span
          class="geek-text"
          x-show="geekMode" 
          x-collapse
          :aria-hidden="!geekMode"
          x-cloak>
      {%- endcapture -%}
      <div class="geek-cards__grid {% unless section.settings.lottie_file_url != blank %}carousel__slides{% endunless %}"
        data-stagger-inview=".geek-cards__entry">
        {%- for entry in entries -%}
          <div class="geek-cards__entry {% unless section.settings.lottie_file_url != blank %}carousel__item{% endunless %}"
            x-data="{
              geekMode: false
            }"
            style="
              --bg-color: {{ entry.settings.bg_color }};
              --text-color: {{ entry.settings.text_color }};
            ">
            <div class="geek-cards__card">
              {% if entry.settings.title != blank %}
                <h5 class="h5 geek-cards__card-title">
                  {{ entry.settings.title }}
                </h5>
              {% endif %}
              {% if entry.settings.caption != blank %}
                
                <p class="regular geek-cards__card-caption">
                  {{ entry.settings.caption
                    | replace: "[geek-text]", geek_text
                    | replace: "[/geek-text]", "</span>" }}
                </p>
  
                {% render 'component__geek-switch',
                  mode: "dark-mode" %}
              {% endif %}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
{% endcapture %}

<section class="mfr-lb__geek-cards {{ custom_class }} " id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}

              {% if section.settings.lottie_file_url != blank %}
                {% if buttons != blank %}
                  <div class="button-set {{ content_alignment }}">
                    {%- for block in section.blocks -%}
                      {% case block.type %}
                        {%- when 'button' -%}
                          {% render 'renderer__block-button', block: block %}
                      {%- endcase -%}
                    {%- endfor -%}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="cell small-12 large-12">
          {{ custom_section_content }}
        </div>

        {% unless section.settings.lottie_file_url != blank %}
          {% if buttons != blank %}
            <div class="cell small-12 button-set {{ content_alignment }}">
              {%- for block in section.blocks -%}
                {% case block.type %}
                  {%- when 'button' -%}
                    {% render 'renderer__block-button', block: block %}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          {% endif %}
        {% endunless %}
      </div>
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>
{% unless section.settings.lottie_file_url != blank %}
  {% render 'script__section', file: "mfr-carousel.js" %}
{% endunless %}


