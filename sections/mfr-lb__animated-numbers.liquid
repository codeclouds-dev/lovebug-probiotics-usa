{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-lb__animated-numbers.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;"
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{%- assign entries = section.blocks | where: "type", "entry" -%}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here
{% endcomment %}
{% capture custom_section_content %}
  <div class="animated-numbers">
    {% for entry in entries %}
      <div class="animated-numbers__entry" data-inview>
        <div class="animated-numbers__entry-head">
          <div class="animated-numbers__entry-head-inner">
            {% for i in (1..11) %}
              <span></span>
            {% endfor %}
          </div>
        </div>
        <div class="animated-numbers__entry-body">
          <div class="progress-bar html"
            data-animated-progress="{{ entry.settings.percentage }}"
            style='
              --progress-value: {{ entry.settings.percentage }};
              --main-color-alpha: {{ entry.settings.progress_bar_color | color_modify: "alpha", 0.2 }};
              --main-color: {{ entry.settings.progress_bar_color }};
            '>

            <span class="progress-bar__counter"
              data-animated-number="{{ entry.settings.percentage }}">
                {{ entry.settings.percentage }}
              </span>
          </div>

          {% if entry.settings.caption != blank %}
            {%- capture svg_code -%}
              url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' width='152' height='29' preserveAspectRatio='none'%3E%3Cpath fill='{{- entry.settings.mark_color | color_modify: "alpha", 0.57 | replace: "#", "%23" -}}' transform='translate(0.505371 2.23291)' d='M1.7397418 16.569C0.95674175 16.542999 1.2397418 14.435 1.7397418 14.075C1.6907418 13.708 0.95074177 14.033 1.0277418 13.541C0.90274173 12.845 1.6517417 13.532 1.9177418 13.541C1.9717418 13.071 1.6707418 12.956 1.2057418 13.006C2.1837418 10.238 1.0437417 4.8169999 5.3027415 4.098C42.79874 -2.233 104.21914 0.986 149.75314 0C149.75214 0.90100002 149.73714 1.748 150.28815 2.4949999C150.13214 2.7550001 150.14613 3.1849999 149.57513 3.029C149.71614 3.4230001 150.19814 3.4749999 150.46614 3.7420001C149.90514 4.3429999 149.37415 5.1919999 148.50613 4.9889998C148.16614 5.0599999 148.90414 5.52 149.21915 5.5229998C148.90215 6.0939999 148.42413 5.973 147.79314 5.8800001C148.07713 6.6999998 148.73114 6.0409999 149.21915 6.592C148.69414 6.8870001 148.29514 6.4959998 147.25914 6.592C147.64514 7.513 148.85214 7.6129999 149.39714 8.3739996C148.51514 8.4329996 148.36115 8.9449997 147.43713 8.552C147.59914 9.1619997 148.55515 8.9790001 149.21915 9.0869999C148.86613 9.625 148.29214 9.941 147.25914 9.7989998C147.32014 10.326 147.76215 10.745 149.04114 10.868C148.17314 11.294 147.76414 10.874 146.90314 11.046C147.07513 11.409 147.58714 11.431 148.15015 11.403C147.45415 11.657 147.08714 12.24 146.01215 12.115C146.72115 12.416 147.45714 12.689 148.32814 12.828C148.02814 13.631 147.11714 12.84 146.36914 13.006C146.65015 13.674 147.98714 13.288 148.50613 13.719C148.17714 13.984 147.66014 14.06 147.08115 14.075C147.33414 14.594 148.13614 14.564 148.68414 14.788C148.55814 15.433 147.38614 15.034 146.72414 15.144C146.90215 15.621 147.81013 15.365 147.79314 16.035C147.49715 16.035 147.20013 16.035 146.90314 16.035C147.80714 16.382999 147.22514 16.483999 148.15015 16.569C148.12814 16.962999 147.39413 16.645 147.08115 16.747999C147.32614 17.097 148.17213 16.844 148.50613 17.104C148.48415 17.497 147.75114 17.18 147.43713 17.282C148.06615 17.926001 147.61314 18.139999 148.68414 18.707001C148.65913 19.299999 147.49715 18.66 148.32814 19.242001C113.05614 19.598 69.825745 19.41 31.314741 21.202C21.601742 21.653 9.9817419 25 2.4527419 23.160999C1.8027418 23.216 1.2927418 23.132999 0.84874177 22.983C0.62674177 22.226 1.4417417 22.506001 1.5617417 22.091999C0.093741752 21.766001 -0.50525826 20.502001 0.49274176 18.707001C1.1777418 19.204 1.1837418 18.242001 1.7397418 18.707001C1.2047417 17.527 1.1727418 17.066999 0.49274176 16.391001C0.65474176 16.014 1.2087418 16.728001 1.7397418 16.569Z' fill-rule='evenodd'/%3E%3C/svg%3E&quot;);
            {%- endcapture -%}
            <p class="animated-numbers__entry-caption"
              style="
                --main-color: {{ entry.settings.progress_bar_color }};
                --marker-bg: {{ svg_code }};
              ">
              {{ entry.settings.caption }}
            </p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endcapture %}

<section class="mfr-lb__animated-numbers {{ custom_class }} " id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}

                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %}

                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}

                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}

                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="cell small-12 large-12">
          {{ custom_section_content }}
        </div>
      </div>
    </div>
  </div>

  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
{
  "name":"LB: Animated Numbers",
  "disabled_on": {
