{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% comment %} wrap everything in unless statement so section only shows if content is added to the metafields {% endcomment %}
{% unless template == "product" and product.metafields.mfr_fields.product_ugc_reviews == blank %}

{% render 'style-tags__section', asset_file_name: "mfr-core__UGC-reviews-carousel.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_text = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign text = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign reviews = shop.metaobjects[section.settings.reviews_metaobject_handle] %}
{% assign sort_reference = shop.metaobjects[section.settings.reviews_metaobject_handle].values | map: "system" | sort: "id" %}
{%  assign reviews_blocks = section.blocks | where: "type", "review" %}
{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="ugc-carousel carousel__slides" data-stagger-inview=".ugc-carousel__item">
    {% if sort_reference != blank %}
      {% for ref in sort_reference %}
        {% assign entry = reviews[ref.handle] %}
        <div class="ugc-carousel__item carousel__item">
          <div class="ugc-carousel__card"
            style="
              --card-bg-color: {{ entry.card_background_color | default: '#fff' }};
            ">
  
            {%- liquid
              if entry.media == blank
                assign review_type = "text-only-review"
              else
                assign review_type = "media-review"
              endif
  
              if entry.review != blank
                assign text = entry.review
                assign words = text | split: ' '
                assign word_count = words | size 
               if word_count < 50
                assign font_size = "large-size"
               else
                assign font_size = "regular-size"
               endif
              else
                assign font_size = "regular-size"
              endif
  
              assign rating = entry.rating.value | split: "." | first | plus: 0
            -%}
  
            <div class="ugc-carousel__card-body {{ font_size }} {{ review_type }}">
  
              {% if entry.media != blank %}
                {% assign media = entry.media.value %}
                {% if media.media_type == "video" %}
                  {% render "component__hosted-video", 
                    media: media,
                    autoplay: false,
                    muted: true,
                    controls: false,
                    play_on_view: false,
                    width: 420,
                    class: ".ugc-carousel__card-video",
                    playButton: true,
                    speakerButton: true %}
                {% else %}
                  {% render 'component__lazyload-image',
                    image: media,
                    width: 420 %}
                {% endif %}
  
  
                {% if rating >= 4 %}
                  <div class="ugc-carousel__card-stars">
                    {%- render 'icon__5-stars', count: count -%}
                  </div>
                {% endif %}
                {% if entry.review != blank %}
                  <div class="ugc-carousel__card-review">{{ entry.review }}</div>
                {% endif %}
                {% if entry.name %}
                  <p class="ugc-carousel__card-reviewer-name">{{ entry.name }}</p>
                {% endif %}

  
              {% else %}

                {% if rating >= 4 %}
                  <div class="ugc-carousel__card-stars">
                    {%- render 'icon__5-stars', count: count -%}
                  </div>
                {% endif %}
                {% if entry.review != blank %}
                  <div class="ugc-carousel__card-review">{{ entry.review }}</div>
                {% endif %}
                {% if entry.name != blank %}
                  <div class="ugc-carousel__card-footer">
                    <p class="ugc-carousel__card-reviewer-name">{{ entry.name }}</p> 
                  </div>
                {% endif %}
              
              {% endif %}
            </div>

            
  
          </div>
          
          {% render 'schema__review',
            rating: entry.rating.value,
            max_rating: entry.rating.scale_max,
            min_rating: entry.rating.scale_min,
            review: entry.review,
            name: entry.name %}
        </div>
      {% endfor %}
    {% elsif reviews_blocks != blank %}
      {% for block in reviews_blocks %}
        <div class="ugc-carousel__item carousel__item">
          <div class="ugc-carousel__card"
            style="--card-bg-color: {{ block.settings.card_background_color | default: '#fff' }};">
  
            {%- liquid
              if block.settings.background_image == blank and block.settings.background_video == blank
                assign review_type = "text-only-review"
              else
                assign review_type = "media-review"
              endif
  
              if block.settings.description != blank
                assign text = block.settings.description
                assign words = text | split: ' '
                assign word_count = words | size 
                
               if word_count < 24
                assign font_size = "large-size"
               else
                assign font_size = "regular-size"
               endif
              else
                assign font_size = "regular-size"
              endif
  
              assign rating = block.settings.rating | split: "." | first | plus: 0
            -%}
  
            <div class="ugc-carousel__card-body {{ font_size }} {{ review_type }}">
  
              {% if block.settings.background_video != blank or block.settings.background_image != blank %}
                {% if block.settings.background_video != blank %}
                  {% render "component__hosted-video", 
                    media: block.settings.background_video,
                    autoplay: false,
                    muted: true,
                    controls: false,
                    play_on_view: false,
                    width: 420,
                    class: ".ugc-carousel__card-video",
                    playButton: true,
                    speakerButton: true %}
                {% else %}
                  {% render 'component__lazyload-image',
                    image: block.settings.background_image,
                    width: 420 %}
                {% endif %}
  

                {% if rating >= 4 %}
                  <div class="ugc-carousel__card-stars">
                    {%- render 'icon__5-stars', count: count -%}
                  </div>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="ugc-carousel__card-review">{{ block.settings.description }}</div>
                {% endif %}
                {% if block.settings.name != blank %}
                  <p class="ugc-carousel__card-reviewer-name">{{ block.settings.name }}</p>
                {% endif %}

                
              {% else %}

                {% if rating >= 4 %}
                  <div class="ugc-carousel__card-stars">
                    {%- render 'icon__5-stars', count: count -%}
                  </div>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="ugc-carousel__card-review">{{ block.settings.description }}</div>
                {% endif %}
                {% if block.settings.name != blank %}
                  <div class="ugc-carousel__card-footer">
                    <p class="ugc-carousel__card-reviewer-name">{{ block.settings.name }}</p>
                  </div>
                {% endif %}
                
              {% endif %}
              
            </div>
            
          </div>
          
          {% render 'schema__review',
            rating: rating,
            max_rating: 5,
            min_rating: 1,
            review: block.settings.description,
            name: block.settings.name %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
{% endcapture %}

<section class="mfr-core__UGC-reviews-carousel" id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      {% if icons != blank or small_text != blank or headings != blank or text != blank or buttons != blank %}
        <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
          <div class="inner">
            {%- for block in section.blocks -%}
              {% case block.type %}
              
                {%- when 'icon' -%}
                  {% render 'renderer__block-icon', block: block %} 
              
                {%- when 'small_text' -%}
                  {% render "renderer__block-small-text", block: block %}
                  
                {%- when 'heading' -%}
                  {% render "renderer__block-title", block: block %}
                  
                {%- when 'text' -%}
                  {% render "renderer__block-text", block: block %}

              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {% endif %}

      {% if reviews != blank or reviews_blocks != blank %}
        <div class="cell small-12 carousel">
          {{ custom_section_content }}
        </div>
      {% endif %}

      {% if buttons != blank %}
        <div class="cell small-12 large-12 section-content {{ text_alignment }}">
          <div class="button-set">
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'button' -%}
                  {% render 'renderer__block-button', block: block %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}

  {% render 'script__section', file: "mfr-carousel.js" %}
  <script>
    initializeComponent( "#{{ section_id }} .carousel", "Carousel", {
      wrapAround: false,
      prevNextButtons: true,
      adaptiveHeight: false,
      pageDots: true,
      selectedAttraction: 0.1,
      friction: 0.55,
      cellAlign: "left",
      groupCells: true,
      contain: true
    } );
  </script>
</section>

{% endunless %}

{% schema %}
{
  "name":"UGC Reviews Carousel",
  "disabled_on": {
    "groups": ["header","footer","custom.offcanvas","custom.modals"]
  },
  "settings":[
  {
    "type": "text",
    "id": "reviews_metaobject_handle",
    "label": "Reviews Metaobject Handle",
    "default": "ugc_review"
  },
  {
    "type": "header",
    "content": "Section Settings"
  },
  {
    "type": "checkbox",
    "id": "border_bottom",
    "label": "Border Bottom",
    "default": false
  },
  {
    "type": "select",
    "id": "text_alignment",
    "options": [
       { "value": "left-align-text", "label": "Left" }, 
       { "value": "center-align-text", "label": "Center" }
    ],
    "label": "Text Alignment",
    "default": "center-align-text"
  },
  {
    "type": "select",
    "id": "container_width",
    "options": [
      {
        "value": "full",
        "label": "Full"
      },
      {
        "value": "",
        "label": "Contain"
      }
    ],
    "label": "Width",
    "default": "full"
  },
  {
    "type": "range",
    "id": "max_width",
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "rem",
    "label": "Max Content Width",
    "default": 0
  },
  {
    "type": "select",
    "id": "grid_gutter",
    "options": [
      {
        "value": "grid-gutter",
        "label": "Padding"
      },
      {
        "value": "",
        "label": "No Padding"
      }
    ],
    "label": "Section Padding",
    "default": ""
  },
  {
    "type": "header",
    "content": "Color Schemes Settings"
  },
  {
    "type": "color_scheme",
    "id": "color_scheme",
    "default": "scheme_1",
    "label": "Color Scheme",
    "info": "This will be the color scheme of the header initially."
  },
    
    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },

    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },
    {
      "type": "video",
      "id": "video",
      "label": "A Shopify-hosted video",
      "info": "will show instead of image"
    },
    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "review",
      "name": "Review",
      "limit": 15,
      "settings": [
        {
          "type": "header",
          "content": "Metaobject Reference",
          "info": "ex. test-name"
        },
        {
          "type": "text",
          "id": "metaobject_reference",
          "label": "Reference ID",
          "info": "Enter the identifier of the metaobject."
        },

        {
          "type": "header",
          "content": "Custom Content"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "video",
          "id": "background_video",
          "label": "Background Video"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "info": "number 1-5"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail"
        }

      ]
    },
    {
      "type": "icon", 
      "name": "Icon",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "file_lottie_url",
          "label": "File Lottie URL"
        },
        {
          "type": "number",
          "id": "icon_width",
          "label": "Image width",
          "default": 150,
          "info": "in pixels."
        }
      ]
    },
    {
      "type":"small_text",
      "name":"Accent Text",
      "limit":1,
      "settings":[
        {
          "type":"text",
          "id":"text",
          "default":"Accent Text",
          "label":"Text"
        },
        {
          "type": "color",
          "id": "small_text_color",
          "label": "Color"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading H1",
          "label": "Heading H1"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "options": [
              { "value": "h1", "label": "H1"},
              { "value": "h2", "label": "H2"},
              { "value": "h3", "label": "H3"},
              { "value": "h4", "label": "H4"},
              { "value": "h5", "label": "H5"},
              { "value": "h6", "label": "H6"}
              ],
          "label": "Header Style",
          "default": "h1"
        },

        {
          "type": "header",
          "content": "Accent Settings"
        },
        {
          "type": "select",
          "id": "make_xl",
