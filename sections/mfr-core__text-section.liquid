{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__text-section.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign icon_text_block_layout = section.settings.icon_text_block_layout -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;"
  {%- endcapture -%}
{%- endif -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "center-align-text" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% if icon_text_block_layout == "" %}
  {% assign icon_text_blocks_class = "" %}
{% else %}
  {% assign icon_text_blocks_class = "icon-texts-scroll-mobile" %}
{% endif %}

{% assign buttons = section.blocks | where: "type", "button" %}
{% assign icon_texts = section.blocks | where: "type", "icon_text" %}
{% assign first_icon_text = icon_texts | first %}
{% assign text_blocks = section.blocks | where: "type", "text_block" %}
{% assign first_text_block = text_blocks | first %}
{% assign hide_text_buttons_blocks = section.settings.hide_text_buttons_blocks %}
{% assign first_button = buttons | first %}
{% assign geek_switches = section.blocks | where: "type", "geek_switch" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

<section id="{{ section_id }}" class="mfr-core__text-section background {{ icon_text_blocks_class }} text-block--{{ section.settings.text_block_size | default: 'default' }} {{ custom_class }}"
  {% if geek_switches != blank %}
    x-data="{
      geekMode: false
    }"
  {% endif %}>
  <div class="section-spacer {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="inner">
        <div class="grid-x align-center">
          <div class="cell small-12 medium-12 section-content {{ color_theme }} {{ text_alignment }} {% if hide_text_buttons_blocks %}title-margin-0{% endif %}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %}

                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}

                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}

                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block, replace_src: "[content]", replace_value: page.content %}

                  {%- when 'video' -%}
                    {% render 'media__responsive-video',
                      mobile_video: block.settings.video_mobile,
                      desktop_video: block.settings.video_desktop,
                      muted: block.settings.muted,
                      autoplay: block.settings.autoplay,
                      controls: block.settings.controls,
                      loop: block.settings.loop,
                      block: block,
                      mobile_poster: block.settings.video_mobile_poster,
                      desktop_poster: block.settings.video_desktop_poster %}


                  {%- when 'image' -%}
                    <div class="image {{ section_layout }}" style="max-width: {{ block.settings.image_width }}px;"
                      data-inview>
                      {%- capture sizes -%}
                        (max-width: 1023px) min( {{ block.settings.image_width }}px, calc( 100vw - 86px ) ),
                        {{ block.settings.image_width }}px
                      {%- endcapture -%}
                      {% assign render_size = block.settings.image_width | times: 1.5 %}
                      {% assign image_mobile = block.settings.image %}

                      {% if block.settings.image_mobile != blank %}
                        {% assign image_mobile = block.settings.image_mobile %}
                      {% endif %}

                      <div class="desktop">
                        {% render 'component__lazyload-image',
                        image: block.settings.image,
                        width: render_size,
                        alt: block.settings.image.alt,
                        sizes: sizes %}
                      </div>

                      <div class="mobile">
                        {% render 'component__lazyload-image',
                        image: image_mobile,
                        width: render_size,
                        alt: block.settings.image.alt,
                        sizes: sizes %}
                      </div>
                    </div>

                  {%- when 'icon_text' -%}
                    {% if block == first_icon_text %}
                      {% render 'component__icon-text', icon_texts: icon_texts, columns: 4 %}
                    {% endif %}

                  {%- when 'text_block' -%}
                    {% if block == first_text_block %}
                      {% render 'component__text-block', text_blocks: text_blocks, columns: 4 %}
                    {% endif %}

                  {%- when 'text_buttons' -%}
                    {%- liquid
                      assign richtext = block.settings.richtext
                      assign cta_1_text = block.settings.cta_1_text
                      assign cta_1_url = block.settings.cta_1_url
                      assign cta_2_text = block.settings.cta_2_text
                      assign cta_2_url = block.settings.cta_2_url
                    -%}

                    <div class="section-text-buttons {% if hide_text_buttons_blocks %}hide{% endif %}">
                      {% if richtext %}
                        <div class="richtext">
                          {{ richtext }}
                        </div>
                      {% endif %}

                      {% if cta_1_text != blank or cta_1_url != blank or cta_2_text != blank or cta_2_url != blank %}
                        <div class="button-group">
                          {% if cta_1_text != blank and cta_1_url != blank %}
                            <a href="{{ cta_1_url }}" title="{{ cta_1_text }}" class="button primary" target="_blank">{{ cta_1_text }}</a>
                          {% endif %}

                          {% if cta_2_text != blank and cta_2_url != blank %}
                            <a href="{{ cta_2_url }}" title="{{ cta_2_text }}" class="button primary" target="_blank">{{ cta_2_text }}</a>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>

                  {%- when 'anchors' -%}
                    <a href="{{ block.settings.anchor }}" class="anchor" title="Go to {{ block.settings.title }}">{{ block.settings.title }}</a>

                  {%- when "button" -%}
                    {% if first_button.id == block.id %}
                      <div class="button-set {{ content_alignment }}">
                        {%- for block in section.blocks -%}
                          {% case block.type %}
                            {%- when 'button' -%}
                              {% render 'renderer__block-button', block: block %}
                          {%- endcase -%}
                        {%- endfor -%}
                      </div>
                    {% endif %}

                  {%- when "spacer" -%}
                    <div class="text-section__spacer"
                      style="
                        --height-mobile: {{ block.settings.height_mobile }}px;
                        --height-desktop: {{ block.settings.height_desktop }}px;
                      "></div>

                  {%- when 'geek_switch' %}
                    {% render 'component__geek-switch' %}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}

  {% render 'script__section', file: "mfr-carousel.js" %}
  <script>
    initializeComponent( "#{{ section_id }}", "Carousel", {
      contain: true,
      wrapAround: false,
      autoPlay: false,
      prevNextButtons: true,
      pageDots: true,
      groupCells: true,
      cellAlign: 'center'
    })

    onReady(function() {
      const $buttons = $('#{{ section_id }} .button[href="#show-section-blocks"]')

      $buttons.on('click', function(e) {
        $(this).parent().siblings('.section-text-buttons').removeClass('hide')
        $(this).parent().siblings('.section-title').show()
        $(this).parents('.section-content').removeClass('title-margin-0')
        $(this).hide()
      })

      $('#{{ section_id }} .anchor').wrapAll('<div class="section-anchors" />')
    })
  </script>

  {%- render 'component__section-dividers', is_video_background: true -%}
</section>

