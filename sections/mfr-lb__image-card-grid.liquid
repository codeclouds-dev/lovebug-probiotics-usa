          "label": "Rotate",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "flip",
          "label": "Flip Graphics?",
          "default": false
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"LB: Image Card Grid",
      "blocks":[
        {
          "type":"heading"
        },
        {
          "type":"text"
        },
        {
          "type":"image_card"
        },
        {
          "type":"image_card"
        },
        {
          "type":"image_card"
        }
      ]
    }
  ]
}
{% endschema %}