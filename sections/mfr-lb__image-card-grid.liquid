{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-lb__image-card-grid.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign image_cards = section.blocks | where: "type", "image_card" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="image-card-grid"
    data-stagger-inview=".image-card-grid__item">
    {%- for image_card in image_cards -%}
      <div class="image-card-grid__item">
        <a href="{{ image_card.settings.url }}" 
          aria-label="{{ image_card.settings.sub_title }} {{ image_card.settings.title }}"
          title="{{ image_card.settings.sub_title }} {{ image_card.settings.title }}" 
          class="image-card-grid__card">
          <div class="image-card-grid__card-image">
            {% assign default_alt = "maybe an image about " | append: image_card.settings.title %}
            {% assign alt = image_card.settings.image | default: default_alt %}
            {%- capture sizes -%}
              100vw,
              (min-width: 1024px) max(33vw,426px)
            {%- endcapture -%}
            {% render 'component__lazyload-image',
              image: image_card.settings.image,
              width: 720,
              widths: "420,480,600,720",
              alt: alt,
              sizes: sizes %}
          </div>
          <div class="image-card-grid__card-info">
            <div class="image-card-grid__card-info-inner">
              {% if image_card.settings.sub_title != blank %}
                <span class="image-card-grid__card-info-sub-title">
                  {{ image_card.settings.sub_title }}
                </span>
              {% endif %}
              {% if image_card.settings.title != blank %}
                <span class="image-card-grid__card-info-title">
                  {{ image_card.settings.title }}
                </span>
              {% endif %}
            </div>

            <div class="image-card-grid__card-info-arrow">
              {%- capture arrow_svg -%}
                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="53" height="48">
                  <path fill="white" transform="translate(1.07812 0.327148)" d="M18.606169 0.1477911C12.285255 0.82274979 6.0098438 5.2845297 2.7225451 10.765244C-1.0777316 17.112701 -0.68193436 27.666431 2.5623562 34.016983C6.2890835 41.312229 13.826683 46.290588 22.165226 45.986828C28.313484 45.762871 34.43681 43.926067 39.13028 39.891163C42.061672 37.370743 44.35231 33.900673 45.69989 30.306257C50.516773 17.475855 41.286907 2.5574739 28.905622 0.55796307C27.447094 -0.32734022 19.169634 0.092111647 18.606169 0.1477911Z" fill-rule="evenodd"/>
                  <path fill="none" stroke="#2B3990" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(21.2448 13.7438)" d="M0 0L9.583333 9.583333L0 19.166666" fill-rule="evenodd"/>
                </svg>
                
              {%- endcapture -%}
              {% render 'component__svg-encoder',
                svg_code: arrow_svg,
                width: 47,
                alt: "arrow icon" %}
            </div>
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>
{% endcapture %}

<section class="mfr-lb__image-card-grid {{ custom_class }} " id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="cell small-12 large-12">
          {{ custom_section_content }}
        </div>
      </div>
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
{
  "name":"LB: Image Card Grid",
  "disabled_on": {
    "groups": [
      "header", "footer", "custom.offcanvas","custom.modals"
    ]
  },
  "settings":[
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },

    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },

    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },


    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "icon", 
      "name": "Icon",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "file_lottie_url",
          "label": "File Lottie URL"
        },
        {
          "type": "number",
          "id": "icon_width",
          "label": "Image width",
          "default": 150,
          "info": "in pixels."
        }
      ]
    },
    {
      "type":"small_text",
      "name":"Accent Text",
      "limit":1,
      "settings":[
        {
          "type":"text",
          "id":"text",
          "default":"Accent Text",
          "label":"Text"
        },
        {
          "type": "color",
          "id": "small_text_color",
          "label": "Color"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading H1",
          "label": "Heading H1"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "options": [
              { "value": "h1", "label": "H1"},
              { "value": "h2", "label": "H2"},
              { "value": "h3", "label": "H3"},
              { "value": "h4", "label": "H4"},
              { "value": "h5", "label": "H5"},
              { "value": "h6", "label": "H6"}
              ],
          "label": "Header Style",
          "default": "h1"
        },

        {
          "type": "header",
          "content": "Accent Settings"
        },
        {
          "type": "select",
          "id": "make_xl",
          "options": [
              { "value": "", "label": "Normal"},
              { "value": "xl-title", "label": "Oversize"}
              ],
          "label": "H1 Size",
          "default": "",
          "info": "H1s can be set to oversize if they need to be extra big"
        },

        {
            "type": "color",
            "id": "highlight_color",
            "label": "Highlight Color",
            "info": "Use [highlight][/highlight] to highlight text"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "info": "Use [underline][/underline] to underline text"
        },

        {
          "type": "header",
          "content": "Width Settings"
        },
        {
            "type": "range",
            "id": "max_width",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "rem",
            "label": "Max Width",
            "default": 0
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 2,
      "settings": [
        
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum vel metus auctor.</p>",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type":"select",
          "id":"text_style",
          "options":[
            { "value":"", "label":"Default" },
            { "value":"xsmall", "label":"xSmall" },
            { "value":"small", "label":"Small" },
            { "value":"regular", "label":"Regular" },
            { "value":"large", "label":"Large" },
            { "value":"xlarge", "label":"xLarge" }
          ],
          "label":"Style",
          "default":"regular"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "info": "Leave it blank to use system settings."
        },
        {
            "type": "range",
            "id": "max_width",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "rem",
            "label": "Width",
            "default": 0
        }
      ]
    },
    {
      "type":"button",
      "name":"Button",
      "limit":2,
      "settings":[
        {
          "type":"text",
          "id":"button_label",
          "default":"Button label",
          "label":"Button",
          "info":"Leave the label blank to hide the button."
        },
        {
          "type":"url",
          "id":"button_link",
          "label":"Button Link"
        },
        {
          "type": "select",
          "id": "color_theme",
          "label": "Color Theme",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ]
        }
      ]
    },
    {
      "type": "image_card",
      "name": "Image Card",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lorem ipsum"
        },
        {
          "type": "text",
          "id": "sub_title",
          "label": "Sub Title",
          "default": "Lorem ipsum"
        },
      ]
    },
    {
      "type": "accent_graphic", 
      "name": "Accent Graphic",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type":"html",
          "id":"svg_code",
          "label":"Graphic SVG Code",
          "info":"Paste SVG code for vector graphic"
        },
        {
          "type":"header",
          "content":"Visibility"
        },
        {
          "type": "select",
          "id": "visibility",
          "options": [
              { "value": "always", "label": "Always" },
              { "value": "desktop_only", "label": "Desktop Only" },
              { "value": "mobile_only", "label": "Mobile Only" }
              ],
          "label": "Show on..",
          "default": "always"
        },
        {
          "type":"header",
          "content":"Value Type"
        },
        {
          "type": "select",
          "id": "value_type",
          "options": [
              { "value": "px", "label": "Pixels" },
              { "value": "%", "label": "Percentage" }
              ],
          "label": "Position Value Type",
          "default": "%",
          "info": "Pixel values are multiplied by 5"
        },
        {
          "type":"header",
          "content":"Position"
        },
        {
          "type": "select",
          "id": "x_setting",
          "options": [
              { "value": "left", "label": "Left" },
              { "value": "center", "label": "Center" },
              { "value": "right", "label": "Right" }
              ],
          "label": "X Position",
          "default": "left"
        },
        {
          "type": "select",
          "id": "y_setting",
          "options": [
              { "value": "top", "label": "Top" },
              { "value": "bottom", "label": "Bottom" }
              ],
          "label": "Y Position",
          "default": "top"
        },
        { 
          "type":"header",
          "content":"Large Screen Settings"
        },
        {
          "type": "range",
          "id": "width_large",
          "min": 10,
          "max": 400,
