{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__card-carousel.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{% if section.settings.is_centered %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign icon_texts = section.blocks | where: "type", "icon_text" %}
{% assign first_icon_text = icon_texts | first %}
{% assign icon_texts = section.blocks | where: "type", "icon_text" %}
{% assign cards = section.blocks | where: "type", "card" %}

{% assign is_wrap_around = section.settings.carousel_wrap_around %}
{% assign is_pagination = section.settings.carousel_page_dots %}
{% assign is_prev_next = section.settings.carousel_page_buttons %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="card-carousel carousel {% if is_wrap_around %}wrap-around{% endif %}">
    <div class="card-carousel__carousel carousel__slides" data-stagger-inview=".card-carousel__card-inner">
      {% for card in cards %}
        <div class="card-carousel__card carousel__item" data-inview>
          {% capture card_html %}
            <div class="card-carousel__card-inner">
              <div class="card-carousel__card-image">
                {% render 'component__lazyload-image',
                  image: card.settings.image,
                  width: 420,
                  alt: card.settings.image.alt %}
              </div>
              <div class="card-carousel__card-texts">
                {% if card.settings.title != blank %}
                  <h6 class="card-carousel__card-sub-title">
                    {{ card.settings.sub_title }}
                  </h6>
                {% endif %}
                {% if card.settings.title != blank %}
                  <h3 class="card-carousel__card-title">
                    {{ card.settings.title }}
                  </h3>
                {% endif %}
                {% if card.settings.caption != blank %}
                  <p class="card-carousel__card-caption">
                    {{ card.settings.caption }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endcapture %}

          {% if card.settings.url != blank %}
            <a href="{{ card.settings.url }}" title="Visit to {{ card.settings.title }}" {% if card.settings.new_tab %}target="_blank"{% endif %}>
              {{ card_html }}
            </a>
          {% else %}
            {{ card_html }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endcapture %}

<section class="mfr-core__card-carousel carousel {{ custom_class }}" id="{{ section_id }}">
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}

  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ full_mobile }} {{ container_width }}">
      <div class="inner">
        <div class="grid-x {{ content_alignment }} align-center">
          {% if icons != blank or small_texts != blank or headings != blank or texts != blank or icon_texts != blank %}
            <div class="cell small-12 section-content {{ color_theme }} {{ text_alignment }}">
              <div class="inner">
    
                {%- for block in section.blocks -%}
                  {% case block.type %}

                    {%- when 'icon' -%}
                      {% render 'renderer__block-icon', block: block %} 

                    {%- when 'small_text' -%}
                      {% render "renderer__block-small-text", block: block %}

                    {%- when 'heading' -%}
                      {% render "renderer__block-title", block: block %}

                    {%- when 'text' -%}
                      {% render "renderer__block-text", block: block %}

                    {%- when "icon_text" -%}
                      {% if block.id == first_icon_text.id %}
                        <ul class="icon-text" data-stagger-inview="li">
                          {% for item in icon_texts %}
                            <li>
                              {% if item.settings.icon %}
                                {{ item.settings.icon
                                  | image_url: width: 144
                                  | image_tag: width: 144,
                                    widths: "144",
                                    alt: item.settings.icon.alt }}
                              {% endif %}
                              {% if item.settings.text != blank %}
                                <span>
                                  {{ item.settings.text }}
                                </span>
                              {% endif %}
                            </li>
                          {% endfor %}
                        </ul>
                      {% endif %}

                  {%- endcase -%}
                {%- endfor -%}

                {% if buttons != blank %}
                  <div class="button-set {{ content_alignment }}">
                    {%- for block in section.blocks -%}
                      {% case block.type %}
                        {%- when 'button' -%}
                          {% render 'renderer__block-button', block: block %}
                      {%- endcase -%}
                    {%- endfor -%}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if cards != blank %}
            <div class="cell small-12 card-carousel__wrapper">
              {{ custom_section_content }}
            </div>
          {% endif %}

        </div>
      </div>
    </div>
  </div>

  {% render 'script__section', file: "mfr-carousel.js" %}
  <script>
    initializeComponent( "#{{ section_id }} .card-carousel", "Carousel", {
      wrapAround: {{ is_wrap_around }},
      prevNextButtons: {{ is_prev_next }},
      adaptiveHeight: false,
      pageDots: {{ is_pagination }},
      selectedAttraction: 0.1,
      friction: 0.55,
      cellAlign: "center",
      groupCells: true,
      contain: true
    });
  </script>

  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
