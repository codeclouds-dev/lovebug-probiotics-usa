{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__text-grid.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign block_style = section.settings.block_style %}
{% assign section_layout = section.settings.section_layout %}
{% assign text_blocks = section.blocks | where: "type", "text_block" %}

{%- comment -%} hide main grid mobile because carousel will be showing {%- endcomment -%}
{% if section.settings.is_carousel_on_mobile != "" %}
  {% assign visibility = "show-for-large" %}
{% else %}
  {% assign visibility = "" %}
{% endif %}

{% if section.settings.is_carousel_on_mobile != "" %}
  {% assign full_mobile = "full-mobile" %}
{% endif %}

{% if section.settings.is_carousel_on_mobile == "autoplay" %}
  {% assign autoplay_mobile = "true" %}
{% else %}
  {% assign autoplay_mobile = "false" %}
{% endif %}

{% assign section_id = section.settings.custom_id | default: section.id %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% style %}
  #{{ section_id }} .main-image {
    --main_image_max_width_desktop: {{ section.settings.section_image_max_width }}px;
    --main_image_max_width_mobile: {{ section.settings.section_image_max_width_mobile }}px;
  }
{% endstyle %}

<section class="mfr-core__text-grid text-grid {{ custom_class }}" id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ full_mobile }} {{ container_width }}" {% if max_width != 0 and container_width == "" %}style="max-width: {{ max_width }}rem;" {% endif %}>
      <div class="inner">
        <div class="grid-x {{ content_alignment }}">
          <div class="cell small-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                  
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                  
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
              
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}

                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>

        {%- for block in section.blocks -%}
          {% case block.type %}
            {%- when 'image_block' -%}
              <div class="grid-x align-center">
                <div class="cell small-12 medium-9 {{ color_theme }} {{ text_alignment }}">
                  <div class="image-block">
                    <div class="main-image">
                      {% if block.settings.main_image != blank %}
                        {% render 'component__responsive-image',
                        mobile_image: block.settings.main_image, 
                        desktop_image: block.settings.main_image,
                        max_width: 1600,
                        loading_lazy: true 
                      %}
                      {% else %}
                        <div class="shopify-placeholder-image">
                          {%- capture svg_code -%}{{- 'image' | placeholder_svg_tag -}}{%- endcapture -%}
                          {% render 'component__svg-encoder', svg_code: svg_code, alt: "placeholder image" %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {%- when 'video_player' -%}
              <div class="grid-x align-center">
                <div class="cell small-12 medium-9 {{ color_theme }} {{ text_alignment }}">
                  <div class="video-player video-player-{{ block.id }}" data-aos="fade-up" data-aos-delay="">
                    <button type="button" class="button icon playpause" id="play_button-{{ block.id }}">
                      {% render 'icon-play' %}
                    </button>
                    <div class="cover-image" style="background-image:url({{ block.settings.poster_image | img_url: '1200x' }});"></div>
                    <video id="video_player" class="video" preload="auto" poster="{{ block.settings.poster_image | img_url: '1200x' }}">
                      <source src="{{ block.settings.slide_video_url | url }}" type="video/mp4">
                    </video>
                  </div>
                  <script type="text/javascript">
                    onReady( function () {
                      jQuery('.video-player-{{block.id}}').click(function () {
                        var videoEl = $(this).find("video").get(0);
                        if (videoEl.paused) {
                          videoEl.play();
                          $(this).find(".playpause, .cover-image").fadeOut();
                        } else {
                          videoEl.pause();
                          $(this).find(".playpause, .cover-image").fadeIn();
                        }
                      });
                    } );
                  </script>
                </div>
              </div>
          {% endcase %}
        {%- endfor -%}

        {% capture section_image %}
          {% capture image_size %}{{ section.settings.section_image_max_width }}x{% endcapture %}
          <div class="section-image {{ section_layout }}">
            
            {% if section.settings.section_image != blank %}
              <div class="main-image {{ section.settings.image_effects }}"> 
                {% render 'component__responsive-image',
                  mobile_image: section.settings.section_image,
                  desktop_image: section.settings.section_image,
                  max_width: 1600,
                  loading_lazy: true 
                %}
              </div>
            {% else %}
              <div class="shopify-placeholder-image">
                {%- capture svg_code -%}{{- 'image' | placeholder_svg_tag -}}{%- endcapture -%}
                {% render 'component__svg-encoder', svg_code: svg_code, alt: "placeholder image" %}
              </div>
            {% endif %}

            {% if section.settings.section_image_backing != blank %}
              <div class="backing-image" data-invew style="max-width: {{ section.settings.section_image_backing_max_width }}px;">
                {% render 'component__responsive-image',
                  mobile_image: section.settings.section_image_backing,
                  desktop_image: section.settings.section_image_backing,
                  max_width: 1600,
                  loading_lazy: true 
                %}
            <!-- <img loading="lazy" src="{{ section.settings.section_image | img_url: image_size }}"
              srcset="{{ section.settings.section_image | img_url: image_size }} 1x, {{ section.settings.section_image | img_url: image_size, scale: 2 }} 2x"
              alt="{{ section.settings.section_image.alt }}"> -->
            </div>
            {% endif %}
              
          </div>
          
        {% endcapture %}

        {% capture button %}
          <div class="button-set {{ content_alignment }}">
            {%- for block in section.blocks -%}
              {% if block.type == "button" %}
                {% render 'renderer__block-button', block: block %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {% endcapture %}


        {%- comment -%} show differnt layouts based on where the section image will show {%- endcomment -%}
        {% case section_layout %}

        {% when 'no_image' %}
          <div class="grid-x {{ color_theme }} small-up-12 medium-up-3 large-up-4 {{ content_alignment }} {{ section_layout }} image-style__{{ section.settings.image_style }}">
            {%- for block in section.blocks -%}
            {% case block.type %}
            {%- when 'text_block' -%}
            <div class="{{ visibility }} cell">
              {% render 'partial__text-grid-block', block: block %}
            </div>
            {%- endcase -%}
            {%- endfor -%}
          </div>  


        {% when 'centered_image' %}
        <div 
          class="grid-x grid-wrapper {{ color_theme }} {{ content_alignment }} {{ section_layout }} image-style__{{ section.settings.image_style }}"
          style="
            --image-bottom-offset: -{{ section.settings.bottom_spacing_desktop }}px;
          ">
          {% comment %} {% assign total_text_blocks = section.blocks.size | minus: 1 %}
          {% assign blocks_before_image = total_text_blocks | divided_by: 2 %}
          {% assign blocks_after_image = total_text_blocks | minus: blocks_before_image %}
          {% assign counter = 0 %} {% endcomment %}
          {% assign text_block_size = text_blocks | size %}
          {% assign first_half = text_block_size | divided_by: 2.00 | ceil %}
          {% assign second_half_starting_index = first_half | plus: 1 %}
          
          <!-- Left side text blocks -->
          <div class="cell small-12 medium-6 large-4 text-grid__column {{ visibility }}">
            {% for block in text_blocks %}
              {% if forloop.index <= first_half %}
                {% render 'partial__text-grid-block', block: block %}
              {% endif %}
            {% endfor %}
          </div>
        
          <!-- Central image block -->
          <div class="cell small-12 large-4 section-image-wrapper">
            {{ section_image }}
          </div>
        
          <!-- Right side text blocks -->
          <div class="cell small-12 medium-6 large-4 text-grid__column {{ visibility }}">
            {% for block in text_blocks %}
              {% if forloop.index >= second_half_starting_index and forloop.index <= text_block_size %}
                {% render 'partial__text-grid-block', block: block %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
        

        {% when 'image_above' %}
          <div class="grid-x align-center">
            <div class="cell small-12 medium-9 section-image-wrapper {{ color_theme }} {{ text_alignment }}" data-inview>
              {{ section_image }}
            </div>
          </div>
          <div class="grid-x grid-wrapper {{ color_theme }} small-up-2 large-up-3 {{ visibility }} {{ content_alignment }} {{ grid_inner_classes }} {{ section_layout }} image-style__{{ section.settings.image_style }}">
            
            {%- for block in section.blocks -%}
            {% case block.type %}
            {%- when 'text_block' -%}
            <div class="cell {{ text_block_grid_classes }}">
              {% render 'partial__text-grid-block', block: block %}
            </div>
            {%- endcase -%}
            {%- endfor -%}
          </div>


        {% when 'image_below' %}
          <div class="grid-x grid-wrapper {{ color_theme }} small-up-2 large-up-3 {{ visibility }} {{ content_alignment }} {{ grid_inner_classes }} {{ section_layout }} image-style__{{ section.settings.image_style }}">
            {%- for block in section.blocks -%}
            {% case block.type %}
            {%- when 'text_block' -%}
            <div class="cell {{ text_block_grid_classes }}">
              {% render 'partial__text-grid-block', block: block %}
            </div>
            {%- endcase -%}
            {%- endfor -%}
          </div>
          <div class="grid-x align-center" data-inview>
            <div class="cell small-12 medium-9 section-image-wrapper {{ color_theme }} {{ text_alignment }}" data-inview>
              {{ section_image }}
            </div>
          </div>

        {% else %}

        {% endcase %}

        {%- comment -%} turn to carousel on mobile {%- endcomment -%}
        {% if section.settings.is_carousel_on_mobile != "" %}
          <div id="aoc-mobile-slider--{{ section_id }}" class="text-grid__carousel hide-for-large {{ color_theme }} image-style__{{ section.settings.image_style }}"></div>
          <script>
            onReady(function() {
              var sliderIds = [];
              $('#{{ section_id }} .to-slider').each(function () {
                $(this).clone().appendTo(`#${$(this).attr("data-slider-id")}`);
                console.log( this );
                if (!sliderIds.includes(`#${$(this).attr("data-slider-id")}`)) sliderIds.push(`#${$(this).attr("data-slider-id")}`);
              });
              $.each(sliderIds, function (i, e) {
                $(e).flickity({
                  // options
                  cellAlign: 'center',
                  wrapAround: true,
                  autoPlay: {{ autoplay_mobile }},
                  prevNextButtons: false,
                  lazyLoad: true
                });
              });
            });
          </script>
        {% endif %}

        <div class="grid-x {{ content_alignment }} ">
          {{ button }}  
        </div>
      </div>
    </div>
  </div>

  {% render 'component__gradient-bg-styles' %}
  {% render 'component__accent-graphics' %}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>




{% schema %}
{
  "name":"Text Grid with Image",
  "disabled_on": {
    "groups": ["header","footer","custom.offcanvas","custom.modals"]
  },
  "settings":[
    {
      "type":"header",
      "content":"Layout Settings"
    },
    {
      "type":"select",
      "id":"section_layout",
      "options":[
        { "value":"no_image", "label":"No Image" },
        { "value":"centered_image", "label":"Centered Image" },
        { "value":"image_above", "label":"Image at Top" },
        { "value":"image_below", "label":"Image at Bottom" }
      ],
      "label":"Section Layout",
      "default":"image_above" 
    },
    {
      "type": "select",
      "id": "image_style",
      "options": [
          { "value": "transparent_image", "label": "Icon or Tranparent Graphic" },
          { "value": "cover_image", "label": "Full Image/JPG" }
          ],
      "label": "Image Style",
      "default": "transparent_image"
    },
    {
      "type": "select",
      "id": "block_style",
      "options": [
          { "value": "with-icon", "label": "Icon" },
          { "value": "no-icon", "label": "No Icon" }
          ],
      "label": "Text Block Style",
      "default": "with-icon"
    },
    {
      "type":"header",
      "content":"Section Image"
    },
    {
      "type":"image_picker",
      "id":"section_image",
      "label":"Section Image (Optional)"
    },
    {
      "type":"range",
      "id":"section_image_max_width",
      "min":30,
      "max":800,
      "step":10,
      "unit":"px",
      "label":"Image width",
      "default":400
    },
    {
      "type":"range",
      "id":"section_image_max_width_mobile",
      "min":30,
      "max":400,
      "step":10,
      "unit":"px",
      "label":"Image width Mobile",
      "default":140
    },
    {
      "type":"image_picker",
      "id":"section_image_backing",
      "label":"Backing Image (Optional)"
    },
    {
      "type":"range",
      "id":"section_image_backing_max_width",
      "min":30,
      "max":800,
      "step":10,
      "unit":"px",
      "label":"Backing Image width",
      "default":400
    },
    {
      "type":"select",
      "id":"image_effects",
      "options":[
        { "value":"", "label":"None" },
        { "value":"shadow", "label":"Add Shadow" },
        { "value":"float shadow", "label":"Add Float" }
      ],
      "label":"Image Effets",
      "default":""
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": ""
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Width",
      "default": 62
  },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },

    {
      "type": "select",
      "id": "is_carousel_on_mobile",
      "options": [
          { "value": "", "label": "Stacked" },
          { "value": "carousel", "label": "Carousel" },
          { "value": "autoplay", "label": "Autoplay Carousel" }
          ],
      "label": "Mobile Layout",
      "default": "carousel"
    },
    
    
    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },

    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },
    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "icon", 
      "name": "Icon",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "file_lottie_url",
          "label": "File Lottie URL"
        },
        {
          "type": "number",
          "id": "icon_width",
          "label": "Image width",
          "default": 150,
          "info": "in pixels."
        }
      ]
    },
    {
      "type":"small_text",
      "name":"Accent Text",
      "limit":1,
      "settings":[
        {
          "type":"text",
          "id":"text",
          "default":"Accent Text",
          "label":"Text"
        },
        {
          "type": "color",
          "id": "small_text_color",
          "label": "Color"
        }
      ]
    },
    
    {
      "type": "heading",
      "name": "Heading",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading H1",
          "label": "Heading H1"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "options": [
              { "value": "h1", "label": "H1"},
              { "value": "h2", "label": "H2"},
              { "value": "h3", "label": "H3"},
              { "value": "h4", "label": "H4"},
              { "value": "h5", "label": "H5"},
              { "value": "h6", "label": "H6"}
              ],
          "label": "Header Style",
          "default": "h1"
        },

        {
          "type": "header",
          "content": "Accent Settings"
        },
        {
          "type": "select",
          "id": "make_xl",
          "options": [
              { "value": "", "label": "Normal"},
              { "value": "xl-title", "label": "Oversize"}
              ],
          "label": "H1 Size",
          "default": "",
          "info": "H1s can be set to oversize if they need to be extra big"
        },

        {
            "type": "color",
            "id": "highlight_color",
            "label": "Highlight Color",
            "info": "Use [highlight][/highlight] to highlight text"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "info": "Use [underline][/underline] to underline text"
        },

        {
          "type": "header",
          "content": "Width Settings"
        },
        {
            "type": "range",
            "id": "max_width",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "rem",
            "label": "Max Width",
            "default": 0
        }
      ]
    },
    
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum vel metus auctor.</p>",
          "label": "Text"
        },
        {
          "type":"select",
          "id":"text_style",
          "options":[
            { "value": "", "label":"Default"},
            { "value":"xsmall", "label":"xSmall" },
            { "value":"small", "label":"Small" },
            { "value":"medium", "label":"Medium" },
            { "value":"large", "label":"Large" },
            { "value":"xlarge", "label":"xLarge" }
          ],
          "label":"Text Style",
          "default":""
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text Color",
          "info": "Leave it blank to use system settings."
        },
        {
          "type": "color",
          "id": "bold_color",
          "label": "Bold Color",
          "info": "Adding bold color will make the bolded text colored instead of being bold."
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "info": "Use [underline][/underline] to underline text(s)"
        },

        {
          "type": "header",
          "content": "Width Settings"
        },
        {
            "type": "range",
            "id": "max_width",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "rem",
            "label": "Max Width",
            "default": 0
        }
      ]
    },
    {
      "type":"button",
      "name":"Button",
      "limit":2,
      "settings":[
        {
          "type":"text",
          "id":"button_label",
          "default":"Button label",
          "label":"Button",
          "info":"Leave the label blank to hide the button."
        },
        {
          "type":"url",
          "id":"button_link",
          "label":"Button Link"
        },
        {
          "type": "select",
          "id": "color_theme",
          "label": "Color Theme",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ]
        }
      ]
    },
    {
      "type":"text_block",
      "name":"Text/Icon Block",
      "limit":10,
