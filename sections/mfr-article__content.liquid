{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% if section.settings.border_bottom %}
  <style>
    #shopify-section-{{ section.id }} {
      position: relative;
      &:before {
        content: '';
        pointer-events: none;
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1.5px;
        background: linear-gradient(130deg,#795A2E,#4F391F);
        z-index: 2;
      }
    }
  </style>
{% endif %}

{% render 'style-tags__section', asset_file_name: "mfr-article__content.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign metafield_data = section.blocks | where: "type", "metafield_data" %}
{% assign content = section.blocks | where: "type", "content" %}
{% assign side_info = section.blocks | where: "type", "side_info" | first %}

{% if side_info != blank %}
  {% assign align_center = "" %}
  {% assign section_content_size = "large-6" %}
{% else %}
  {% assign section_content_size = "" %}
{% endif %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

<section class="mfr-article__content {{ custom_class }} " id="{{ section_id }}">
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}

  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x {{ align_center }}">
        {% if metafield_data != blank %}
          <div class="cell small-12 article-content__data-wrapper {{ color_theme }}">
            {% for block in metafield_data %}
              <div class="article-content__data">
                {% for i in (1..3) %}
                  {% assign title_var = "title_" | append: i %}
                  {% assign info_var = "info_" | append: i %}
                  {% assign title = block.settings[title_var] %}
                  {% assign info = block.settings[info_var] %}

                  {% if info != blank %}
                    <div class="article-content__info">
                      {% if title != blank %}
                        <div class="article-content__info-title">
                          {{ title }}
                        </div>
                      {% endif %}
                      <div class="article-content__info-value">
                        {{ info }}
                      </div>
                    </div>
                  {% endif %}

                {% endfor %}
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if side_info != blank %}
          <div class="cell small-12 large-3 section-content article-content__side-info-wrapper {{ color_theme }}"
            data-mfr-sticky-container><!-- data-mfr-sticky-container -->
            <div class="article-content__side-info" data-mfr-sticky><!-- data-mfr-sticky -->
              {% if side_info.settings.title != blank %}
                <div class="article-content__side-info-title">
                  {% render "block__title", 
                    block_id: side_info.id,
                    text: side_info.settings.title,
                    header_style: "h4",
                    underline_color: "#CFF7FF" %}
                </div>
              {% endif %}
              {% if side_info.settings.content != blank %}
                <div class="article-content__side-info-content">
                  {% assign side_info_content = side_info.settings.content | split: "<br />" %}
                  {% for line in side_info_content %}
                    <p>{{ line | strip_html }}</p>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or content != blank %}
          <div class="cell small-12 {{ section_content_size }} section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
  
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                    
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                  {%- when "content" -%}
                    <div class="article-content__content" data-inview>
                      {%- assign article_content = article.content | default: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.' -%}
                      {%- assign article_media = article.metafields.mfr_fields.article_content_media.value -%}
                      {% if article_media != blank %}
                        {% for media in article_media %}
                          {%- capture media_tag -%}
                            {%- if media.media_type == "video" -%}
                              <div class="article-content__content-video {% if media.aspect_ratio > 1 %}is-landscape{% else %}is-portrait{% endif %}">
                                {{ media | video_tag: controls: true, playsinline: true, image_size: '400x', width: media['width'], height: media['height'] }}
                              </div>
                            {%- else %}
                              <div class="article-content__content-video {% if media.aspect_ratio > 1 %}is-landscape{% else %}is-portrait{% endif %}">
                                {{ media | image_url: width: 720 | image_tag: width: 720, widths: "420,480,600,720", alt: media.alt }}
                              </div>
                            {%- endif -%}
                          {%- endcapture -%}

                          {% assign shortcode = "[article-media-" | append: forloop.index  | append: "]" %}
                          {% assign article_content = article_content | replace: shortcode, media_tag %}
                        {% endfor %}
                      {% endif %}

                      {% assign article_content = article_content
                        | replace: 'style="text-decoration: underline;"', "class='custom-underline'" %}
                      
                      {{ article_content }}
                    </div>
                  

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}

            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>

{% schema %}
