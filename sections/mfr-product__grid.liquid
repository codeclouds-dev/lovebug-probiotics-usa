    {% for product in section.settings.collection.products %}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image_card' -%}
            {% if block.settings.index == grid_counter %}
              {%- liquid
                assign default_image = block.settings.image
                assign default_video = block.settings.video
                assign full_image_size = block.settings.full_image_size
                assign visibility = block.settings.visibility
              -%}
              {% if default_video != blank %}
                <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                  <div class="product-grid__image-card-inner">
                    <div class="product-grid__image-card--video">
                      {{ default_video 
                        | video_tag: 
                          controls: true,
                          muted: true,
                          autoplay: true,
                          playsinline: true, 
                          image_size: '720x' }}
                    </div>
                  </div>
                </div>
              {% elsif default_image != blank %}
                <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                  <div class="product-grid__image-card-inner">
                    <div class="product-grid__image-card--image">
                      {{ default_image 
                        | image_url: width: 720
                        | image_tag: width: 720,
                          widths: "420,480,600,720",
                          alt: default_image.alt }}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endif %}
        {%- endcase -%}
      {%- endfor -%}

      <div class="product-grid__entry">
        {% render 'partial__product-card', product: product %}
      </div>
    {% endfor %}
  {% else %}
      {% for product in collection.products %}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'image_card' -%}
              {% if block.settings.index == grid_counter %}
                {%- liquid
                  assign default_image = block.settings.image
                  assign default_video = block.settings.video
                  assign full_image_size = block.settings.full_image_size
                  assign visibility = block.settings.visibility
                -%}
              
                {% if default_video != blank %}
                  <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                    <div class="product-grid__image-card-inner">
                        <div class="product-grid__image-card--image">
                          {{ default_video 
                            | video_tag: 
                              controls: true,
                              muted: true,
                              autoplay: true,
                              playsinline: true, 
                              image_size: '720x' }}
                        </div>
                    </div>
                  </div>
                {% elsif default_image != blank %}
                  <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                    <div class="product-grid__image-card-inner">
                        <div class="product-grid__image-card--image">
                          {{ default_image 
                            | image_url: width: 720
                            | image_tag: width: 720,
                              widths: "420,480,600,720",
                              alt: default_image.alt }}
                        </div>
                    </div>
                  </div>
                {% endif %}
              {% endif %}
          {%- endcase -%}
        {%- endfor -%}

      <div class="product-grid__entry">
        {% render 'partial__product-card', product: product %}
      </div>
    {% endfor %}
  {% endif %}
{%- endcapture -%}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  {% unless section.settings.no_ajax %}
    <div class="product-grid__filter">
      <button class="button"
        data-open="offCanvasFilter">
        {%- capture chevron_code -%}{%- render "icon__filter", color: section.settings.color_scheme.settings.text -%}{%- endcapture -%}
        {% render 'component__svg-encoder',
          svg_code: chevron_code,
          alt: "chevron" %}

        {{ section.settings.filter_label | default: "Filter By" }}
      </button>
      <div class="product-grid__active-filters"></div>
      <button class="button grid-reset">
        <span>Clear Filters</span>
      </button>
    </div>
  {% endunless %}

  <div class="product-grid" id="product-grid--{{ section.id }}">
    {% if section.settings.no_ajax %}
      {{ without_ajax }}
    {% else %}
      {{ with_ajax }}
    {% endif %}
  </div>
{% endcapture %}

<section class="mfr-product__grid-with-filters {{ custom_class }}" id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}
                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="cell small-12 product-grid__wrapper">
          {{ custom_section_content }}
        </div>

        {% if reviews != blank %}
          <div class="cell small-12 product-grid__reviews"
            data-stagger-inview=".product-grid__review">
            {% for review in reviews %}
              <div class="product-grid__review">
                <div class="product-grid__review-info">
                  {% if review.settings.image != blank %}
                    <div class="product-grid__review-info-image"
                      style="
                        --bg-color: {{ review.settings.image_background }};
                      ">
                      {% assign default_alt = "maybe a product image about what " | append: review.settings.name | append: " gave his/her review." %}
                      {% assign alt = review.settings.image.alt | default: default_alt %}
                      {% render 'component__lazyload-image',
                        image: review.settings.image,
                        width: 144,
                        alt: alt,
                        widths: "144" %}
                    </div>
                  {% endif %}
                  <div class="product-grid__review-info-inner">
                    {% render 'icon-stars',
                      color: review.settings.star_color,
                      count: review.settings.stars %}
                    <p class="product-grid__review-info-name">
                      {{ review.settings.name }}
                    </p>
                    {% if review.settings.caption != blank %}
                      <p class="product-grid__review-info-caption">
                        {{ review.settings.caption }}
                      </p>
                    {% endif %}
                  </div>
                </div>

                <p class="product-grid__review-text">
                  {{ review.settings.review }}
                </p>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers' -%}
</section>


{% schema %}
{
  "name":"Product: Grid",
  "disabled_on": {
    "groups": ["header","footer","custom.offcanvas","custom.modals"]
  },
  "settings":[
    {
      "type": "checkbox",
      "id": "no_ajax",
      "label": "No Ajax?",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter Label",
      "default": "Filter By"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load More Label",
      "default": "Load More"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },

    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },
    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "icon", 
