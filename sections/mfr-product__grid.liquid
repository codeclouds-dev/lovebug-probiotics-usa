{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-product__grid.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %} 
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign image_cards = section.blocks | where: "type", "image_card" | first %}
{% assign reviews = section.blocks | where: "type", "review" %}
{% assign collection_images = collection.metafields.mfr_fields.collection_images.value %}

{% assign current_collection = collection.handle %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{%- capture with_ajax -%}
  {% if image_cards != blank %}
    {% assign offset_limit = 2 %}
  {% endif %}

  {% assign pagination_limit = 14 | minus: offset_limit %}
  {% assign image_cards_size = image_cards | size | times: 2 %}
  {% assign pagination_limit = pagination_limit | minus: image_cards_size %}

  {% if section.settings.collection != blank %}
    {% paginate section.settings.collection.products by pagination_limit %}
      {% for product in section.settings.collection.products %}
        {% assign grid_counter = forloop.index0 %}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'image_card' -%}
              {% if block.settings.index == grid_counter %}
                {%- liquid
                  assign default_image = block.settings.image
                  assign default_video = block.settings.video
                  assign full_image_size = block.settings.full_image_size
                  assign visibility = block.settings.visibility
                -%}
                {% if default_video != blank %}
                  <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                    <div class="product-grid__image-card-inner">
                        <div class="product-grid__image-card--video">
                          {{ default_video 
                            | video_tag: 
                              controls: true,
                              muted: true,
                              autoplay: true,
                              playsinline: true, 
                              image_size: '720x' }}
                        </div>
                    </div>
                  </div>
                {% elsif default_image != blank %}
                  <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                    <div class="product-grid__image-card-inner">
                        <div class="product-grid__image-card--image">
                          {{ default_image 
                            | image_url: width: 720
                            | image_tag: width: 720,
                              widths: "420,480,600,720",
                              alt: default_image.alt }}
                        </div>
                    </div>
                  </div>
                {% endif %}
              {% endif %}
          {%- endcase -%}
        {%- endfor -%}

        <div class="product-grid__entry">
          {% render 'partial__product-card', product: product %}
        </div>
      {% endfor %}

      {% if paginate.next != blank %}
        <div class="product-grid__load-more">
          <a href="{{ paginate.next.url }}" class="button underline">
            <span class="text">{{ section.settings.load_more_label | default: "Load More" }}</span>
          </a>
        </div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    {% paginate collection.products by pagination_limit %}

      {% for product in collection.products %}
        {% if paginate.current_page == 1 %}
          {% assign grid_counter = forloop.index0 %}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'image_card' -%}
                {% if block.settings.index == grid_counter %}
                  {%- liquid
                    assign default_image = block.settings.image
                    assign default_video = block.settings.video
                    assign full_image_size = block.settings.full_image_size
                    assign visibility = block.settings.visibility
                  -%}
                
                  {% if default_video != blank %}
                    <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                      <div class="product-grid__image-card-inner">
                          <div class="product-grid__image-card--image">
                            {{ default_video 
                              | video_tag: 
                                controls: true,
                                muted: true,
                                autoplay: true,
                                playsinline: true, 
                                image_size: '720x' }}
                          </div>
                      </div>
                    </div>
                  {% elsif default_image != blank %}
                    <div class="product-grid__image-card {{ visibility }} {% if full_image_size %}mobile-full{% else %}mobile-half{% endif %}">
                      <div class="product-grid__image-card-inner">
                          <div class="product-grid__image-card--image">
                            {{ default_image 
                              | image_url: width: 720
                              | image_tag: width: 720,
                                widths: "420,480,600,720",
                                alt: default_image.alt }}
                          </div>
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
            {%- endcase -%}
          {%- endfor -%}
        {% endif %}

        <div class="product-grid__entry">
          {% render 'partial__product-card', product: product %}
        </div>
      {% endfor %}

      {% if paginate.next != blank %}
        <div class="product-grid__load-more">
          <a href="{{ paginate.next.url }}" class="button underline">
            <span class="text">{{ section.settings.load_more_label | default: "Load More" }}</span>
          </a>
        </div>
      {% endif %}
    {% endpaginate %}
  {% endif %}
{%- endcapture -%}

{%- capture without_ajax -%}
