{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-lb__icon-text-image.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign geek_switches = section.blocks | where: "type", "geek_switch" %}
{% assign main_image = section.blocks | where: "type", "main_image" | first %}
{% assign icon_texts = section.blocks | where: "type", "icon_text" %}
{% assign icon_texts_size = section.blocks | where: "type", "icon_text" | size %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="icon-text-image">
    {%- capture geek_text -%}
      {% assign block_id = block.id | replace: "-", " " | replace: "_", " " | camelcase %}
      <span
        class="geek-text"
        x-show="geekMode" 
        x-collapse
        :aria-hidden="!geekMode"
        x-cloak>
    {%- endcapture -%}
    {% if main_image != blank %}
      <div class="icon-text-image__main-image">
        {%- capture bg_svg_code -%}
          <svg width="460px" height="540px" viewBox="0 0 460 540" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
            <title>Group 4</title>
            <g id="Asset-Guide" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd" opacity="0.21" stroke-dasharray="6">
              <g id="What-The" transform="translate(-51, -3557)" stroke="{{- section.settings.color_scheme.settings.text | default: '#1F377E' -}}" stroke-width="2">
                <g id="Group-4" transform="translate(52, 3558)">
                  <path d="M229,519 C344.979797,519 439,407.071187 439,269 C439,130.928813 344.979797,19 229,19 C113.020203,19 19,130.928813 19,269 C19,407.071187 113.020203,519 229,519 Z" id="Oval"></path>
                  <path d="M229,538 C355.473208,538 458,417.564598 458,269 C458,120.435402 355.473208,0 229,0 C102.526792,0 0,120.435402 0,269 C0,417.564598 102.526792,538 229,538 Z" id="Oval"></path>
                </g>
              </g>
            </g>
          </svg>
        {%- endcapture -%}
        {%- assign bg_svg_code = bg_svg_code -%}
        {% render 'component__svg-encoder',
          svg_code: bg_svg_code,
          alt: "circular broken lines",
          class:"icon-text-image__main-image-bg",
          width: 600 %}
        
        {%- capture sizes -%}
          calc(68vw < 450px ? 68vw : 450px),
          (min-width: 1024px) calc(33vw < 450px ? 33vw : 450px)
        {%- endcapture -%}
        {% render 'component__lazyload-image',
          image: main_image.settings.image,
          alt: main_image.settings.image.alt,
          width: 600,
          widths: "360,420,480,600",
          class: "icon-text-image__main-image-img floating",
          sizes: sizes %}

      </div>
    {% endif %}

    {% if icon_texts != blank %}
      <div class="icon-text-image__icon-texts first"
        data-stagger-inview=".icon-text-image__icon,.icon-text-image__title,.icon-text-image__caption">
        {% for icon_text in icon_texts %}
          {% if forloop.index0 == 0 or forloop.index0 == 1 %}
            <div class="icon-text-image__icon-text">
              <div class="icon-text-image__icon">
                {% assign default_alt = "maybe an image about " | append: icon_text.settings.title %}
                {% assign alt = icon_text.settings.icon.alt | default: default_alt %}
                {% render 'component__lazyload-image',
                  image: icon_text.settings.icon,
                  width: 144,
                  alt: alt %}
              </div>
              <div class="icon-text-image__texts">
                {% if icon_text.settings.title != blank %}
                  <p class="icon-text-image__title">
                    {{ icon_text.settings.title }}
                  </p>
                {% endif %}
                {% if icon_text.settings.caption != blank %}
                  <p class="icon-text-image__caption">
                    {{ icon_text.settings.caption
                      | replace: "[geek-text]", geek_text
                      | replace: "[/geek-text]", "</span>" }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if icon_texts_size >= 3 %}
      <div class="icon-text-image__icon-texts second"
        data-stagger-inview=".icon-text-image__icon,.icon-text-image__title,.icon-text-image__caption">
        {% for icon_text in icon_texts %}
          {% if forloop.index0 == 2 or forloop.index0 == 3 %}
            <div class="icon-text-image__icon-text">
              <div class="icon-text-image__icon">
                {% assign default_alt = "maybe an image about " | append: icon_text.settings.title %}
                {% assign alt = icon_text.settings.icon.alt | default: default_alt %}
                {% render 'component__lazyload-image',
                  image: icon_text.settings.icon,
                  width: 144,
                  alt: alt %}
              </div>
              <div class="icon-text-image__texts">
                {% if icon_text.settings.title != blank %}
                  <p class="icon-text-image__title">
                    {{ icon_text.settings.title }}
                  </p>
                {% endif %}
                {% if icon_text.settings.caption != blank %}
                  <p class="icon-text-image__caption">
                    {{ icon_text.settings.caption
                      | replace: "[geek-text]", geek_text
                      | replace: "[/geek-text]", "</span>" }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endcapture %}

<section class="mfr-lb__icon-text-image {{ custom_class }} " id="{{ section_id }}"
  {% if geek_switches != blank %}
    x-data="{
      geekMode: false
    }"
  {% endif %}>
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      {% if section.settings.notepad_bg %}
      <div class="notepad">
        <div class="notepad__header">
          {% for i in (1..40) %}
            <span></span>
          {% endfor %}
        </div>
      {% endif %}
        <div class="grid-x align-center {% if section.settings.notepad_bg %}notepad__body{% endif %}">
          {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
            <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
              <div class="inner">
                {%- for block in section.blocks -%}
                  {% case block.type %}
                  
                    {%- when 'icon' -%}
                      {% render 'renderer__block-icon', block: block %} 
                  
                    {%- when 'small_text' -%}
                      {% render "renderer__block-small-text", block: block %}
                      
                    {%- when 'heading' -%}
                      {% render "renderer__block-title", block: block %}
                      
                    {%- when 'text' -%}
                      {% render "renderer__block-text", block: block %}

                    {%- when 'geek_switch' %}
                      {% render 'component__geek-switch' %}
  
                  {%- endcase -%}
                {%- endfor -%}
              </div>
            </div>
          {% endif %}
  
          {% if main_image != blank or icon_texts != blank %}
            <div class="cell small-12 large-12 icon-text-image__wrapper">
              {{ custom_section_content }}
            </div>
          {% endif %}
  
          {% if buttons != blank %}
            <div class="cell small-12 button-set {{ content_alignment }}">
              {%- for block in section.blocks -%}
                {% case block.type %}
                  {%- when 'button' -%}
                    {% render 'renderer__block-button', block: block %}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          {% endif %}
      {% if section.settings.notepad_bg %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
{
  "name":"LB: Icon Text w/ Image",
  "disabled_on": {
    "groups": [
