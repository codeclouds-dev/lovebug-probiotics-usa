.152338 24.635548 11.032288Q23.067741 10.912239 21.586704 10.786995Q20.105667 10.661751 18.714962 10.531614Q17.324259 10.401478 16.027239 10.266762Q14.730219 10.132046 13.530008 9.9930763Q12.329798 9.8541069 11.229287 9.7112179Q10.128777 9.5683279 9.1306171 9.4218626Q8.1324577 9.2753973 7.2390552 9.1257095Q6.3456526 8.9760218 5.5591583 8.823472Q4.7726641 8.6709232 4.0949736 8.5158787Q3.4172826 8.3608341 2.8500273 8.2036686Q2.2827721 8.0465031 1.8273195 7.8875952Q1.3718668 7.7286873 1.0293138 7.5684204Q0.68676066 7.4081535 0.45793244 7.246913Q0.22910419 7.0856724 0.1145521 6.9238462Q0 6.7620211 0 6.5999999Q0 6.4379787 0.1145521 6.2761531Q0.22910419 6.1143274 0.45793244 5.9530873Q0.68676066 5.7918463 1.0293138 5.6315789Q1.3718668 5.4713116 1.8273195 5.3124037Q2.2827721 5.1534958 2.8500273 4.9963307Q3.4172826 4.8391652 4.0949736 4.6841207Q4.7726641 4.5290766 5.5591583 4.3765264Q6.3456526 4.2239766 7.2390552 4.0742888Q8.1324577 3.9246011 9.1306171 3.778136Q10.128777 3.631671 11.229286 3.4887812Q12.329796 3.3458915 13.530006 3.2069216Q14.730217 3.0679517 16.027237 2.9332361Q17.324257 2.7985206 18.714962 2.6683843Q20.105665 2.5382481 21.586704 2.4130042Q23.067741 2.2877603 24.635546 2.1677108Q26.20335 2.0476611 27.854143 1.9330951Q29.504936 1.8185289 31.234741 1.7097223Q32.964546 1.6009158 34.769199 1.4981309Q36.573845 1.3953459 38.448994 1.2988302Q40.324142 1.2023144 42.265266 1.1123004Q44.206394 1.0222864 46.208824 0.93899107Q48.211254 0.85569572 50.270164 0.77931958Q52.329075 0.70294344 54.439503 0.63367057Q56.549934 0.56439769 58.706799 0.50239497Q60.863663 0.44039226 63.061768 0.38580906Q65.259872 0.33122593 67.493927 0.28419375Q69.727966 0.23716155 71.992584 0.19779369Q74.257187 0.15842582 76.546906 0.12681712Q78.836624 0.095208414 81.145927 0.071435012Q83.455231 0.047661621 85.778572 0.031780798Q88.101898 0.015899975 90.433655 0.0079499874Q92.765427 0 95.099998 0Q97.43457 0 99.766342 0.0079499874Q102.0981 0.015899975 104.42143 0.031780798Q106.74476 0.047661621 109.05406 0.071435019Q111.36337 0.095208414 113.65308 0.12681712Q115.94279 0.15842582 118.20741 0.19779369Q120.47202 0.23716155 122.70607 0.28419375Q124.94012 0.33122593 127.13822 0.38580909Q129.33632 0.44039226 131.49318 0.50239497Q133.65005 0.56439769 135.76048 0.63367057Q137.87091 0.70294344 139.92982 0.77931958Q141.98874 0.85569572 143.99117 0.93899107Q145.99359 1.0222864 147.93472 1.1123004Q149.87585 1.2023144 151.75099 1.2988302Q153.62614 1.3953459 155.4308 1.4981308Q157.23544 1.6009157 158.96524 1.7097223Q160.69504 1.8185289 162.34584 1.9330951Q163.99663 2.0476611 165.56444 2.1677108Q167.13223 2.2877603 168.61328 2.4130042Q170.09431 2.5382481 171.48502 2.6683843Q172.87572 2.7985206 174.17274 2.9332361Q175.46976 3.0679517 176.66997 3.2069216Q177.87018 3.3458915 178.9707 3.4887815Q180.0712 3.631671 181.06937 3.778136Q182.06752 3.9246011 182.96092 4.0742888Q183.85432 4.2239766 184.64082 4.3765268Q185.42731 4.5290766 186.10501 4.6841211Q186.7827 4.8391657 187.34995 4.9963307Q187.91721 5.1534958 188.37267 5.3124037Q188.82811 5.4713116 189.17067 5.6315789Q189.51321 5.7918463 189.74207 5.9530869Q189.97089 6.1143274 190.08545 6.2761531Q190.19998 6.4379787 190.2 6.5999999Z"/>
              </svg>
            {%- endcapture -%}
            {% render 'component__svg-encoder',
              svg_code: shadow_svg_code,
              alt: "shadow" %}
          </div>
        </div>
      </div>
    </div>
    <div class="dress-up__actions"
      x-data='{
        types: {
          {%- for type in types %}
            {{ type }}: {{- forloop.first -}},
          {%- endfor -%}
        },
        showWrapper: true
      }'>
      <div class="dress-up__actions-types">
        <div class="dress-up__actions-types-inner">
          {%- for type in types -%}
            <button
              aria-label="{{- type -}}"
              :aria-expanded='types.{{ type }}'
              @click='
                if(!types.{{ type }}) {
                  Object.keys(types).forEach(key => types[key] = false);
                  showWrapper = false;
                  types.{{ type }} = true;
                  setTimeout( () => {
                    showWrapper = true;
                  }, 400 );
                }
              '>
                {{- type -}}
            </button>
          {%- endfor -%}
        </div>
      </div>
      <div class="dress-up__actions-selections">
        {%- for type in types -%}
          <div class="dress-up__actions-selection"
            role="list-box"
            x-show="types.{{ type }} && showWrapper"
            x-transition:enter-start="opacity-0 -translate-x-full"
            x-transition:enter-end="opacity-100 translate-x-0"
            x-transition:leave-start="opacity-100 translate-x-0"
            x-transition:leave-end="opacity-0 -translate-x-full"
            x-cloak>
            {% for item in metaobjects %}
              {% if item.item_type == type %}
                {%- assign first_option = metaobjects | where: "item_type", type | first -%}
                {%- assign setting = "selected_" |  append: type | handleize | downcase -%}
                {%- assign selected = selected_preset.settings[setting] | handleize | default: first_option_value -%}
                {%- assign item_label = item.label | handleize -%}

                {% if selected == item_label %}
                  {% assign is_selected = true %}
                {% else %}
                  {% assign is_selected = false %}
                {% endif %}

                <button
                  role="option"
                  aria-selected="{{ is_selected }}"
                  aria-label="{{- item.label -}}"
                  :aria-selected='selectedItems.{{ type }} == "{{ item_label }}"'
                  @click='
                    if(selectedItems.{{ type }} != "{{ item_label }}") {
                      selectedItems.{{ type }} = "{{ item_label }}"
                    }

                    $data.saveToLocalStorage();
                    $dispatch("update-character-data", { data: selectedItems });
                  '
                  style="
                    {%- if item.order -%}order: {{ item.order }};{%- endif -%}
                  ">
                  {% render 'component__lazyload-image',
                    image: item.thumbnail,
                    width: 144,
                    widths: "144" %}
                  <span class="visually-hidden">{{- item_label -}}</span>
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {%- endfor -%}
      </div>
      <div class="dress-up__actions-extras">
        <button
          aria-label="Start Over"
          @click='
            selectedItems = defaultSelectedItems;
            $data.saveToLocalStorage();
            $dispatch("update-character-data", { data: selectedItems });
          '>Start Over</button>
        <button
          aria-label="Download"
          @click='
            html2canvas($refs.heroImage, {
              useCORS: true
            }).then((canvas) => {
              dressUpHeroImage = canvas.toDataURL();
              $data.saveAs(dressUpHeroImage, "hero-character.png");
            });
          '>Download</button>
      </div>
    </div>
  </div>
{% endcapture %}

<section class="mfr-lb__dress-up {{ custom_class }} " id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}

                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %}

                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}

                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}

                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        <div class="cell small-12 large-12 dress-up__wrapper">
          {{ custom_section_content }}
        </div>
      </div>
    </div>
  </div>

  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
{
  "name":"LB: Dress Up",
  "disabled_on": {
    "groups": [
      "header", "footer", "custom.offcanvas","custom.modals"
    ]
  },
  "settings":[
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },

    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },

    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },


    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "selected_presets",
      "name": "Selected Presets",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "selected_skin",
          "options": [
            { "value": "skin-1", "label": "Skin 1" },
            { "value": "skin-2", "label": "Skin 2" },
