{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-lb__dress-up.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;"
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign selected_preset = section.blocks | where: "type", "selected_presets" | first %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here
{% endcomment %}
{% capture custom_section_content %}
  {% assign metaobjects = shop.metaobjects.dress_up_item.values  %}
  <div style="background-color: yellow;padding: 10px">{{ shop.metaobjects['dress_up_item'].values.size }}</div>
  {% assign types = "Skin,Faces,Hair,Outfits,Scene" | split: "," %}
  <div class="dress-up"
    x-data='{
      selectedItems: localStorage.getItem( "mfr-lb__dress-up" ) ? JSON.parse(localStorage.getItem( "mfr-lb__dress-up" )) : {
        {%- for type in types %}
          {%- assign first_option = metaobjects | where: "item_type", type | first -%}
          {%- assign first_option_value = first_option.label | handleize -%}
          {%- assign setting = "selected_" |  append: type | handleize | downcase -%}
          {%- assign selected = selected_preset.settings[setting] | handleize | default: first_option_value -%}

          {{ type }}: "{{- selected -}}",
        {%- endfor -%}
      },
      defaultSelectedItems: {
        {%- for type in types %}
          {%- assign first_option = metaobjects | where: "item_type", type | first -%}
          {%- assign first_option_value = first_option.label | handleize -%}
          {%- assign setting = "selected_" |  append: type | handleize | downcase -%}
          {%- assign selected = selected_preset.settings[setting] | handleize | default: first_option_value -%}

          {{ type }}: "{{- selected -}}",
        {%- endfor -%}
      },
      items: {
        {%- for item in metaobjects -%}
          "{{- item.item_type | handleize -}}--{{- item.label | handleize -}}": {
            label: "{{- item.label -}}",
            itemType: "{{- item.item_type -}}",
            thumbnail: "{{- item.thumbnail | image_url: width: 144 -}}",
            itemImageMobile: "{{- item.item_image_mobile | image_url: width: 480 -}}",
            itemImageDesktop: "{{- item.item_image | image_url: width: 900 -}}",
            {%- if item.order != blank -%}order:{{ item.order }},{%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      },
      saveToLocalStorage() {
        localStorage.setItem( "mfr-lb__dress-up", JSON.stringify( $data.selectedItems ) );
      },
      saveAs(uri, filename) {
        var link = document.createElement("a");

        if (typeof link.download === "string") {
          link.href = uri;
          link.download = filename;

          //Firefox requires the link to be in the body
          document.body.appendChild(link);

          //simulate click
          link.click();

          //remove the link when done
          document.body.removeChild(link);
        } else {
          window.open(uri);
        }
      },
      preloadImages(imageUrls, callback) {
        let loadedImages = 0;
        const totalImages = imageUrls.length;

        imageUrls.forEach((url) => {
          const img = new Image();
          img.src = url;
          img.onload = () => {
            loadedImages++;
            if (loadedImages === totalImages && callback) {
              callback();
            }
          };
          img.onerror = () => {
            console.error(`Failed to load image: ${url}`);
            loadedImages++;
            if (loadedImages === totalImages && callback) {
              callback();
            }
          };
        });
      }
    }'
    x-init='
      saveToLocalStorage();
      $dispatch("update-character-data", { data: selectedItems });
      const mobileImages = Object.values(items).map( (e,i) => e.itemImageMobile);
      const desktopImages = Object.values(items).map( (e,i) => e.itemImageMobile);
      if( window.innerWidth <= 1023 )
        preloadImages(mobileImages, () => {
          console.log( "Mobile Dress Up Images Loaded" );
        } );
      else
        preloadImages(desktopImages, () => {
          console.log( "Desktop Dress Up Images Loaded" );
        } );
    '>
    <div class="dress-up__media">
      <div class="dress-up__image"
        x-ref='heroImage'>
        <div class="dress-up__image-scene">
          <template
            x-if='selectedItems.Scene && selectedItems.Scene != "" && window.innerWidth <= 1023'>
            <img :src='items["scene--" + selectedItems.Scene].itemImageMobile' alt="super hero background" width="856" height="629">
          </template>
          <template
            x-if='selectedItems.Scene && selectedItems.Scene != "" && window.innerWidth >= 1024'>
            <img :src='items["scene--" + selectedItems.Scene].itemImageDesktop' alt="super hero background" width="856" height="629">
          </template>
        </div>
        <div class="dress-up__image-character"
          x-ref='heroCharacter'>
          {%- for type in types -%}
            {% if type != "Scene" %}
              <div class="dress-up__image-{{ type | handleize }}">
                <template
                  x-if='selectedItems.{{ type }} && selectedItems.{{ type }} != "" && window.innerWidth <= 1023'>
                  <img :src='items["{{- type | handleize -}}--" + selectedItems.{{ type }}].itemImageMobile'
                    alt="super hero {{ type }}"
                    width="856"
                    height="629"
                    loading="lazy">
                </template>
                <template
                  x-if='selectedItems.{{ type }} && selectedItems.{{ type }} != "" && window.innerWidth >= 1024'>
                  <img :src='items["{{- type | handleize -}}--" + selectedItems.{{ type }}].itemImageDesktop'
                    alt="super hero {{ type }}"
                    width="856"
                    height="629"
                    loading="lazy">
                </template>
              </div>
            {% endif %}
          {%- endfor -%}
          <div class="dress-up__image-shadow">
            {%- capture shadow_svg_code -%}
              <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="204" height="46">
