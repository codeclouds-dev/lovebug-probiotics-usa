                        <path fill="#2B3990" transform="translate(20.5833 15.1667)" d="M0 3.8438561L-2.6645353e-15 17.73757C-5.6715494e-16 18.84214 0.89543051 19.73757 2 19.73757C2.422904 19.73757 2.8349237 19.603516 3.1768618 19.354666L12.902461 12.276735C13.795558 11.626773 13.992658 10.375875 13.342694 9.4827785C13.212783 9.3042707 13.054212 9.1485043 12.873413 9.0217991L3.1478133 2.2060149C2.2432585 1.5720949 0.99607843 1.7914879 0.3621586 2.6960428C0.12644683 3.0323853 -5.0298014e-17 3.4331417 0 3.8438561Z" fill-rule="evenodd"/>
                      </svg>
                    </button>
                {% endif %}
              {%- else -%}
                {% assign default_alt = "maybe an image about the review about " | append: entry.label %}
                {% assign alt = image.alt | default: default_alt %}
                {% render 'component__lazyload-image',
                  image: image,
                  width: 420,
                  alt: alt %}
              {% endif %}
            </div>
            {% if label != blank %}
              <span class="video-reviews__label">
                {{ label }}
              </span>
            {% endif %}
          </div>
          <div class="video-reviews__footer">
            <div class="video-reviews__footer-stars">
              {% render 'icon-stars',
                count: stars %}
            </div>
            {% if review != blank %}
              <p class="video-reviews__footer-caption">
                {{ review }}
              </p>
            {% endif %}
            {% if name != blank %}
              <span class="video-reviews__footer-sub-caption">
                {{ name }}
              </span>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endcapture %}

{% if entries != blank %}
  <section class="mfr-lb__video-reviews carousel {{ custom_class }} " id="{{ section_id }}">
    <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
      <div class="grid-container {{ container_width }}" {{ max_width_style }}>
        <div class="grid-x align-center" style="--vertical-alignment: {{ section.settings.vertical_alignment }};">
          {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
            <div class="cell small-12 {{ content_col }} section-content {{ color_theme }} {{ text_alignment }} {{ text_order_mobile_class }} {{ text_order_desktop_class }}">
              <div class="inner">
                {%- for block in section.blocks -%}
                  {% case block.type %}
                  
                    {%- when 'icon' -%}
                      {% render 'renderer__block-icon', block: block %} 
                  
                    {%- when 'small_text' -%}
                      {% render "renderer__block-small-text", block: block %}
                      
                    {%- when 'heading' -%}
                      {% render "renderer__block-title", block: block %}
                      
                    {%- when 'text' -%}
                      {% render "renderer__block-text", block: block %}
  
                    {%- when "star_rating" -%}
                      <div class="video-reviews__star-rating">
                        <div class="video-reviews__star-rating-stars">
                          {% render 'icon-stars',
                            color: section.settings.color_scheme.settings.icons,
                            count: block.settings.stars %}
                        </div>
                        {% if block.settings.label != blank %}
                          <span class="video-reviews__star-rating-label">
                            {{ block.settings.label }}
                          </span>
                        {% endif %}
                      </div>
  
                  {%- endcase -%}
                {%- endfor -%}
  
                {% if buttons != blank %}
                  <div class="button-set {{ content_alignment }}">
                    {%- for block in section.blocks -%}
                      {% case block.type %}
                        {%- when 'button' -%}
                          {% render 'renderer__block-button', block: block %}
                      {%- endcase -%}
                    {%- endfor -%}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
  
          <div class="cell small-12 video-reviews__wrapper carousel {{ media_col }} {{ media_order_mobile_class }} {{ media_order_desktop_class }}"
            data-mfr-carousel="
              {
                prevNextButtons: false,
                contain: true,
                cellAlign: 'center',
                pageDots: true,
                wrapAround: false,
                groupCells: false,
                mobileSettings: {
                  cellAlign: 'center',
                  contain: true,
                  wrapAround: false
                }
              }
            "
            data-mfr-carousel-on-ready='
              const pageDots = this.$slider.find( ".flickity-page-dots" );
              this.$items.each( (i,e) => {
                const label = $( e ).find( ".video-reviews__label" ).text();
                pageDots.find( "li" ).each( (index,li) => {
                  if( index == i ) {
                    $( li ).html( `
                      <span>${label}</span>
                    ` )
                  }
                } );
              } );
            '>
            {{ custom_section_content }}
          </div>
        </div>
      </div>
    </div>
    
    {%- render 'component__gradient-bg-styles' -%}
    {%- render 'component__accent-graphics' -%}
    {%- render 'component__section-dividers', is_video_background: true -%}
    {% render 'script__section', file: "mfr-carousel.js" %}
  </section>
{% endif %}

{% schema %}
{
  "name":"LB: Video Reviews",
  "disabled_on": {
    "groups": [
      "header", "footer", "custom.offcanvas","custom.modals"
    ]
  },
  "settings":[
    {
      "type": "metaobject_list",
      "id": "video_reviews",
      "label": "Video Reviews",
      "metaobject_type": "video_review"
    },
    {
      "type": "header",
      "content": "Order Settings"
    },
    {
      "type": "select",
      "id": "order_mobile",
      "label": "Order - Mobile",
      "options": [
        {
          "value": "text-top",
          "label": "Text Top"
        },
        {
          "value": "text-bottom",
          "label": "Text Bottom"
        }
      ],
      "default": "text-top"
    },
    {
      "type": "select",
      "id": "order_desktop",
      "label": "Order - Desktop",
      "options": [
        {
          "value": "text-left",
          "label": "Text Left"
        },
        {
          "value": "text-right",
          "label": "Text Right"
        }
      ],
      "default": "text-left"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_column_size",
      "label": "Media Column Size",
      "options": [
        {
          "value": "one-third",
          "label": "1/3"
        },
        {
          "value": "half",
          "label": "1/2"
        },
        {
          "value": "two-thirds",
          "label": "2/3"
        }
      ],
      "default": "half"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
        ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
        ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
        ],
      "label": "Section Padding",
      "default": ""
    },
    {
      "type": "header",
      "content": "Color Schemes Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color Scheme",
      "info": "This will be the color scheme of the header initially."
    },
    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },
    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },
    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },

    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "icon", 
      "name": "Icon",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
