{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-lb__video-reviews.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% if section.settings.image_column_size == "one-third" %}
  {% assign media_col = "large-4" %}
  {% assign content_col = "large-8" %}
{% elsif section.settings.image_column_size == "half" %}
  {% assign media_col = "large-6" %}
  {% assign content_col = "large-6" %}
{% elsif section.settings.image_column_size == "two-thirds" %}
  {% assign media_col = "large-8" %}
  {% assign content_col = "large-4" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}

{% if section.settings.order_mobile == "text-top" %}
  {% assign text_order_mobile_class = "small-order-1" %}
  {% assign media_order_mobile_class = "small-order-2" %}
{% else %}
  {% assign text_order_mobile_class = "small-order-2" %}
  {% assign media_order_mobile_class = "small-order-1" %}
{% endif %}

{% if section.settings.order_desktop == "text-left" %}
  {% assign text_order_desktop_class = "large-order-1" %}
  {% assign media_order_desktop_class = "large-order-2" %}
{% else %}
  {% assign text_order_desktop_class = "large-order-2" %}
  {% assign media_order_desktop_class = "large-order-1" %}
{% endif %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% if section.settings.video_reviews != blank %}
  {% assign has_metaobjects = true %}
  {% assign entries = section.settings.video_reviews %}
{% else %}
  {% assign has_metaobjects = false %}
  {% assign entries = section.blocks | where: "type", "entry" %}
{% endif %}
{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="video-reviews carousel__slides"
    data-stagger-inview=".video-reviews__entry">
    {% for entry in entries %}
      {% if has_metaobjects %}
        {% assign video = entry.video.value %}
        {% assign image = entry.image.value %}
        {% assign label = entry.label %}
        {% assign stars = entry.stars.value | split: "." | first | times: 1 %}
        {% assign review = entry.review %}
        {% assign name = entry.name %}
        {% assign entry_id = entry.name | replace: "-", " " | replace: "_", " " | camelcase %}
      {% else %}
        {% assign video = entry.settings.video %}
        {% assign image = entry.settings.image %}
        {% assign label = entry.settings.label %}
        {% assign stars = entry.settings.stars %}
        {% assign review = entry.settings.review %}
        {% assign name = entry.settings.name %}
        {% assign entry_id = entry.id %}
      {% endif %}
      <div class="video-reviews__entry carousel__item">
        <div class="video-reviews__entry-inner">
          <div class="video-reviews__media">
            <div class="video-reviews__media-inner">
              {% if video != blank %}
                {% if video.media_type == 'image' %}
                  {% assign default_alt = "maybe an image about the review about " | append: entry.label %}
                  {% assign alt = video.alt | default: default_alt %}
                  {% render 'component__lazyload-image',
                    image: video,
                    width: 420,
                    alt: alt %}
                {% else %}
                  {% assign video_ref = "video" | append: "-" | append: entry_id | replace: "_", "-" | replace: "-", "" %}
                  {% render 'component__video',
                    video: video,
                    poster_image: image,
                    poster_size: 420,
                    autoplay: false,
                    loop: true,
                    controls: false,
                    playsinline: true,
                    muted: false,
                    video_ref: video_ref %}
                    <button class="play-button"
                      x-data="{
                        paused: $refs.{{- video_ref -}}.paused
                      }"
                      x-init='
                        $refs.{{- video_ref -}}.onpause = () => {
                          paused = $refs.{{- video_ref -}}.paused;
                        };
                        $refs.{{- video_ref -}}.onplay = () => {
                          paused = $refs.{{- video_ref -}}.paused;
                        };
                      '
                      x-transition:enter-start="opacity-0"
                      x-transition:enter-end="opacity-1"
                      x-transition:leave-start="opacity-1"
                      x-transition:leave-end="opacity-0"
                      x-show="paused"
                      x-cloak>
                      <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="52" height="52">
