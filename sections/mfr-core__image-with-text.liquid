{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__image-with-text.css" %}
{% unless template == 'collection' and collection.metafields.mfr_fields.collection_columns == blank %}

{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign max_width_style = "" -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign image_offset = section.settings.image_offset -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% if section.settings.add_overlap %}
  {% assign add_overlap = "overlap" %}
 {% else %} 
  {% assign add_overlap = "" %}
{% endif %}

{% if section.settings.image_column_size == "one-third" %}
  {% assign media_col = "large-4" %}
  {% assign content_col = "large-8" %}
{% elsif section.settings.image_column_size == "half" %}
  {% assign media_col = "large-6" %}
  {% assign content_col = "large-6" %}
{% elsif section.settings.image_column_size == "two-thirds" %}
  {% assign media_col = "large-8" %}
  {% assign content_col = "large-4" %}
{% endif %}

{% if section.settings.hide_image_on_mobile != blank %}
  {% assign hide_on_mobile_class = "show-for-large" %}
{% endif %}

{% assign border = "" %}
{% if section.settings.enable_border %}
  {% assign border = "border" %}
{% endif %}

{%- assign buttons = section.blocks | where: "type", "button" -%}
{%- assign featured_product_button = section.blocks | where: "type", "featured_product_button" -%}
{%- assign popup_button = section.blocks | where: "type", "popup_button" -%}
{%- assign icons = section.blocks | where: "type", "icon" -%}
{%- assign first_icon = icons | first -%}
{%- assign list_items = section.blocks | where: "type", "list_item" -%}
{%- assign first_list_item = list_items | first -%}
{%- assign accordions = section.blocks | where: "type", "accordion" -%}
{%- assign first_accordion = accordions | first -%}
{% assign icon_texts = section.blocks | where: "type", "icon_text" %}
{% assign first_icon_text = icon_texts | first %}
{% assign accent_lotties = section.blocks | where: "type", "accent_lottie" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

<section class="mfr-core__image-with-text image-text section background {{ color_theme }} {{ custom_class }}" id="{{ section_id }}" 
  data-desktop-layout="{{ section.settings.text_side_desktop }}" 
  data-mobile-layout="{{ section.settings.text_side_mobile }}">
  {%- render "component__gradient-bg-styles" -%}
  {%- render 'component__section-dividers', is_video_background: false -%}

  <div class="section-spacer {{ grid_gutter }}" style="{{ spacer }}">
    {%- for block in section.blocks -%}
      {% if block.type == "large_heading" %}
        <div class="section-heading-wrap">
          {{ block.setting.bold_color }}
          <div class="section-heading section-content" {{ max_width_style }}>
            {% render "renderer__block-title", block: block %}
          </div>
        </div>
      {% endif %}
    {% endfor %}  

    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center {{ border }}" style="--vertical-alignment: {{ section.settings.vertical_alignment }};">

        {% unless template contains 'product' and section.settings.video == blank and section.settings.image == blank %}
          {%- comment -%}only show this secion on PDP if an image is present. will show placehodler image on other pages if no image is present {%- endcomment -%}
          <div class="image-text__image cell small-12 {{ media_col }} {{ add_overlap }} section-media {{ hide_on_mobile_class }}" id="image-text-wrapper--{{ section.id }}" data-inview >
            <div class="image-text__image-wrapper {{ image_offset }}">
              {% if section.settings.video.aspect_ratio != blank and section.settings.video.aspect_ratio < 1 %}
                {% assign video_max_width = 438 %}
                {% assign is_video_portrait = "is-video-portrait" %}
              {% else %}
                {% assign video_max_width = 510 %}
                {% assign is_video_portrait = "" %}
              {% endif %}

              {% if section.settings.image == "png" or section.settings.image_mobile == "png" %}
                  {% assign image_parallax = "data-image-parallax" %}
              {% else %}
                  {% assign image_parallax = "" %}
              {% endif %}

              <div class="notepad" data-inview>
                <div class="notepad__header">
                  {% for i in (1..40) %}
                    <span></span>
                  {% endfor %}
                </div>
                <div class="notepad__body">
        
                </div>
              </div>
              
              <div class="image-text__image-accents-wrapper">
                {% if accent_lotties != blank %}
                  {% for lottie in accent_lotties %}
                    {% if lottie.settings.file_url != blank %}
                      <div class="image-text__image-accent" 
                        data-index="{{ forloop.index0 }}"
                        data-inview>
                        <lottie-player src="{{ lottie.settings.file_url }}"  
                          background="transparent"  
                          speed="0.5"
                          loop
                          autoplay>
                        </lottie-player>
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              
                <div class="image-text__image-inner {{ is_video_portrait }} {{ section.settings.image_rounding }}" 
                  {{ image_parallax }}
                  style="
                    {% if section.settings.media_max_width_mobile > 0 %}
                      --mobile-max-width: {{ section.settings.media_max_width_mobile }}rem;
                    {% endif %}
                    {% if section.settings.media_max_width > 0 %}
                      --desktop-max-width: {{ section.settings.media_max_width }}rem;
                    {% endif %}
                  ">
                  
                  {% if section.settings.video != blank %}
                    {% render "component__hosted-video", 
                      media: section.settings.video,
                      autoplay: true,
                      muted: true,
                      controls: true,
                      play_on_view: false,
                      width: video_max_width %}
                  {% elsif  section.settings.image != blank %}
                    {% render 'component__responsive-image',
                      mobile_image: section.settings.image_mobile,
                      desktop_image: section.settings.image,
                      alt: section.settings.image.alt,
                      max_width: 1080,
                      loading_lazy: section.settings.lazyload_image %}
                  {% else %}
                    {% unless template contains 'product' %}
                      <div class="shopify-placeholder-image">
                        {%- capture svg_code -%}{{- 'image' | placeholder_svg_tag -}}{%- endcapture -%}
                        {% render 'component__svg-encoder', svg_code: svg_code, alt: "placeholder image" %}
                      </div>
                    {% endunless %}
                
                  {% endif %}
                </div>
              </div>

              {% if section.settings.media_caption != blank %}
                <p class="small caption">{{ section.settings.media_caption }}</p>
              {% endif %}
            </div>
          </div>
        {% endunless %}

        <div class="image-text__text imgtxt-text cell small-12 {{ content_col }} section-content {{ add_overlap }} {%- if section.settings.text_alignment == "text-center" %} text-center align-center {% endif -%}"
          {% if section.settings.static_image %}data-mfr-sticky-container{% endif %}>
          <div class="imgtxt-text__wrapper"
            {% if section.settings.static_image %}data-mfr-sticky{% endif %}>

            {%- for block in section.blocks -%}
              {% case block.type %}
                
                {%- when "icon" -%}
                  {% render "renderer__block-icon", block: block %}
                {% when 'icon_text' %}
                  {% if block == first_icon_text %}
                    {% render 'component__icon-text', icon_texts: icon_texts, columns: 0 %}
                  {% endif %}              
                {%- when "small_text" -%}
                  {% render "renderer__block-small-text", block: block %}
                
                {%- when 'heading' -%}
                  {% render "renderer__block-title", block: block %} 

                {%- when "text" -%}
                  {% render "renderer__block-text", block: block %}

              {%- endcase -%} 
            {%- endfor -%}

            {% if buttons != blank or featured_product_button != blank or popup_button != blank %}
              <div class="button-set {{ content_alignment }}">
                {%- for block in section.blocks -%}
                  {% case block.type %}
                    
                    {%- when 'button' -%}
                      {% render 'renderer__block-button', block: block %} 

                  {%- endcase -%}
                {%- endfor -%}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
  {% render "component__accent-graphics" %}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% endunless %}

{% schema %}
{
  "name": "Image / Text",
  "disabled_on": {
    "groups": ["header","footer","custom.offcanvas","custom.modals"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },  
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image Mobile"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image Desktop"
    },
    {
      "type": "checkbox",
      "id": "lazyload_image",
      "label": "Lazyload Image?",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "A Shopify-hosted video",
      "info": "will show instead of image"
    },
    {
      "type": "checkbox",
      "id": "static_image",
      "label": "Make Image Sticky",
      "default": false,
      "info": "will stay fixed until text scrolls fully"
    },
    {
      "type": "text",
      "id": "media_caption",
      "label": "Media Caption"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "select",
      "id": "image_rounding",
      "options": [
        { "value": "rounded", "label": "Rounded" },
        { "value": "", "label": "Normal" }
      ],
      "label": "Image Corners",
      "default": "",
      "info": "for JPGS this will contain the image and round corners"
    },
    {
      "type": "select",
      "id": "image_offset",
      "options": [
      { "value": "", "label": "Normal" },
        { "value": "offset-image", "label": "Offset" }
      ],
      "label": "Image Offset",
      "default": "",
      "info": "will adjust the image to overlap the section background for an asymmetrical look"
    },
    {
      "type": "range",
      "id": "media_max_width_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Media Max Width (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "media_max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Media Max Width (Desktop)",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_image_on_mobile",
      "label": "Hide Image on Mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_side_desktop",
      "options": [
        { "value": "text-left", "label": "Text Left" },
        { "value": "text-right", "label": "Text Right" }
      ],
      "label": "Desktop Layout",
      "default": "text-left"
    },
    {
      "type": "select",
      "id": "text_side_mobile",
      "options": [
        { "value": "text-top", "label": "Text Top" },
        { "value": "text-bottom", "label": "Text Bottom" }
      ],
      "label": "Mobile Layout",
      "default": "text-bottom"
    },
    {
      "type": "checkbox",
      "id": "add_overlap",
      "label": "Make Text Overlap Image",
      "default": false,
      "info": "text will overlap image and get white background box"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "image_column_size",
      "label": "Image Column Size",
      "options": [
        {
          "value": "one-third",
          "label": "1/3"
        },
        {
          "value": "half",
          "label": "1/2"
        },
        {
          "value": "two-thirds",
          "label": "2/3"
        }
      ],
      "default": "half"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "Enable section border",
      "info": "Add a border around the section"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
    {
      "type": "header",
      "content": "Color Schemes Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color Scheme",
      "info": "This will be the color scheme of the header initially."
    },

    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },
    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],

  "blocks": [
  {
    "type": "icon", 
    "name": "Icon",
    "limit": 4,
    "settings": [
      {
        "type": "image_picker",
        "id": "icon",
        "label": "Icon"
      },
      {
        "type": "text",
        "id": "file_lottie_url",
        "label": "File Lottie URL"
      },
      {
        "type": "number",
        "id": "icon_width",
        "label": "Image width",
        "default": 150,
        "info": "in pixels."
      }
    ]
  },
    {
      "type": "icon_text",
      "name": "Icon Text",
      "limit": 5,
      "settings": [
        {
          "type": "header",
          "content": "Icon Settings"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },

        {
          "type": "header",
          "content": "Text Settings"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type":"small_text",
      "name":"Accent Text",
      "limit":2,
      "settings":[
        {
          "type":"text",
          "id":"text",
          "default":"Accent Text",
          "label":"Text"
        },
        {
          "type": "color",
          "id": "small_text_color",
          "label": "Color"
        }
      ]
    },
  
    {
      "type": "large_heading",
      "name": "Large Heading",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "default": "<p>Heading Text</p>",
          "label": "Heading Text",
          "info": "this heading appears at the top of the section"
        },
        {
          "type": "select",
          "id": "header_style",
          "options": [
              { "value": "h1", "label": "H1"},
              { "value": "h2", "label": "H2"},
              { "value": "h3", "label": "H3"},
              { "value": "h4", "label": "H4"},
              { "value": "h5", "label": "H5"},
              { "value": "h6", "label": "H6"}
              ],
          "label": "Header Style",
          "default": "h1"
        },

        {
          "type": "header",
          "content": "Bold Settings",
          "info": "Adding bold color or bold underline color will remove the boldness of the text"
        },
        {
          "type": "color",
          "id": "highlighted_color",
          "label": "Highlight Color"
        },
        {
          "type": "color",
          "id": "underline_color",
          "label": "Underline Color",
          "info": "Use [underline][/underline] to underline text(s)"
        },

        {
          "type": "header",
          "content": "Width Settings"
        },
        {
          "type": "range",
          "id": "max_width",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "rem",
          "label": "Max Width",
          "default": 80
        }
      ]
    },

    {
      "type": "heading",
      "name": "Heading",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading H1",
          "label": "Heading H1"
        },
        {
          "type": "select",
          "id": "header_style",
          "options": [
              { "value": "h1", "label": "H1"},
              { "value": "h2", "label": "H2"},
              { "value": "h3", "label": "H3"},
              { "value": "h4", "label": "H4"},
              { "value": "h5", "label": "H5"},
              { "value": "h6", "label": "H6"}
              ],
          "label": "Header Style",
          "default": "h1"
        },

        {
          "type": "header",
          "content": "Accent Settings"
        },
        {
          "type": "select",
          "id": "make_xl",
          "options": [
              { "value": "", "label": "Normal"},
              { "value": "xl-title", "label": "Oversize"}
              ],
          "label": "H1 Size",
          "default": "",
          "info": "H1s can be set to oversize if they need to be extra big"
        },
        {
          "type": "checkbox",
          "id": "with_line",
          "label": "With Line",
          "default": false
        },
        {
            "type": "color",
            "id": "highlight_color",
            "label": "Highlight Color",
            "info": "Use [highlight][/highlight] to highlight text"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
            "info": "Use [underline][/underline] to underline text"
        },

        {
          "type": "header",
          "content": "Width Settings"
        },
        {
            "type": "range",
            "id": "max_width",
            "min": 0,
            "max": 60,
            "step": 1,
            "unit": "rem",
            "label": "Max Width",
            "default": 0
        }
      ]
    },
    
    {
      "type": "text",
      "name": "Text",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum vel metus auctor.</p>",
          "label": "Text"
        },
        {
          "type":"select",
          "id":"text_style",
          "options":[
            { "value": "", "label":"Default"},
            { "value":"xsmall", "label":"xSmall" },
            { "value":"small", "label":"Small" },
            { "value":"medium", "label":"Medium" },
            { "value":"large", "label":"Large" },
            { "value":"xlarge", "label":"xLarge" }
          ],
          "label":"Text Style",
          "default":""
        },
        {
          "type": "select",
          "id": "font_family",
          "options": [
            { "value": "", "label": "Use system settings" },
            { "value": "custom-font-name-1", "label": "Custom Font Name 1" },
            { "value": "custom-font-name-2", "label": "Custom Font Name 2" },
            { "value": "custom-font-name-3", "label": "Custom Font Name 3" },
            { "value": "custom-font-name-4", "label": "Custom Font Name 4" }
          ],
          "label": "Font Family",
          "default": "",
          "info": "Custom font names can be via Theme Settings > Custom Fonts"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text Color",
          "info": "Leave it blank to use system settings."
        },
        {
          "type": "color",
          "id": "bold_color",
          "label": "Bold Color",
          "info": "Adding bold color will make the bolded text colored instead of being bold."
        },
      {
          "type": "color",
          "id": "underline_color",
          "label": "Underline Color",
          "info": "Use [underline][/underline] to underline text(s)"
      },

