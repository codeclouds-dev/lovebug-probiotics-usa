{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-rebuy__recommendation-carousel.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{%- capture badge_svg -%}
  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="74" height="74">
    <path fill="#2B3990" d="M33.629955 67.456078L30.672626 68.829697C27.175043 70.454247 23.022377 68.942802 21.387314 65.450119L20.004812 62.496933C19.005775 60.362869 17.116732 58.777771 14.841607 58.164486L11.693217 57.315804C7.9696689 56.31208 5.7600813 52.484962 6.7526054 48.758415L7.5918193 45.607487C8.1982613 43.330528 7.77005 40.902023 6.4214158 38.969799L4.5551319 36.295921C2.3479095 33.133575 3.1152914 28.781538 6.2709885 26.564817L8.9392405 24.690504C10.867402 23.336067 12.100388 21.200474 12.309284 18.853416L12.598361 15.605487C12.940248 11.764213 16.325533 8.9236212 20.167818 9.2539587L23.416603 9.5332699C25.764275 9.7351093 28.081532 8.8916979 29.750214 7.228025L32.059387 4.9257808C34.790413 2.202955 39.209587 2.202955 41.940613 4.9257808L44.249786 7.228025C45.918468 8.8916979 48.235725 9.7351093 50.583397 9.5332699L53.832184 9.2539587C57.674465 8.9236212 61.059753 11.764213 61.401638 15.605487L61.690716 18.853416C61.899612 21.200474 63.132599 23.336067 65.06076 24.690504L67.729012 26.564817C70.884712 28.781538 71.652092 33.133575 69.44487 36.295921L67.578583 38.969799C66.22995 40.902023 65.801735 43.330528 66.40818 45.607487L67.247391 48.758415C68.239922 52.484962 66.030334 56.31208 62.306782 57.315804L59.158394 58.164486C56.88327 58.777771 54.994225 60.362869 53.995186 62.496933L52.612686 65.450119C50.977623 68.942802 46.824955 70.454247 43.327374 68.829697L40.370045 67.456078C38.232986 66.463463 35.767014 66.463463 33.629955 67.456078Z" fill-rule="evenodd"/>
  </svg>
{%- endcapture -%}

{% comment %}
  You Might Like These As Well!
 
{% endcomment %}
{% capture custom_section_content %}
  <div class="rebuy-recommendations carousel__slides"
    x-data='{
      getTag(tags) {
        if( tags.includes("best-seller") ) {
          return "Best Seller";
        } else if( tags.includes("new") ) {
          return "New";
        } else if( tags.includes("coming-soon") ) {
          return "Coming Soon";
        } else if( tags.includes("limited-edition") ) {
          return "Limited Edition";
        } else if( tags.includes("trending") ) {
          return "Trending";
        } else if( tags.includes("final-sale") ) {
          return "Final Sale";
        } else {
          return false;
        }
      }
    }'>
    <template x-for='(product, index) in products'>
      <div class="rebuy-recommendations__entry carousel__item"
        data-inview
        x-data='{
          tag: getTag(product.tags)
        }'>
        <div :id='"product-card--" + product.id'
          x-data='{
            metafields: product.metafields.reduce((acc, item) => {
              acc[item.key] = item.value;
              return acc;
            }, {})
          }'
          class="product-card"
          :style='`--product-card-color:${metafields.product_card_accent_color};`'>
          <div class="product-badge"
            x-cloak
            x-show='tag'>
            {% render 'component__svg-encoder',
              svg_code: badge_svg,
              width: 74,
              alt: "badge icon" %}
            <span x-text='tag'></span>
          </div>
  
          <div class="product-card__media">
            <a :href='product.link' class="product-card__images no-hover"
              :title='`Images for ${product.title}`'
              :aria-label='`Images for ${product.title}`'>
              <div class="product-card__main-image">
                <img 
                  x-data='{
                    image: getProductImage(product.id).mainProductImage
                  }'
                  :src='image.src' 
                  width="420"
                  height="420"
                  :height='image.width ? `${420 * (image.height / image.width)}px` : ""'
                  :alt='image.alt'
                  loading="lazy">
              </div>
              <template x-if='metafields.product_card_secondary_image'>
                <div class="product-card__secondary-image"
                  x-show='metafields.product_card_secondary_image'>
                  <img 
                    x-data='{
                      image: getProductImage(product.id).secondaryProductImage
                    }'
                    :src='image.src' 
                    width="420"
                    height="420"
                    :height='image.width ? `${420 * (image.height / image.width)}px` : ""'
                    :alt='image.alt'
                    loading="lazy">
                </div>
              </template>
              <span class="product-card__subscription-message"
                x-data='{
                  isDark(element) {
                    const bgColor = metafields.product_card_accent_color ?? "#E50695";
                    const colorInstance = tinycolor(bgColor);
                    const darkThreshold = 0.5;
                    const luminance = colorInstance.getLuminance();
                    
                    return luminance < darkThreshold;
                  }
                }'
                x-init='
                  $el.style.color = isDark($el) ? "#fff" : "#2B3990";
                '>
                Subscribe & Save 10%
                {% capture arrow_svg %}
                  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="20" height="20">
