                    <path fill="none" stroke="#2B3990" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(8.33333 5.83333)" d="M0 0L4.1666665 4.1666665L0 8.333333" fill-rule="evenodd"/>
                  </svg>
                {% endcapture %}
                {% render 'component__svg-encoder',
                  svg_code: arrow_svg,
                  width: 20,
                  alt: "right chevron icon" %}
              </span>
            </a>
            <div class="product-card__media-actions">
              <span class="product-card__sup-title"
                x-data='{
                  isDark(element) {
                    const bgColor = metafields.product_card_accent_color ?? "#E50695";
                    const colorInstance = tinycolor(bgColor);
                    const darkThreshold = 0.5;
                    const luminance = colorInstance.getLuminance();
                    
                    return luminance < darkThreshold;
                  }
                }'
                x-init='
                  $el.style.color = isDark($el) ? "#fff" : "#2B3990";
                '
                x-show='metafields.product_card_sup_title'
                x-cloak
                x-title='metafields.product_card_sup_title'>
              </span>
              <form data-cart-submit :data-product-id='product.id' :id='`product-form-${ product.id }`'>
                <input type="hidden" name="id" :data-productid='product.id' 
                  :value='product.variants[0].id'>
                <input type="hidden" name="properties[_bg_color]" 
                  :value='metafields.product_card_accent_color ?? "#E50695"'>
                <input type="hidden" name="properties[_variant_nice_title]" 
                  :value='metafields.variant_nice_title'>
                <input type="hidden" name="properties[_accent_color]" 
                  :value='metafields.product_card_accent_color ?? "#E50695"'>
              
                <button class="button add-to-cart "
                  x-data
                  x-on:click='$store["offCanvasCart"].openOffcanvas()'>
                  <div class="button-text">
                    Add
                  </div>
                </button>
              </form>
            </div>
          </div>
        
          <div class="product-card__info">
            <div class="product-card__info-inner">
              <div data-oke-star-rating :data-oke-reviews-product-id='`shopify-${ product.id }`'>
                  <!-- 
                  Retrieve the product.metafields.okendo.StarRatingSnippet via Shopify's GraphQL/REST API
                  and put the contents here
                  -->
              </div>
              <div class="product-card__info-title"
                x-text='metafields.product_card_nice_title ?? product.title'>
              </div>
              <span class="product-card__info-sub-title"
                x-show='metafields.product_card_sub_title'
                x-cloak
                x-text='metafields.product_card_sub_title'>
              </span>
            </div>
            <span class="product-card__info-price"
              x-text='Shopify.formatMoney(product.variants[0].price)'>
            </span>
          </div>
        </div>
      </div>
    </template>
  </div>
{% endcapture %}

<section class="mfr-rebuy__recommendation-carousel {{ custom_class }} " id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
        <div class="cell small-12 large-12 carousel"
          x-data='{
            products: [],
            getProductImage(id) {
              return {
                {% for product in section.settings.products %}
                  "{{ product.id }}": {
                    {%- assign metafields = product.metafields.mfr_fields -%}
                    {%- assign default_alt = "main product image for " | append: product.title -%}
                    {%- assign alt = metafields.product_card_main_image.alt | default: default_alt -%}
                    {%- assign main_image = metafields.product_card_main_image | default: product.featured_image -%}
                    "mainProductImage": {
                      "src": "{{ main_image | image_url: width: 420 }}",
                      "height": "{{ main_image.height }}",
                      "width": "{{ main_image.width }}",
                      "alt": "{{ alt | escape }}"
                    },
                    {%- assign default_alt = "secondary product image for " | append: product.title -%}
                    {%- assign alt = metafields.product_card_secondary_image.alt | default: default_alt -%}
                    {%- assign secondary_image = metafields.product_card_secondary_image -%}
                    {%- if metafields.product_card_secondary_image != blank -%}
                      "secondaryProductImage": {
                        "src": "{{ secondary_image | image_url: width: 420 }}",
                        "height": "{{ secondary_image.height }}",
                        "width": "{{ secondary_image.width }}",
                        "alt": "{{ alt | escape }}"
                      }
                    {%- endif -%}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              }[id] ?? false;
            }
          }'
          x-init='
            const requestParameters = new URLSearchParams({
                format: "pretty",
                key: "{{ section.settings.api_key }}",
                metafields: "yes",
                country_code: "US",
                presentment_prices: "yes"
            });

            fetch(`https://rebuyengine.com/api/v1/custom/id/{{ section.settings.endpoint_id }}/?${requestParameters}`)
              .then(response => response.json())
              .then(data => {
                products = data.data;

                $nextTick(() => { 
                  const flkty = new Carousel(0, $el, {
                    wrapAround: false,
                    contain: true,
                    prevNextButtons: true,
                    adaptiveHeight: false,
                    pageDots: true,
                    cellAlign: "center",
                    groupCells: true,
                    draggable: true
                  })
                });
              });
          '>
          {{ custom_section_content }}
        </div>
      </div>
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
  {% render 'script__section', file: "mfr-carousel.js" %}
</section>


{% schema %}
{
  "name":"Rebuy: Recommendations",
  "disabled_on": {
    "groups": [
      "header", "footer", "custom.offcanvas","custom.modals"
    ]
  },
  "settings":[
    {
      "type": "text",
      "id": "api_key",
      "label": "API Key",
      "default": "4ea1258d24112df157c6efaf15abef7cc0410894"
    },
    {
      "type": "text",
      "id": "endpoint_id",
      "label": "Endpoint ID",
      "default": "206821"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "This is going to be the source of metafield images for the product cards. Insert all possible products that will appear from Rebuy custom endpoint."
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },

    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
