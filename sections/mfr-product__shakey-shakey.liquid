          <div class="cell small-12 large-4 shakey-shakey__nutrition-facts"
            data-inview>
            <div class="shakey-shakey__nutrition-facts-card">
                {% if metafields.shakey_shakey_nutrition_facts_title != blank %}
                  {% assign title = metafields.shakey_shakey_nutrition_facts_title %}
                {% else %}
                  {% assign title = "Lorem ipsum dolor sit amet" %}
               {% endif %}
               {% if metafields.shakey_shakey_nutrition_facts_title != blank %}
                 {% assign list = metafields.shakey_shakey_nutrition_facts_list.value %}
               {% else %}
                 {% assign list = "Lorem ipsum--0g,Lorem ipsum--0g,Lorem ipsum--0g,Lorem ipsum--0g" | split: "," %}
              {% endif %}

              {% if title != blank %}
                <h5 class="h5 shakey-shakey__nutrition-facts-card-title">
                  {{ title }}
                </h5>
              {% endif %}
              {% if list != blank %}
                <ul class="shakey-shakey__nutrition-facts-card-list">
                  {% for item in list %}
                    <li>
                      {% assign texts = item | split: "--" %}
                      {% for text in texts %}
                        <span>{{text }}</span>
                      {% endfor %}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
              {% render 'renderer__block-button', block: nutrition_facts %}
            </div>
          </div>
        </div>
      </div>
    </div>
    
    {%- render 'component__gradient-bg-styles' -%}
    {%- render 'component__accent-graphics' -%}
    {%- render 'component__section-dividers', is_video_background: true -%}
    
  </section>
{% endif %}

