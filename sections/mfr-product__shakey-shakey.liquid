                  </svg>
                {%- endcapture -%}
                {% render 'component__svg-encoder',
                  svg_code: shadow_svg_code,
                  alt: "shadow" %}
              </span>
              <span class="shakey-shakey__image-arrow"
                data-inview>
                {%- capture arrow_desktop -%}
