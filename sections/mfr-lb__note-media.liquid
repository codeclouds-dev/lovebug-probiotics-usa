{% schema %}
{
  "name":"LB: Note/Media Section",
  "disabled_on": {
    "groups": [
      "header", "footer", "custom.offcanvas","custom.modals"
    ]
  },
  "settings":[
    {
      "type": "color",
      "id": "note_background",
      "label": "Note Background",
      "default": "#FFE9E2"
    },
    {
      "type": "checkbox",
      "id": "alternate_layout",
      "label": "Alternate Layout",
      "default": false
    },
    {
