      geekMode: false
    }"
  {% endif %}>
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}
      x-data="{ isSmallScreen: window.outerWidth <= 1023 }" >
      <template 
        x-init="
          window.addEventListener('resize', () => {
            isSmallScreen = window.outerWidth <= 1023;
          });
        "
        x-if="!isSmallScreen">
        <div class="note-media-section__chalkboard--desktop"
          x-effect='
            if (!isSmallScreen) {
              const element = document.querySelector("#{{ section_id }} .note-media-section__chalkboard--desktop");

              const loadLottieAnimation = () => {
                if (typeof lottie !== "undefined") {
                  lottie.loadAnimation({
                    container: document.querySelector("#{{ section_id }} .note-media-section__chalkboard--desktop lottie-player-desktop"),
                    renderer: "svg",
                    loop: false,
                    autoplay: true,
                    path: "{{ 'chalkboard--desktop.json' | asset_url }}",
                    rendererSettings: {
                      preserveAspectRatio: "xMidYMid slice",
                    },
                  });
                } else {
                  requestAnimationFrame(loadLottieAnimation);
                }
              };

              if (element) {
                const observer = new IntersectionObserver((entries, observer) => {
                  entries.forEach(entry => {
                    if (entry.isIntersecting) {
                      loadLottieAnimation();
                      observer.unobserve(entry.target); // Stop observing after triggering
                    }
                  });
                }, {
                  root: null, // Uses viewport as the root
                  threshold: 0.1 // Trigger when 10% of the element is in view
                });

                observer.observe(element);
              }
            }
          '>
          <lottie-player-desktop src="{{ 'chalkboard--desktop.json' | asset_url }}"  
            background="transparent"  
            speed="1"
            autoplay>
