      "label": "Image"
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
