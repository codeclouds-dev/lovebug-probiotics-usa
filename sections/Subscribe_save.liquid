<section class="subscrib-save-sec">
    <div class="grid-container">
       <i>{{ section.settings.img1  | image_url: width: 200 | image_tag }}</i>
        <!-- section title goes here -->

        {%- for block in section.blocks -%}
            {% case block.type %}

            

              {%- when 'heading' -%}
                {% render 'renderer__block-title', block: block %}    
                {%- endcase -%}
            
        {%- endfor -%}
        
        {{ section.settings.text }}

         <div class="subscrib-row">
               {%- for block in section.blocks -%}
            {% case block.type %}

            {%- when 'image' -%} 
            <div class="subscrib-card">
                 {% if block.settings.img  %}
                <i>{{ block.settings.img  | image_url: width: 200 | image_tag }}</i>
               {% endif %}
               <span>{{ block.settings.below_text }} </span>
            </div>
             {%- endcase -%}
            
          {%- endfor -%}
         </div>
         
        

         <form method="post" action="/cart/add">
          <input name="selling_plan" type="hidden" value="2278228166">
  <input type="hidden" name="id" data-productid="8714146218182" value="45253216600262">

   <button class="addtocart_notice button {{ button_class }} {{ has_price_class }} add-to-cart " {% unless product.available -%} disabled {%- endunless %} {{ open_off_canvas }}>
    <div class="button-text">
      {% if product.available %}
        {% if button_label != blank %}
          {{ button_label }}
        {% else %}
          ADD TO CART & SAVE NOW →
        {% endif %}
      {% else %} 
        {{ 'products.product.sold_out' | t }}
      {% endif %}
    </div>
    
    {%- if product.available -%}
      {%- if show_price == true or show_price == "true" -%}
        {% if for_subscription %}
          <span class="price">{{ first_selling_plan.price | money }}</span>
          <span class="price old">{{ first_selling_plan.compare_at_price | money }}</span>
        {% else %}
          {%- render 'price', product: product -%}
        {% endif %}
      {%- endif -%}
    {%- endif -%}
  </button>
</form>
    </div>
</section>

{% schema %}
{
  "name": "Subscribe and Save",

  "settings": [
  
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
      {
      "type": "image_picker",
      "id": "img1",
      "label": "Icon Image"
    }
  ],
  "blocks": [
   
    {
      "type": "heading",
      "name": "Main Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "SUBSCRIBE & SAVE 10%"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "label": "Header Style",
          "default": "h1",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ]
        }
      ]
    },
    {
      "type": "image",
      "name": "Small Image",
      
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Tick Icon",
          
        },
        {
          "type": "richtext",
          "id": "below_text",
          "label": "Below text",
          
        },
      ]
    },
   
  ],
  "presets": [
    {
      "name": "Subscribe_save",
      "blocks": [
      
        { "type": "heading" },
        { "type": "image" },
       
      ]
    }
  ]
}
{% endschema %}