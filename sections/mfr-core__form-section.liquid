{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% if section.settings.border_bottom %}
  <style>
    #shopify-section-{{ section.id }} {
      position: relative;
      &:before {
        content: '';
        pointer-events: none;
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1.5px;
        background: linear-gradient(130deg,#795A2E,#4F391F);
        z-index: 2;
      }
    }
  </style>
{% endif %}

{% render 'style-tags__section', asset_file_name: "mfr-core__form-section.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="form-section">
    {% if section.settings.embed_form != blank %}
      {{ section.settings.embed_form }}
    {% else %}
      {% assign form_id = section.id | prepend: 'form-' %}

      {% form 'contact', id: form_id, class: 'form-section__form' %}

        {% comment %} Success message {% endcomment %}
        {% if form.posted_successfully? %}
          <p>{{ section.settings.success_message }}</p>
        {% endif %}

        {% comment %} Error messages {% endcomment %}
        {% if form.errors %}
          {% for field in form.errors %}
            <span class="errors">
              {% if field == 'form' %}
                {{ form.errors.messages[field] }}
              {% else %}
                <strong>{{ form.errors.translated_fields[field] }}</strong> {{ form.errors.messages[field] }}
              {% endif %}
            </span>
          {% endfor %}
        {% endif %}

        {% for block in section.blocks %}

          <div class="form-{{ block.type }}">

            {% case block.type %}

              {% comment %} Email and name fields {% endcomment %}
              {% when 'email' %}
              <div class="form-name">
                <label for="contactFormName" class="hide">Name</label>
                <input type="text" id="contactFormName" name="contact[name]" placeholder="Name" autocapitalize="words" required value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
              </div>

              <div class="form-email">
                <label for="contactFormEmail" class="hide">Email</label>
                <input type="email" id="contactFormEmail" name="contact[email]" placeholder="Email" autocorrect="off" autocapitalize="off" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
              </div>

              {% comment %} Dynamic fields {% endcomment %}
              {% when 'field' %}
                {% assign id = block.id | prepend: 'field' %}

                <label for="{{ id }}" class="hide">{{ block.settings.label | escape }}</label>
                {% if block.settings.type == 'input' %}
                  <input type="text"
                {% else %}
                  <textarea 
                {% endif %}
                    id="{{ id }}" name="contact[{{ block.settings.label | handleize }}]" 
                    placeholder="{{ block.settings.label | escape }}" 
                    autocorrect="off" autocapitalize="off" autocomplete="off" 
                    {% if block.settings.required -%} required {%- endif %}>
                {%- if block.settings.type == 'textarea' -%}
                  </textarea>
                {%- endif -%}

              {% comment %} Dynamic dropdown {% endcomment %}
              {% when 'dropdown' %}
                {% assign id = block.id | prepend: 'dropdown' %}
                {% assign options = block.settings.options | newline_to_br | strip_newlines | split: '<br />' %}

                <label for="{{ id }}" class="hide">{{ block.settings.label | escape }}</label>
                <div class="form__select">
                  <select id="{{ id }}" name="contact[{{ block.settings.label | handleize }}]" >
                    <option disabled selected>{{ block.settings.label | escape }}</option>
                    {% for option in options %}
                      <option value="{{ option }}">{{ option }}</option>
                    {% endfor %}
                  </select>
                  {% render 'icon-caret.liquid' %}
                </div>

              {% comment %} Button field {% endcomment %}
              {% when 'submit_button' %}
                <button type="submit" class="button primary">{{ block.settings.label | escape }}</button>

            {% endcase %}

          </div>
        {% endfor %}

      {% endform %}
    {% endif %}
  </div>
{% endcapture %}

<section class="mfr-core__form-section {{ custom_class }}" id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 {% if section.settings.form_content_layout == 'row' %}large-6{% else %}large-12{% endif %} section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                  
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                  {%- when 'button' -%}
                    <div class="button-set {{ content_alignment }}">
                      {% render 'renderer__block-button', block: block %}
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        {% endif %}

        <div class="cell small-12 {% unless icons == blank and small_texts == blank and headings == blank and texts == blank and buttons == blank %}{% if section.settings.form_content_layout == 'row' %}large-6{% else %}large-12{% endif %}{% endunless %}">
          {{ custom_section_content }}
        </div>
      </div>
    </div>
  </div>

  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}

  <script type="text/javascript">
    onReady(function() {
      $(document).ready(function() {
        setTimeout(function() {
          $('#{{ section_id }} .form-section input[type=file]').each(function() {
            $(this).on('change', function() {
              let fullFileName = $(this).val().split('\\')
              let $fileLabel = $(this).parents('.globo-form-control').find('.label-content')

              $fileLabel.text(fullFileName[fullFileName.length - 1])
            })
          })
        }, 2000)
      })
    })
  </script>
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>



