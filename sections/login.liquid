{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}
<title>Login to Your LoveBug Account | Access Probiotic Orders & Info</title>
{% if section.settings.color_theme %}
  {% assign text_color = section.settings.color_theme %}
{% else %}
  {% assign text_color = "" %}
{% endif %}

{% assign section_id = section.settings.custom_id | default: section.id %}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}
 
<section class="customer__login-page {{ section.settings.custom_class }}" id="{{ section_id }}">
  <div class="section-spacer background" style="{{ spacer }}">
    <div class="grid-container full">
      <div class="grid-x align-center grid-gutter-small">
        <div class="cell small-12 login-wrapper">
          <div class="callout primary register-success hide">
            <p>Thank you for signing up. You can now login to your account.</p>
          </div>

          <div class="account-form text-center {{ text_color }} section-content">
            <div id="login" data-toggler=".hide">
              <div class="customer__title">

                {% if section.settings.animated_hero %}
                  <div class="customer__title-animated-icon">
                    {% render 'lb__animated-login-hero' %}
                  </div>
                {% elsif section.settings.title_icon != blank %}
                  <div class="customer__title-icon">
                    {% render 'component__lazyload-image',
                      image: section.settings.title_icon,
                      width: 240,
                      alt: section.settings.title_icon.alt %}
                  </div>
                {% endif %}

                <h3 class="h3">Login</h3>

                {%- for block in section.blocks -%}
                  {% case block.type %}
                    {%- when 'callout' -%}
                      <p class="form-note__callout regular">
                        {{ block.settings.content }}
                      </p>
                  {% endcase %}
                {% endfor %}
              </div>

              <div class="customer__content">
                {%- if recover_success == true -%}
                  <h3 class="form__message" tabindex="-1" autofocus>
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 13 13">
                      <path d="M6.5 12.35C9.73087 12.35 12.35 9.73086 12.35 6.5C12.35 3.26913 9.73087 0.65 6.5 0.65C3.26913 0.65 0.65 3.26913 0.65 6.5C0.65 9.73086 3.26913 12.35 6.5 12.35Z" fill="#428445" stroke="white" stroke-width="0.7"/>
                      <path d="M5.53271 8.66357L9.25213 4.68197" stroke="white"/>
                      <path d="M4.10645 6.7688L6.13766 8.62553" stroke="white">
                    </svg>
                    {{ 'customer.recover_password.success' | t }}
                  </h3>
                {%- endif -%}

                {%- form 'customer_login', novalidate: 'novalidate' -%}
                  {%- if form.errors -%}
                   
                    {{ form.errors | default_errors }}
                  {%- endif -%}

                  <div class="field">
                    <label for="">
                      Username
                    </label>
                      <input
                        type="email"
                        name="customer[email]"
                        id="CustomerEmail"
                        autocomplete="email"
                        autocorrect="off"
                        autocapitalize="off"
                        {% if form.errors contains 'form' %}
                          aria-invalid="true"
                        {% endif %}
                        placeholder="Username"
                        x-ref='usernameField'
                        x-data='{
                          getTextWidth(text, font) {
                            let canvas = document.createElement("canvas");
                            let context = canvas.getContext("2d");
                            context.font = font || "16px Arial"; // Match input font
                            return context.measureText(text).width;
                          },
                          pupilUpdate(textBox) {
                            let textWidth = this.getTextWidth(textBox.value, window.getComputedStyle(textBox).font);

                            // Get actual input width minus padding
                            let style = window.getComputedStyle(textBox);
                            let paddingLeft = parseFloat(style.paddingLeft);
                            let paddingRight = parseFloat(style.paddingRight);
                            let usableWidth = textBox.clientWidth - paddingLeft - paddingRight;

                            // Calculate accurate percentage
                            let percentage = Math.min((textWidth / usableWidth) * 100, 100);
                            $dispatch("pupil-update", {
                              data: this.mapPercentageToRange(percentage).toFixed(2)
                            } );
                          }, 
                          mapPercentageToRange(percentage, min = -4, max = 2) {
                            return min + (percentage / 100) * (max - min);
                          }
                        }'
                        @input='
                          pupilUpdate($el);
                        '
                        @focus='
                          $dispatch("username-focus");
                          pupilUpdate($el);
                        '
                        @blur='
                          $dispatch("username-unfocus");
                        '
                      >
                  </div>

                  {%- if form.password_needed -%}
                    <div class="field">
                      <label for="">
                        {{ 'customer.login_page.password' | t }}
                      </label>
                        <input
                          type="password"
                          value=""
                          name="customer[password]"
                          id="CustomerPassword"
                          autocomplete="current-password"
                          x-data
                          @focus='
                            $dispatch("password-focus");
                          '
                          @blur='
                            $dispatch("password-unfocus");
                          '
                          {% if form.errors contains 'form' %}
                            aria-invalid="true"
                          {% endif %}
                          placeholder="{{ 'customer.login_page.password' | t }}"
                        >
                    </div>
                  {%- endif -%}

                  <div class="form-note">
                    <button class="button primary full color-accent-1">
                      <span class="text">{{ 'customer.login_page.sign_in' | t }}</span>
                    </button>

                    <div class="form-note__inquiries">
                      <div class="form-note__register">
                        <!-- <span>Not a member? </span> -->
                        <a href="{{ routes.account_register_url }}" class="create-account">
                          Sign up for an account
                        </a>  
                      </div>
                      <div class="form-note__forgot-password">
                        <a class="underline forgot-pass" href="#recover-password" data-toggle="login recover-password">
                          {{ 'customer.login_page.forgot_password' | t }}
                        </a> 
                      </div>
                    </div>
                  </div>
                {%- endform -%}
              </div>
            </div>

            <div id="recover-password" class="hide text-center" data-toggler=".hide">
              <div class="customer__title">
                <h2 class="h2" tabindex="-1">{{ 'customer.recover_password.title' | t }}</h2>
              </div> 

              <div class="customer__content">
                <p>{{ 'customer.recover_password.subtext' | t }}</p>
            
                {%- form 'recover_customer_password' -%}
                  {% assign recover_success = form.posted_successfully? %}

                  <div class="field">
                    <input type="email" value="" name="email" id="RecoverEmail" autocorrect="off" autocapitalize="off" autocomplete="email" {% if form.errors %} aria-invalid="true" aria-describedby="RecoverEmail-email-error" autofocus {% endif %} placeholder="{{ 'customer.login_page.email' | t }}">
                  </div>

                  {%- if form.errors -%}
                    <small id="RecoverEmail-email-error" class="form__message">
                      <svg aria-hidden="true" focusable="false" viewBox="0 0 13 13">
                        <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                        <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                        <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                        <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
                      </svg>
                      {{ form.errors.messages.form }}
                    </small>
                  {%- endif -%}
                  
                  <div class="button-set">
                    <button class="button primary">
                        
                        <span class="text">{{ 'customer.login_page.submit' | t }}</span>
                    </button>
                    <button type="button" class="button secondary" id="cancel-recover" data-toggle="recover-password login">
                        
                        <span class="text">{{ 'customer.login_page.cancel' | t }}</span>
                    </button>
                  </div>
                {%- endform -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}

  <script type="text/javascript">
    onReady(function(){
      const getUrlVars = () => {
        let vars = [], hash;
        let hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
        for (let i = 0; i < hashes.length; i++) {
          hash = hashes[i].split('=');
          vars.push(hash[0]);
          vars[hash[0]] = hash[1];
        }
        return vars;
      }
      var register_success = getUrlVars()['register_success'];
  
      if (register_success === 'true') {
        $('.register-success').removeClass('hide');
      }

      $( "[href='#recover-password']" ).on( "click", () => {
        if(history.pushState) {
            history.pushState(null, null, '#recover-password');
        }
        else {
            location.hash = '#recover';
        }
      } );
      $( "#cancel-recover" ).on( "click", () => {
        if(history.pushState) {
            history.pushState(null, null, '#login');
        }
        else {
            location.hash = '#login';
        }
      } );

      if( window.location.hash == "#login" || window.location.hash == "#recover-password" ) {
        setTimeout( () => {
          window.scrollTo(0, 0);
        }, 1 );
      }
    })
  </script>
</section>

{% schema %}
  {
    "name":"Login",
    "settings":[
      {
        "type": "image_picker",
        "id": "title_icon",
        "label": "Title Icon"
      },
      {
        "type": "checkbox",
        "id": "animated_hero",
        "label": "Animated Hero Icon?",
        "default": false
      },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },
    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },

    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "callout",
      "name": "Callout",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "accent_graphic", 
      "name": "Accent Graphic",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type":"html",
          "id":"svg_code",
          "label":"Graphic SVG Code",
          "info":"Paste SVG code for vector graphic"
        },
        {
          "type":"header",
          "content":"Visibility"
        },
        {
          "type": "select",
          "id": "visibility",
          "options": [
              { "value": "always", "label": "Always" },
              { "value": "desktop_only", "label": "Desktop Only" },
              { "value": "mobile_only", "label": "Mobile Only" }
              ],
          "label": "Show on..",
          "default": "always"
        },
        {
          "type":"header",
          "content":"Value Type"
        },
        {
          "type": "select",
          "id": "value_type",
          "options": [
              { "value": "px", "label": "Pixels" },
              { "value": "%", "label": "Percentage" }
              ],
          "label": "Position Value Type",
          "default": "%",
          "info": "Pixel values are multiplied by 5"
        },
        {
          "type":"header",
          "content":"Position"
        },
        {
          "type": "select",
          "id": "x_setting",
          "options": [
              { "value": "left", "label": "Left" },
              { "value": "center", "label": "Center" },
              { "value": "right", "label": "Right" }
              ],
          "label": "X Position",
          "default": "left"
        },
        {
          "type": "select",
          "id": "y_setting",
          "options": [
              { "value": "top", "label": "Top" },
              { "value": "bottom", "label": "Bottom" }
              ],
          "label": "Y Position",
          "default": "top"
        },
        { 
          "type":"header",
          "content":"Large Screen Settings"
        },
        {
          "type": "range",
          "id": "width_large",
          "min": 10,
          "max": 400,
          "step": 10,
          "unit": "px",
          "label": "Graphic Width",
          "default": 150
        },
        {
          "type": "range",
          "id": "position_x_large",
          "min": -100,
          "max": 100,
          "step": 2,
          "label": "X Position",
          "default": 10
        },
        {
          "type": "range",
          "id": "position_y_large",
          "min": -100,
          "max": 100,
          "step": 2,
          "label": "Y Position",
          "default": 10
        },
        {
          "type":"header",
          "content":"Small Screen Settings"
        },
        {
          "type": "range",
          "id": "width_small",
          "min": 10,
          "max": 400,
          "step": 10,
          "unit": "px",
          "label": "Graphic Width",
          "default": 150
        },
        {
          "type": "range",
          "id": "position_x_small",
          "min": -100,
          "max": 100,
          "step": 2,
          "label": "X Position",
          "default": 10
        },
        {
          "type": "range",
          "id": "position_y_small",
          "min": -100,
          "max": 100,
          "step": 2,
          "label": "Y Position",
          "default": 10
        },
        {
          "type":"header",
          "content":"Animation Settings"
        },
        {
          "type": "select",
          "id": "animation",
          "options": [
              { "value": "none", "label": "None" },
              { "value": "rotating", "label": "Rotate" },
              { "value": "floating", "label": "Float" },
              { "value": "spark", "label": "Spark" }
            ],
          "label": "Animation",
          "default": "none"
        },

        {
          "type":"header",
          "content":"Appearance Settings"
        },
        {
          "type": "range",
          "id": "rotate",
          "min": 0,
          "max": 360,
          "step": 36,
          "unit": "%",
          "label": "Rotate",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "flip",
          "label": "Flip Graphics?",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}