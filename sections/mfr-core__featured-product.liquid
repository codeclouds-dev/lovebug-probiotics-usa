{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% if section.settings.border_bottom %}
  <style>
    #shopify-section-{{ section.id }} {
      position: relative;
      &:before {
        content: '';
        pointer-events: none;
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1.5px;
        background: linear-gradient(130deg,#795A2E,#4F391F);
        z-index: 2;
      }
    }
  </style>
{% endif %}

{% render 'style-tags__section', asset_file_name: "mfr-core__featured-product.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% if section.settings.image_column_size == "one-third" %}
  {% assign media_col = "large-4" %}
  {% assign content_col = "large-8" %}
{% elsif section.settings.image_column_size == "half" %}
  {% assign media_col = "large-6" %}
  {% assign content_col = "large-6" %}
{% elsif section.settings.image_column_size == "two-thirds" %}
  {% assign media_col = "large-8" %}
  {% assign content_col = "large-4" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign icon_texts = section.blocks | where: "type", "icon_text" %}
{% assign first_icon_text = icon_texts | first %}
{% assign image = section.blocks | where: "type", "image" | first %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="featured-product">
    <div class="featured-product__inner">
      {% if image != blank %}
        {% render 'component__lazyload-image',
          image: image.settings.image,
          width: 1080,
          alt: image.settings.image %}
      {% else %}
        
      {% endif %}
    </div>
  </div>
{% endcapture %}

<section class="mfr-core__featured-product {{ custom_class }}" id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if images != blank %}
          <div class="cell small-12 {{ media_col }} featured-product__wrapper">
            {{ custom_section_content }}
          </div>
        {% endif %}
        
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 {{ content_col }} section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
  
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                  {%- when 'icon_text' -%}
                    {% if block.id == first_icon_text.id %}
                      <div class="featured-product__icon-texts">
                        {% for icon_text in icon_texts %}
                          <div class="featured-product__icon-text">
                            {% if icon_text.settings.icon != blank %}
                              {% render 'component__lazyload-image', image: icon_text.settings.icon, width: 30, alt: icon_text.settings.icon.alt %}
                            {% endif %}

                            <p class="large">{{ icon_text.settings.text }}</p>
                          </div>
                        {% endfor %}
                      </div>
                    {% endif %}

                  {%- when 'add_to_cart_cta' -%}
                    {% render 'component__add-to-cart-button', 
                      product: block.settings.product, 
                      show_price: block.settings.show_price, 
                      button_label: block.settings.label, 
                      button_class: block.settings.color_theme,
                      for_subscription: block.settings.for_subscription %}

                    {% if block.settings.sublabel != blank %}
                      <span class="featured-product__cta-sub-label xsmall">
                        {{ block.settings.sublabel }}
                      </span>
                    {% endif %}

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


