{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__story-style-testimonial-carousel.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign testamonials = section.blocks | where: "type", "testamonial" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="story-carousel">
    <div class="story-carousel__carousel">
      {% for block in testamonials %}
        <div class="story-carousel__image" data-image-parallax>
          {% if block.settings.image %}
            {% render 'component__lazyload-image',
              image: block.settings.image,
              width: 720,
              alt: block.settings.image.alt %}
          {% else %}
            <div class="shopify-placeholder-image">
              {%- capture svg_code -%}{{- 'image' | placeholder_svg_tag -}}{%- endcapture -%}
              {% render 'component__svg-encoder', svg_code: svg_code, alt: "placeholder image" %}_tag }}
            </div>
          {% endif %}
          {% if block.settings.title %}
            <div class="small-title">
              {{ block.settings.title }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
{% endcapture %}

<section class="mfr-core__story-style-testamonial-carousel {{ custom_class }}" id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ full_mobile }} {{ container_width }}">
      <div class="inner">
        <div class="grid-x {{ content_alignment }}">
          {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
            <div class="section-content {{ color_theme }} {{ text_alignment }}">
              <div class="inner">
                {%- for block in section.blocks -%}
                  {% case block.type %}
                   
                    {%- when 'icon' -%}
                      {% render 'renderer__block-icon', block: block %} 
                      
                    {%- when 'small_text' -%}
                      {% render "renderer__block-small-text", block: block %}
                      
                    {%- when 'heading' -%}
                      {% render "renderer__block-title", block: block %}
                      
                  {%- endcase -%}
                {%- endfor -%}
           
                {% if testamonials != blank %}
                  <div class="testamonial-carousel carousel">
                    <div class="testamonial-carousel__carousel carousel__slides">
                      {% for block in testamonials %}
                        <div class="testamonial-carousel__item carousel__item">
                          {% if block.settings.quote != blank %}
                            <p class="large">{{ block.settings.quote }}</p>
                          {% endif %}
                          {% if block.settings.name != blank %}
                            <div class="small-title" data-inview>{{ block.settings.name }}</div>
                          {% endif %}
                        </div>
                      {%- endfor -%}
                    </div>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if testamonials != blank %}
            <div class="story-carousel__wrapper">
              {{ custom_section_content }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}

  {% render 'script__section', file: "mfr-timed-carousel.js" %}
  <script>
    initializeComponent( "#{{ section_id }} .story-carousel__carousel", "MFRTimedCarousel",{
      autoplayTiming: {{ section.settings.autoplay_timing | default: "4" }},
      flickityOptions: {
        selectedAttraction: 0.1,
        friction: 0.55,
        prevNextButtons: true,
        contain: true,
        cellAlign: "center",
        asNavFor: '.testamonial-carousel__carousel',
        pageDots: true,
        wrapAround: true,
        groupCells: false,
        arrowShape: 'M101.414 27.746H5.806M29 1.414 1.414 29.004m27.588 25.078L1.414 26.497'
      }
    } );

    document.addEventListener('DOMContentLoaded', function () {

      const elem = $('#{{ section_id }} .testamonial-carousel__carousel');
      const flkty = elem.flickity( {
          // options
          cellAlign: 'left',
          contain: true,
          wrapAround: true,
          autoPlay: false,
          pageDots: false,
          prevNextButtons: true,
          arrowShape: 'M101.414 27.746H5.806M29 1.414 1.414 29.004m27.588 25.078L1.414 26.497',
          on: {
            ready: (e) => {
              const sourceSlider = $( "#{{ section_id }} .story-carousel__carousel" );
              sourceSlider.on( "change.flickity", (event, index) => {
                flkty.flickity( "selectCell", index );
              } );

              // move nav buttons
              const nav = $( `<div class="testamonial-carousel__nav show-for-large"></div>` );
              elem.after( nav );
              elem.find( ".flickity-button" ).appendTo( nav );
            }
          }
      });
      setTimeout( () => {
        flkty.flickity( "resize" );
      }, 100 );      
      setTimeout( () => {
        flkty.flickity( "resize" );
      }, 1000 );

      const stories = $( "#{{ section_id }} .story-carousel__carousel" );
      const storiesWrapper = stories.closest( ".story-carousel" );
      stories.on( "ready.flickity", () => {
        storiesWrapper.siblings( ".story-carousel__nav" ).remove();
        // move nav buttons
        const nav = $( `<div class="story-carousel__nav hide-for-large"></div>` );
        storiesWrapper.after( nav );
        stories.find( ".flickity-button" ).appendTo( nav );
      } );
    });
  </script>
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


