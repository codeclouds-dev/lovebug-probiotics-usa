{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__logo-bar.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}

{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}
{% assign logos = section.blocks | where: "type", "logo" %}

{% if section.settings.is_compact %}
  {% assign compact_class = "mfr-core__logo-bar--compact" %}
{% endif %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

<section class="mfr-core__logo-bar {% if section.settings.is_compact %}background{% endif %} {{ compact_class }} {{ section.settings.custom_class }} carousel section {% if section.settings.scrolling_text %}mfr-core__scrolling-text{% endif %}" id="{{ section_id }}">
  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {% if section.settings.is_compact %}full{% else %}bigger-gutter{% endif %} {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center text-center {% unless section.settings.is_compact %}background{% endunless %} section-spacer__inner">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank or buttons != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
              
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}

              {% if buttons != blank %}
                <div class="cell small-12 large-12">
                  <div class="button-set {{ content_alignment }}">
                    {%- for block in section.blocks -%}
                      {% case block.type %}
                        {%- when 'button' -%}
                          {% render 'renderer__block-button', block: block %}
                      {%- endcase -%}
                    {%- endfor -%}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if logos != blank %}
          <div class="cell small-12 logo-bar__container">
            <div class="logo-bar carousel__slides" data-stagger-inview=".logo">
              {%- for block in logos -%}
                {% if block.settings.button_link != blank %}
                  {% assign element_tag = "a" %}
                  {% assign href_attribute = "href='" | append: block.settings.button_link | append: "'" %}
                {% else %}
                  {% assign element_tag = "div" %}
                  {% assign href_attribute = "" %}
                {% endif %}
                <{{ element_tag }} {{ href_attribute }} class="logo carousel__item marquee-scroller__item">
                  {%- if block.settings.svg_code != blank or block.settings.image -%}
                    {%- if block.settings.svg_code != blank -%}
                      {% assign encoded_svg = block.settings.svg_code | replace: '<', '%3C' | replace: '>', '%3E' | replace: '#', '%23' | urlencode %}
                      {% assign encoded_svg = 'data:image/svg+xml,' | append: encoded_svg %}
                      <img src='{{ encoded_svg }}' alt="svg logos sliding from side to side">
                    {%- else -%}
                      <img 
                        src="{{ block.settings.image | img_url: "200x", scale: 2 }}" 
                        alt="{{ block.settings.title | default: block.settings.image.alt }}" 
                        class="image"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        loading="lazy">
                    {%- endif -%}
                    {% if section.settings.is_compact and block.settings.text %}
                      <span>{{ block.settings.text }}</span>
                    {% endif %}
                  {% else %}
                    {%- capture svg_code -%}{{- 'product-1' | placeholder_svg_tag -}}{%- endcapture -%}
                    {% render 'component__svg-encoder', svg_code: svg_code, alt: "placeholder image", class: "image" %}

                    <span>Lorem ipsum dolor</span>
                  {%- endif -%}
                </{{ element_tag }}>
              {%- endfor -%}
            </div>
          </div>
        {% endif %}
        
        {% render "component__gradient-bg-styles" %}
      </div>
    </div>
  </div>
  
  {% render "component__accent-graphics" %}

  {% render 'script__section', file: "mfr-carousel.js" %}
  <script>
    initializeComponent( "#{{ section_id }}", "Carousel", {
      wrapAround: true,
      contain: true,
      prevNextButtons: false,
      adaptiveHeight: false,
      pageDots: false,
      selectedAttraction: 0.1,
      friction: 0.55,
      cellAlign: "center",
      groupCells: "50%",
      autoPlay: 2000
    } );
  </script>
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


{% schema %}
