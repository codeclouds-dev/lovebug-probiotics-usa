      ]
    },
    {
      "type":"button",
      "name":"Button",
      "limit":2,
      "settings":[
        {
          "type":"text",
          "id":"button_label",
          "default":"Button label",
          "label":"Button",
          "info":"Leave the label blank to hide the button."
        },
        {
          "type":"url",
          "id":"button_link",
          "label":"Button Link"
        },
        {
          "type": "select",
          "id": "color_theme",
          "label": "Color Theme",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "tertiary",
              "label": "Tertiary"
            }
          ]
        }
      ]
    },
    {
    "type": "lottie", 
    "name": "Lottie Animation",
    "limit": 4,
    "settings": [
      {
        "type": "range",
        "id": "image_width",
        "min": 100,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "label": "Animation width",
        "default": 800
      }
    ]
  },
    {
      "type": "icon_text",
      "name": "Icon with Text",
