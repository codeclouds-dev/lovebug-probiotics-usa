              { "value": "h6", "label": "H6"}
              ],
          "label": "Header Style",
          "default": "h1"
        },

        {
          "type": "header",
          "content": "Bold Settings"
        },
        {
            "type": "color",
            "id": "bold_color",
            "label": "Bold Color"
        },
        {
            "type": "color",
            "id": "underline_color",
            "label": "Underline Color",
