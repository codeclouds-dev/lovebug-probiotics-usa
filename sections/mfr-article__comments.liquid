{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% if section.settings.border_bottom %}
  <style>
    #shopify-section-{{ section.id }} {
      position: relative;
      &:before {
        content: '';
        pointer-events: none;
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1.5px;
        background: linear-gradient(130deg,#795A2E,#4F391F);
        z-index: 2;
      }
    }
  </style>
{% endif %}

{% render 'style-tags__section', asset_file_name: "mfr-article__comments.css" %}
{%- assign text_alignment = section.settings.text_alignment -%}
{%- assign container_width = section.settings.container_width -%}
{%- assign max_width = section.settings.max_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}

{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{%- if max_width != 0 and container_width == "" -%}
  {%- capture max_width_style -%}
    style="max-width: {{ max_width }}rem;" 
  {%- endcapture -%}
{%- endif -%}



{% if section.settings.text_alignment != blank %}
  {% assign content_alignment = "align-center" %}
{% else %}
  {% assign content_alignment = "" %}
{% endif %}

{% assign icons = section.blocks | where: "type", "icon" %}
{% assign small_texts = section.blocks | where: "type", "small_text" %}
{% assign headings = section.blocks | where: "type", "heading" %}
{% assign texts = section.blocks | where: "type", "text" %}
{% assign buttons = section.blocks | where: "type", "button" %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %}

{% capture comment_form %}
    <div class="article-comments__form"
      data-mfr-comment-form>
        {% form 'new_comment', article %}
            <input type="hidden" name="comment[body]">

            <div class="article-comments__form-stars">
                <div class="article-comments__form-stars-inner">
                    {% for i in (1..5) %}
                        <label>
                            <input type="radio" name="stars" value="{{ i }}" {% if forloop.last %}checked{% endif %} />
                            {% for star in (1..i) %}
                                <span class="icon">★</span>
                            {% endfor %}
                        </label>
                    {% endfor %}
                </div>
            </div>
            <div class="article-comments__form-input">
                <input type="text" name="comment[author]" placeholder="Your name">
            </div>
            <div class="article-comments__form-input">
                <input type="email" name="comment[email]" placeholder="Your email">
            </div>
            <div class="article-comments__form-input">
                <input type="text" name="title" placeholder="Your Comment Title">
            </div>
            <div class="article-comments__form-input">
                <textarea name="content" placeholder="Your Comment Description"></textarea>
            </div>
            
            <button class="button primary">Submit</button>
        {% endform %}
    </div>
{% endcapture %}

{% capture comment_list %}
    {% if article.comments_count >= 1 %}
        <div class="article-comments__list" data-load-more="3">
            {% for comment in article.comments %}
                {% assign name = comment.author %}
                {% assign body =  comment.content | strip_html | split: "|" %}
                {% assign star_count = body[0] %}
                {% assign title = body[1] %}
                {% assign content = body[2] %}
                {% assign date = comment.created_at | date: "%m/%d/%Y" %}
                <div class="article-comments__entry" data-load-more-entry>
                    <div class="article-comments__entry-header">
                        <div class="article-comments__entry-avatar">
                            {%- capture star_svg -%}
