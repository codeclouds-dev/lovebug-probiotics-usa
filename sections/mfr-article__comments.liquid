                                        </g>
                                    </g>
                                </svg>
                            {%- endcapture -%}
                            {% assign first = name | split: " " | first | first %}
                            {% assign last = name | split: " " | last | first %}

                            {% render "component__svg-encoder", svg_code: star_svg, alt: "Star icon" %}
                            {{ first }}{{ last }}
                        </div>
                        <div class="article-comments__entry-name">
                            <span>{{ name }}</span>
                            <span>
                                {% for star in (1..star_count) %}
                                    <span class="icon">★</span>
                                {% endfor %}
                            </span>
                        </div>
                        <div class="article-comments__entry-date">
                            {{ date }}
                        </div>
                    </div>

                    <div class="article-comments__entry-body">
                        {% if title != blank %}
                            <div class="article-comments__entry-title">
                                {{ title }}
                            </div>
                        {% endif %}
                        {% if content != blank %}
                            <div class="article-comments__entry-content">
                                {{ content }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endcapture %}

{% comment %}
  Insert your custom section content here 
{% endcomment %}
{% capture custom_section_content %}
  <div class="article-comments">
    {{ comment_list }}
    {{ comment_form }}
  </div>
{% endcapture %}

<section class="mfr-article__comments {{ custom_class }} " id="{{ section_id }}" >
  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}

  <div class="section-spacer background {{ grid_gutter }}" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}" {{ max_width_style }}>
      <div class="grid-x align-center">
        {% if icons != blank or small_texts != blank or headings != blank or texts != blank %}
          <div class="cell small-12 large-12 section-content {{ color_theme }} {{ text_alignment }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %}
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                
                    
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
                    
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}

                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        {% endif %}

        {% if article.comments_enabled? %}
          <div class="cell small-12 article-comments__wrapper">
              {{ custom_section_content }}
          </div>
        {% endif %}

        {% if buttons != blank %}
          <div class="cell small-12 large-12">
            <div class="button-set {{ content_alignment }}">
              {%- for block in section.blocks -%}
                {% case block.type %}
                  {%- when 'button' -%}
                    {% render 'renderer__block-button', block: block %}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

  </div>
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>
{% render 'script__section', file: "mfr-comment-form.js" %}


{% schema %}
{
  "name":"Article: Comments",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings":[
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
          { "value": "", "label": "Left" },
          { "value": "text-center", "label": "Center" }
          ],
      "label": "Text Alignment",
      "default": "text-center"
    },
    {
      "type": "select",
      "id": "container_width",
      "options": [
          { "value": "full", "label": "Full" },
          { "value": "", "label": "Contain" }
          ],
      "label": "Width",
      "default": "full"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 0
    },
    {
      "type": "select",
      "id": "grid_gutter",
      "options": [
          { "value": "grid-gutter", "label": "Padding" },
          { "value": "", "label": "No Padding" }
          ],
      "label": "Section Padding",
      "default": ""
    },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },

    {
      "type": "header",
      "content": "Mobile Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type": "header",
      "content": "Desktop Section Spacing"
    },
    {
      "type": "range",
      "id": "top_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Top Spacing",
      "default": 100
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 100
    },

    {
      "type":"header",
      "content":"Background"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color/Gradient"
    },

    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image - Mobile"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image - Desktop"
    },


    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "top_wave_divider",
      "label": "Top Wave Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bottom_wave_divider",
      "label": "Bottom Wave Divider",
      "default": false
    },
    {
      "type":"header",
      "content":"Attribute Settings"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    }
  ],
  "blocks":[
    {
      "type": "icon", 
      "name": "Icon",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "file_lottie_url",
          "label": "File Lottie URL"
        },
        {
          "type": "number",
          "id": "icon_width",
          "label": "Image width",
          "default": 150,
          "info": "in pixels."
        }
      ]
    },
    {
      "type":"small_text",
      "name":"Accent Text",
      "limit":1,
      "settings":[
        {
          "type":"text",
          "id":"text",
          "default":"Accent Text",
          "label":"Text"
        },
        {
          "type": "color",
          "id": "small_text_color",
          "label": "Color"
        }
      ]
    },
    
    {
      "type": "heading",
      "name": "Heading",
      "limit": 4,
      "settings": [
        {
          "type": "inline_richtext",
