<section class="notmademarket">
    <div class="grid-container">

       
        <div class="market-dpertment-row">
          
            <div class="content-area">

               <div class="dotwrap">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
              </div>

              

                <!-- heading goes here -->
          {%- for block in section.blocks -%}
            {% case block.type %}

            

              {%- when 'heading' -%}
                {% render 'renderer__block-title', block: block %}    
                {%- endcase -%}
            
          {%- endfor -%} 
               {{ section.settings.text }}

                <div class="signaturearea">
                    
                     <img src="{{ section.settings.signature | image_url: width: 300 }}" alt="signature" class="signature">

                     {{ section.settings.text1 }}
                    
                </div>
            </div>
           {% if section.settings.img1  %}
            <div class="imagearea">
                {{ section.settings.img1  | image_url: width: 900 | image_tag }}
            </div>
          {% endif %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Marketing Dept",

  "settings": [
  
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
      {
      "type": "image_picker",
      "id": "img1",
      "label": "Icon Image"
    },
     {
      "type": "textarea",
      "id": "text1",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id":"signature",
      "label": "Signature"
    }
  ],
  "blocks": [
   
    {
      "type": "heading",
      "name": "Main Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "NOT MADE IN A MARKETING DEPARTMENT"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "label": "Header Style",
          "default": "h1",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ]
        }
      ]
    },
    {
      "type": "image",
      "name": "Small Image",
      
      "settings": [
       
      
      ]
    },
   
  ],
  "presets": [
    {
      "name": "Marketing Dept",
      "blocks": [
      
        { "type": "heading" },
        { "type": "image" },
       
      ]
    }
  ]
}
{% endschema %}