{% render 'renderer__color-scheme', name: "header", color_scheme: section.settings.color_scheme, selector: "header.header .header__wrapper" %}
{% render 'renderer__color-scheme', name: "header", color_scheme: section.settings.color_scheme_sticky, selector: "header.header.header--sticky .header__wrapper" %}

{% if section.settings.logo_position == 'center' %}
  {% assign is_logo_centered = "header--logo-centered" %}
{% endif %}

{% if section.settings.menu_display == 'hamburger' %}
  {% assign menu_display = "mobile" %}
{% elsif section.settings.menu_display == "standard" %}
  {% assign menu_display = "standard" %}
{% else %}
  {% assign menu_display = "both" %}
{% endif %}

{% assign appear_on = section.settings.appear_on | newline_to_br | strip_newlines | split: '<br />' %}
{% assign layout_mobile = section.settings.layout_mobile %}
{% assign layout_desktop = section.settings.layout_desktop %}
{% assign mega_menus = section.blocks | where: "type", "mega_menu" %}
{% assign mega_menu_products = section.blocks | where: "type", "mega_menu_product" %}
{% assign mega_menu_menus = section.blocks | where: "type", "mega_menu_menu" %}
{% assign mega_menu_ctas = section.blocks | where: "type", "mega_menu_cta" %}

{% if request.design_mode %}
  {% assign design_mode_class = "design-mode" %}
{% endif %}

{% capture header_logo %}
  {% render "component__header-logo" %}
{% endcapture %}

{% capture header_search %}
  <div class="header__search show-for-large">
    {% render 'header__search', searches: section.settings.searches, searches_heading: section.settings.searches_heading, icon_as_svg: true %}
  </div>
{% endcapture %}

{% capture header_contact %}
  <a href="#offCanvasContact" class="header__contact show-for-large"
    aria-label="{{ section.settings.contact_label }}"
    title="{{ section.settings.contact_label }}">
    {% if section.settings.contact_icon != blank %}
      {{ section.settings.contact_icon 
        | image_url: width: 46
        | image_tag: width: 46,
          widths: "46",
          alt: "account icon" }}
      <span class="visually-hidden">{{ section.settings.contact_label }}</span>
    {% else %}
      <span>{{ section.settings.contact_label }}</span>
    {% endif %}
  </a>
{% endcapture %}

{% capture header__menu %}
  {%- if section.settings.menu != blank -%}      
    <nav class="header__menu header-menu left {{ menu_display }}">

      <ul class="header-menu__items">
        {%- for link in section.settings.menu.links -%}
          {% assign assigned_mega_menus = mega_menus | map: "settings" | where: "trigger_label", link.title %}
          
          <li class="header-menu__item {% if assigned_mega_menus != blank %}mega-menu__trigger{% endif %}">
            <a class="header-menu__title mega-menu__trigger-anchor" href="{{ link.url }}"
              aria-label="{{ link.title }}"
              title="{{ link.title }}"
              {% if assigned_mega_menus != blank %}aria-expanded="false"{% endif %}>
              <span>{{ link.title }}</span>
              
            </a>
            {%- if assigned_mega_menus != blank -%}
              {% for mega_menu in assigned_mega_menus %}
                {% assign assigned_mega_menu_products = mega_menu_products 
                    | map: "settings" 
                    | where: "mega_menu_handle", mega_menu.handle %}
                {% assign assigned_mega_menu_menus = mega_menu_menus
                    | map: "settings" 
                    | where: "mega_menu_handle", mega_menu.handle %}
                {% assign assigned_mega_menu_ctas = mega_menu_ctas
                    | map: "settings" 
                    | where: "mega_menu_handle", mega_menu.handle %}
                {% render 'header__mega-menu',
                  mega_menu: mega_menu, 
                  products: assigned_mega_menu_products,
                  menus: assigned_mega_menu_menus,
                  ctas: assigned_mega_menu_ctas %}
              {% endfor %}
            {%- elsif link.links != blank -%}
              <div class="header-menu__submenu header-submenu">
                <ul class="header-submenu__items">
                  {%- for child_link in link.links -%}
                    <li>
                      <a href="{{ child_link.url }}" title="{{ child_link.title }}">
                        <span>{{ child_link.title }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>

              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

    </nav>  <!-- .header__menu -->
  {%- endif -%}
{% endcapture %}

{% capture header__right-menu %}
  {%- if section.settings.right_menu != blank -%}      
    <nav class="header__menu header-menu right">

      <ul class="header-menu__items">
        {%- for link in section.settings.right_menu.links -%}
          {% assign assigned_mega_menus = mega_menus | map: "settings" | where: "trigger_label", link.title %}
          <li class="header-menu__item {% if assigned_mega_menus != blank %}mega-menu__trigger{% endif %}">
            <a class="header-menu__title mega-menu__trigger-anchor" href="{{ link.url }}"
              aria-label="{{ link.title }}"
              title="{{ link.title }}"
              {% if assigned_mega_menus != blank %}aria-expanded="false"{% endif %}>
              <span>{{ link.title }}</span>
             
            </a>
            {%- if assigned_mega_menus != blank -%}
              {% for mega_menu in assigned_mega_menus %}
                {% assign assigned_mega_menu_products = mega_menu_products 
                    | map: "settings" 
                    | where: "mega_menu_handle", mega_menu.handle %}
                {% assign assigned_mega_menu_menus = mega_menu_menus
                    | map: "settings" 
                    | where: "mega_menu_handle", mega_menu.handle %}
                {% assign assigned_mega_menu_ctas = mega_menu_ctas
                    | map: "settings" 
                    | where: "mega_menu_handle", mega_menu.handle %}
                {% render 'header__mega-menu',
                  mega_menu: mega_menu, 
                  products: assigned_mega_menu_products,
                  menus: assigned_mega_menu_menus,
                  ctas: assigned_mega_menu_ctas %}
              {% endfor %}
            {%- elsif link.links != blank -%}
              <div class="header-menu__submenu header-submenu">
                <ul class="header-submenu__items">
                  {%- for child_link in link.links -%}
                    <li>
                      <a href="{{ child_link.url }}" title="{{ child_link.title }}">
                        <span>{{ child_link.title }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>

              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

    </nav>  <!-- .header__menu -->
  {%- endif -%}
{% endcapture %}

{% capture cart_icon %}
  <div class="header__cart {% if section.settings.show_cart_icon != blank %}has-icon{% endif %} cart" 
    role="button"
    x-data
    x-on:click='$store["offCanvasCart"].openOffcanvas()'
    :aria-expanded='$store["offCanvasCart"].open'>
    <noscript>
    <a href="/cart" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; text-indent: -9999999rem; z-index: 2;">Cart</a>
    </noscript>
    <div class="header__cart-inner">
      <div class="cart__icon">
        {% if section.settings.show_cart_icon %}
          {% render 'icon__cart' %}
        {% else %}
          Cart
        {% endif %}
      </div>
      <div class="cart__number">
        <span class="cart__count" data-cart-render="item_count">
          <span>0</span>
        </span>
      </div>
    </div>
  </div>
{% endcapture %}

{% capture account_icon %}
  <a href="/account" class="header__account {% if section.settings.account_icon != blank %}has-icon{% endif %} cart" role="button">
    {% if section.settings.account_icon != blank %}
      {{ section.settings.account_icon 
        | image_url: width: 46
        | image_tag: width: 46,
          widths: "46",
          alt: "account icon" }}
    {% else %}
      <span>{{ section.settings.account_label }}</span>
    {% endif %}
  </a>
{% endcapture %}

{% capture header_inline_styling %}
  --header-offset-mobile: {{ section.settings.offset_mobile }}px;
  --header-offset-desktop: {{ section.settings.offset_desktop }}px;
  --header-offset-sticky-mobile: {{ section.settings.offset_sticky_mobile }}px;
  --header-offset-sticky-desktop: {{ section.settings.offset_sticky_desktop }}px;
  --header-border-radius-mobile: {{ section.settings.border_radius_mobile }}px;
  --header-border-radius-desktop: {{ section.settings.border_radius_desktop }}px;
  --header-border-radius-sticky-mobile: {{ section.settings.sticky_border_radius_mobile }}px;
  --header-border-radius-sticky-desktop: {{ section.settings.sticky_border_radius_desktop }}px;
{% endcapture %}
{% if appear_on == blank or appear_on contains template %}
  <div class="header__wrapper {{ header_wrapper_class }}  {{ design_mode_class }} {{ is_logo_centered }}"
    style="{{ header_inline_styling }}">
    <div class="header__inner">
      <div class="header__wrapper-inner {{ layout_mobile }}--mobile {{ layout_desktop }}--desktop">
        <div class="header__left">

          <button aria-label="Mobile Menu Trigger" 
            class="mobile-menu-trigger {{ menu_display }}" 
            type="button"
            x-data
            x-on:click='$store["offCanvasMenu"].toggleOffcanvas()'
            :aria-expanded='$store["offCanvasMenu"].open'>
            <span></span>
            <span></span>
            <span></span>
            <div class="menu-text">Menu</div>
          </button>

          {{ header__menu }}
          
        </div> <!-- .header__left -->
        
        <div class="header__center">
          {{ header_logo }}
        </div>

        <div class="header__right">

          {{ header__right-menu }}

          {% if section.settings.show_search_bar != blank %}
            {{ header_search }}
          {% endif %}

          {% if section.settings.show_contact_cta != blank %}
            {{ header_contact }}
          {% endif %}

          {% if section.settings.show_account_cta != blank %}
            {{ account_icon }}
          {% endif %}

          {% if section.settings.show_cart_cta != blank %}
            {{ cart_icon }}
          {% endif %}

          
        </div> <!-- .header__right -->
      </div>
    </div>
  </div> <!-- .header__wrapper -->
{% else %}
  <style>
    #shopify-section-{{- section.id -}} {
      visibility: hidden;
      display: none;
    }
  </style>
{% endif %}

{% schema %}
  {
    "name": "Header",
    "enabled_on": {
      "groups": ["header"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo_icon",
        "label": "Logo Icon",
        "info": "This will appear beside the logo and will only appear on desktop."
      },
      {
        "type": "text",
        "id": "logo_lottie_url",
        "label": "Logo Lottie Url"
      },
      {
        "type": "header",
        "content": "Layout Settings"
      },
      {
        "type": "select",
        "id": "layout_mobile",
        "label": "Layout - Mobile",
        "options": [
          {
            "value": "logo-left",
            "label": "Logo Left"
          },
          {
            "value": "logo-left-contained",
            "label": "Logo Left (Contained Left)"
          },
          {
            "value": "logo-left-contained-right",
            "label": "Logo Left (Contained Right)"
          },
          {
            "value": "logo-center",
            "label": "Logo Center"
          },
          {
            "value": "logo-center-contained-left",
            "label": "Logo Center (Contained Left)"
          },
          {
            "value": "logo-center-contained-right",
            "label": "Logo Center (Contained Right)"
          }
        ],
        "default": "logo-left"
      },
      {
        "type": "select",
        "id": "layout_desktop",
        "label": "Layout - Desktop",
        "options": [
          {
            "value": "logo-left-contained",
            "label": "Logo Left (Menu Left)"
          },
          {
            "value": "logo-left",
            "label": "Logo Left (Menu Center)"
          },
          {
            "value": "logo-left-contained-right",
            "label": "Logo Left (Menu Right)"
          },
          {
            "value": "logo-center",
            "label": "Logo Center"
          }
        ],
        "default": "logo-left"
      },
      {
        "type": "header",
        "content": "Color Schemes Settings"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color Scheme",
        "info": "This will be the color scheme of the header initially."
      },
      {
        "type": "color_scheme",
        "id": "color_scheme_sticky",
        "default": "scheme_1",
        "label": "Color Scheme (When Sticky)",
        "info": "This will be the color scheme of the header when sticky."
      },
      {
        "type": "header",
        "content": "Layout Settings"
      },
      {
        "type": "range",
        "id": "offset_mobile",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Offset - Mobile",
        "default": 0,
        "info": "This will give header offset from top, left and right on mobile."
      },
      {
        "type": "range",
        "id": "offset_desktop",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Offset - Desktop",
        "default": 0,
        "info": "This will give header offset from top, left and right on desktop."
      },
      {
        "type": "range",
        "id": "offset_sticky_mobile",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Sticky Offset - Mobile",
        "default": 0,
        "info": "This will give header offset from top, left and right on mobile when header goes sticky."
      },
      {
        "type": "range",
        "id": "offset_sticky_desktop",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Sticky Offset - Desktop",
        "default": 0,
        "info": "This will give header offset from top, left and right on desktop when header goes sticky."
      },
      {
        "type": "range",
        "id": "border_radius_mobile",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Border Radius - Mobile",
        "default": 0
      },
      {
        "type": "range",
        "id": "border_radius_desktop",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Border Radius - Desktop",
        "default": 0
      },
      {
        "type": "range",
        "id": "sticky_border_radius_mobile",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Sticky Border Radius - Mobile",
        "default": 0
      },
      {
        "type": "range",
        "id": "sticky_border_radius_desktop",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Sticky Border Radius - Desktop",
        "default": 0
      },
      {
        "type": "header",
        "content": "Menu Settings"
      },
      {
        "type": "select",
        "id": "menu_display",
        "label": "Desktop Menu display",
        "options": [
          {
            "value": "standard",
            "label": "Standard"
          },
          {
            "value": "hamburger",
            "label": "Hamburger"
          },
          {
            "value": "both",
            "label": "Both"
          }
        ],
        "default": "standard"
      },
      {
        "type": "link_list",
        "id": "menu",
        "label": "Left Menu"
      },
      {
        "type": "link_list",
        "id": "right_menu",
        "label": "Right Menu"
      },

      {
        "type": "header",
        "content": "Cart Settings"
      },
      {
        "type": "checkbox",
        "id": "show_cart_cta",
        "label": "Show Cart CTA",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_cart_icon",
        "label": "Show Cart Icon",
        "default": false
      },
      {
        "type": "header",
        "content": "Search Settings"
      },
      {
        "type": "checkbox",
        "id": "show_search_bar",
        "label": "Show Search Bar",
        "default": true
      },
      {
        "type": "header",
        "content": "Account Settings"
      },
      {
        "type": "checkbox",
        "id": "show_account_cta",
        "label": "Show Account CTA",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "account_icon",
        "label": "Account Icon"
      },
      {
        "type": "text",
        "id": "account_label",
        "label": "Account Label",
        "default": "Account"
      },
      {
        "type": "header",
        "content": "Contact Settings"
      },
      {
        "type": "checkbox",
        "id": "show_contact_cta",
        "label": "Show Contact CTA",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "contact_icon",
        "label": "Contact Icon"
      },
      {
        "type": "text",
        "id": "contact_label",
        "label": "Contact Label",
        "default": "Contact Us"
      },
      {
        "type": "header",
        "content": "Visibility Settings"
      },
      {
        "type": "textarea",
        "id": "appear_on",
        "label": "Appear Only On:",
        "info": "Separated by newline. Insert template.suffix. Example: product or product.bundles"
      }
    ],
    "blocks": [
      {
        "type": "mega_menu",
        "name": "Mega Menu",
        "settings": [
          {
            "type": "text",
            "id": "trigger_label",
            "label": "Trigger Label",
            "default": "Shop"
          },
          {
            "type": "text",
            "id": "handle",
            "label": "Mega Menu Handle",
            "default": "mega-menu-1",
            "info": "Unique identifier. Use this to assign megamenu child blocks to this mega menu."
          },
          {
            "type": "text",
            "id": "products_label",
            "label": "Products Label",
            "default": "Featured"
          }
        ]
      },
      {
        "type": "mega_menu_product",
        "name": "Mega Menu: Product",
        "settings": [
          {
            "type": "text",
            "id": "mega_menu_handle",
            "label": "Mega Menu Handle",
            "default": "mega-menu-1"
          },
          {
            "type": "header",
            "content": "Block Settings"
          },
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          },
          {
            "type": "text",
            "id": "product_badge",
            "label": "Product Badge",
            "default": "Best Seller"
          }
        ]
      },
      {
        "type": "mega_menu_menu",
        "name": "Mega Menu: Menu",
        "settings": [
          {
            "type": "text",
            "id": "mega_menu_handle",
            "label": "Mega Menu Handle",
            "default": "mega-menu-1"
          },
          {
            "type": "header",
            "content": "Block Settings"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "Label"
          },
          {
            "type": "link_list",
            "id": "menu",
            "label": "Menu",
          }
        ]
      },
      {
        "type": "mega_menu_cta",
        "name": "Mega Menu: CTA",
        "settings": [
          {
            "type": "text",
            "id": "mega_menu_handle",
            "label": "Mega Menu Handle",
            "default": "mega-menu-1"
          },
          {
            "type": "header",
            "content": "Block Settings"
          },
          {
            "type": "text",
            "id": "button_label",
            "default": "Button label",
            "label": "Button",
            "info": "Leave the label blank to hide the button."
          },
          {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
          },
          {
            "type": "select",
            "id": "color_theme",
            "label": "Color Theme",
            "options": [
              {
                "value": "primary",
                "label": "Primary"
              },
              {
                "value": "secondary",
                "label": "Secondary"
              },
              {
                "value": "tertiary",
                "label": "Tertiary"
              }
            ]
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Header"
      }
    ]
  }
{% endschema %}

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "name": "{{ shop.name }}",
  {% if section.settings.logo %}
    {% assign image_size = section.settings.logo.width | append:'x' %}
    "logo": "https:{{ section.settings.logo | img_url: image_size }}",
  {% endif %}
  "sameAs": [
    "{{ settings.social_twitter_link }}",
    "{{ settings.social_facebook_link }}",
    "{{ settings.social_pinterest_link }}",
    "{{ settings.social_instagram_link }}",
    "{{ settings.social_tumblr_link }}",
    "{{ settings.social_snapchat_link }}",
    "{{ settings.social_youtube_link }}",
    "{{ settings.social_vimeo_link }}"
  ],
  "url": "{{ shop.url }}{{ page.url }}"
}
</script>

{% if template.name == "index" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": "{{ shop.name }}",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      },
      "url": "{{ shop.url }}{{ page.url }}"
    }
  </script>
{% endif %}
