{% render 'renderer__color-scheme', name: "footer", color_scheme: section.settings.color_scheme, selector: ".footer__main" %}
{% assign appear_on = section.settings.appear_on | newline_to_br | strip_newlines | split: '<br />' %}

{% assign embed = section.blocks | where: "type", "embed" | first %}
{% assign menus = section.blocks | where: "type", "menu" %}

{% if appear_on == blank or appear_on contains template %}
  <div class="footer__divider">
    
    <lottie-player src="{{ 'wave-divider__top--desktop.json' | asset_url }}"  
      background="transparent"  
      speed="1"
      loop
      autoplay>
    </lottie-player>
  </div>
  {%- unless template.suffix == 'baby-drops-lp' -%}
    <div class="grid-container grid-x" data-inview>
      <div class="cell small-12 footer__contents">
        {% if embed != blank %}
          <div class="footer__embed" 
            data-stagger-inview=".footer__embed-icon,.footer__embed-heading,.footer__embed-caption,.footer__embed-code">
            <div class="footer__embed-header">
              {% if embed.settings.icon != blank %}
                <div class="footer__embed-icon">
                  {% assign default_alt = "maybe an image about " | default: embed.settings.title %}
                  {% assign alt = embed.settings.icon.alt | default: default_alt %}
                  {% render 'component__lazyload-image',
                    image: embed.settings.icon,
                    width: 144,
                    alt: alt %}
                </div>
              {% endif %}
              {% if embed.settings.heading != blank %}
                <p class="h4 footer__embed-heading">
                  {{ embed.settings.heading }}
                </p>
              {% endif %}
            </div>
            {% if embed.settings.caption != blank %}
              <p class="footer__embed-caption">
                {{ embed.settings.caption }}
              </p>
            {% endif %}
            {% if embed.settings.embed_code != blank %}
              <div class="footer__embed-code">
                {{ embed.settings.embed_code | newline_to_br }}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if menus != blank %}
          <template
            x-data="{ isSmallScreen: window.outerWidth <= 1023 }" 
            x-init="
              window.addEventListener('resize', () => {
                isSmallScreen = window.outerWidth <= 1023;
              });
            "
            x-if="isSmallScreen">
            <div class="footer__menus">
              {% for menu in menus %}
                {%- capture accordion_content -%}
                  {% if menu.settings.menu != blank %}
                    <ul class="footer__menu-list">
                      {% for link in menu.settings.menu.links %}
                        <li>
                          <a href="{{ link.url }}"
                            aria-label="{{ link.title }}"
                            title="{{ link.title }}">
                            <span>{{ link.title }}</span>
                          </a>
                        </li>
                      {% endfor %}
                      {% if menu.settings.show_accessibe_trigger %}
                        <li>
                          <a href="#" data-acsb-custom-trigger="true"
                            title="Accessibility"
                            aria-label="Accessibility">
                            Accessibility
                          </a>
                        </li>
                      {% endif %}
                    </ul>
                  {% endif %}
                {%- endcapture -%}
                {% render 'mfr-component__accordion',
                  block_id: menu.id,
                  class: "footer__menu",
                  trigger_class: "footer__menu-label",
                  trigger_label: menu.settings.heading,
                  content_class: "",
                  content: accordion_content %}
              {% endfor %}
            </div>
          </template>
          <template
            x-data="{ isSmallScreen: window.outerWidth <= 1023 }" 
            x-init="
              window.addEventListener('resize', () => {
                isSmallScreen = window.outerWidth <= 1023;
              });
            "
            x-if="!isSmallScreen">
            <div class="footer__menus">
              {% for menu in menus %}
                <div class="footer__menu">
                  <p class="footer__menu-label">
                    {{ menu.settings.heading }}
                  </p>
                  <ul class="footer__menu-list">
                    {% for link in menu.settings.menu.links %}
                      <li>
                        <a href="{{ link.url }}"
                          aria-label="{{ link.title }}"
                          title="{{ link.title }}">
                          <span>{{ link.title }}</span>
                        </a>
                      </li>
                    {% endfor %}
                    {% if menu.settings.show_accessibe_trigger %}
                      <li>
                        <a href="#" data-acsb-custom-trigger="true"
                          title="Accessibility"
                          aria-label="Accessibility">
                          Accessibility
                        </a>
                      </li>
                    {% endif %}
                  </ul>
                </div>
              {% endfor %}
            </div>
          </template>
        {% endif %}
      </div>
    </div>
  {%- endunless -%}
{% else %}
  <style>
    #shopify-section-{{- section.id -}} {
      visibility: hidden;
      display: none;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Footer",
  "class": "footer__main",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Color Schemes Settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color Scheme",
      "info": "This will be the color scheme of the footer initially."
    },
    {
      "type": "header",
      "content": "Visibility Settings"
    },
    {
      "type": "textarea",
      "id": "appear_on",
      "label": "Appear Only On:",
      "info": "Separated by newline. Insert template.suffix. Example: product or product.bundles"
    }
  ],
  
  "blocks": [
    {
      "type": "embed",
      "name": "Embed",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lorem, ipsum dolor."
        },
        {
          "type": "textarea",
          "id": "caption",
          "label": "Caption",
          "default": "Lorem ipsum dolor sit amet consectetur adipisicing elit"
        },
        {
          "type": "textarea",
          "id": "embed_code",
          "label": "Embed Code"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "checkbox",
          "id": "show_accessibe_trigger",
          "label": "Show Accessibe Trigger",
          "default": false
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
