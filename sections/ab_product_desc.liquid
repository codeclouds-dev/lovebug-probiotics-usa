<section class="ab-product-description">
  <div class="grid-container">
    <div class="grid-x align-center">
      <div class="cell small-12 section-content text-center">
        <div class="inner">

          {%- for block in section.blocks -%}
            {% case block.type %}

              {%- when 'small_text' -%}
                {% render 'renderer__block-small-text', block: block %}

              {%- when 'heading' -%}
                {% render 'renderer__block-title', block: block %}

              {%- when 'intro_text' -%}
                {% render 'renderer__block-text', block: block %}

              {%- when 'description_text' -%}
                {% render 'renderer__block-text', block: block %}

            {%- endcase -%}
          {%- endfor -%}

        </div>
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Ab Product Description",
  "blocks": [
    {
      "type": "small_text",
      "name": "Small Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "PRODUCT DESCRIPTION"
        },
        {
          "type": "color",
          "id": "small_text_color",
          "label": "Color"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Main Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "THE 6-STRAIN \"GUT SHIELD\" EVERY NEWBORN NEEDS FROM DAY 1."
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        },
        {
          "type": "select",
          "id": "header_style",
          "label": "Header Style",
          "default": "h1",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ]
        }
      ]
    },
    {
      "type": "intro_text",
      "name": "Intro Line",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p><strong>Build the foundation. Stop the tears.</strong></p>"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        }
      ]
    },
    {
      "type": "description_text",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "<p>Colic. Eczema. Crying. It isn't \"bad luck.\" It's a gut deficiency...</p>"
        },
        {
          "type": "checkbox",
          "id": "disable_animation",
          "label": "Disable Animation",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ab Product Description",
      "blocks": [
        { "type": "small_text" },
        { "type": "heading" },
        { "type": "intro_text" },
        { "type": "description_text" }
      ]
    }
  ]
}
{% endschema %}
