{%- comment -%}
--------------------------------------
assign section settings to variables
--------------------------------------
{%- endcomment -%}

{% render 'style-tags__section', asset_file_name: "mfr-core__image-with-tooltips.css" %}
{%- assign container_width = section.settings.container_width -%}
{%- assign grid_gutter = section.settings.grid_gutter -%}
{%- assign content_alignment = 'align-center' -%}
{%- assign color_theme = section.settings.color_theme -%}
{%- assign custom_class = section.settings.custom_class -%}
{%- assign section_id = section.settings.custom_id | default: section.id -%}
{% render 'renderer__color-scheme', name: "section", color_scheme: section.settings.color_scheme, selector: ".shopify-section", section_id: section_id %}

{% assign buttons = section.blocks | where: "type", "button" %}
{% assign icon_texts = section.blocks | where: "type", "icon_text" %}
{% assign first_icon_text = icon_texts | first %}
{% assign metafields = product.metafields.mfr_fields %}

{% capture spacer %}
  --top-spacing-mobile: {{ section.settings.top_spacing_mobile }}px;
  --bottom-spacing-mobile: {{ section.settings.bottom_spacing_mobile }}px;
  --top-spacing-desktop: {{ section.settings.top_spacing_desktop }}px;
  --bottom-spacing-desktop: {{ section.settings.bottom_spacing_desktop }}px;
{% endcapture %} 

{% capture custom_section_content %}
  <!-- Render central image -->
  {% for block in section.blocks %}
  {% if block.type == 'image' %}
    {% style %}
      #{{ section_id }} .central-image {
        --central_image_max_width_desktop: {{ block.settings.image_max_width }}px;
        --central_image_max_width_mobile: {{ block.settings.image_max_width_mobile }}px;
        --central_image_rotation: {{ block.settings.image_rotation }}px;
      }
    {% endstyle %}
    <div class="central-image" data-inview>
      <div class="central-image__inner">
        <div class="parallax-helper">
          {% if section.settings.priority_metafields %}
            {% assign image = metafields.image_with_tooltips_image.value | default: block.settings.image %}
          {% else %}
            {% assign image = block.settings.image %}
          {% endif %}
          {% if image != blank %}
            {% render 'component__responsive-image',
              mobile_image: image,
              desktop_image: image,
              max_width: 1600,
              loading_lazy: true %}
          {% else %}
            <div class="shopify-placeholder-image">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
{% endfor %}

<!-- Render text tooltip blocks -->
{% assign tooltip_index = 0 %} <!-- Initialize index used to set hardcoded variables for PDP only -->

{% for block in section.blocks %}
  {% if block.type == 'text_tooltip' %}
    {% if template contains 'product' %}
      {% assign tooltip_index = tooltip_index | plus: 1 %}
    {% endif %}
    {% render 'image-with-tooltips__tooltip',
      index: tooltip_index,
      text_position: block.settings.text_position,
      text_position_vertical: block.settings.text_position_vertical,
      rotation: block.settings.icon_rotation,
      position_x_mobile: block.settings.position_x_mobile,
      position_y_mobile: block.settings.position_y_mobile,
      position_x: block.settings.position_x,
      position_y: block.settings.position_y,
      title: block.settings.title,
      tooltip: block.settings.tooltip,
      icons_color: section.settings.color_scheme.settings.icons %}
  
  {% endif %}
{% endfor %}
{% endcapture %}

<section id="{{ section_id }}" class="mfr-core__image-with-tooltips {{ custom_class }}">
  <div id="{{ section.settings.page_anchor }}"></div>

  <div class="section-spacer {{ grid_gutter }} background" style="{{ spacer }}">
    <div class="grid-container {{ container_width }}">
      <div class="inner">
        <div class="grid-x {{ content_alignment }}">
          <div class="cell small-12 section-content {{ color_theme }}">
            <div class="inner">
              {%- for block in section.blocks -%}
                {% case block.type %} 
                
                  {%- when 'icon' -%}
                    {% render 'renderer__block-icon', block: block %} 
                    
                  {%- when 'small_text' -%}
                    {% render "renderer__block-small-text", block: block %}
            
                  {%- when 'heading' -%}
                    {% render "renderer__block-title", block: block %}
                    
                  {%- when 'text' -%}
                    {% render "renderer__block-text", block: block %}
                  
                {%- endcase -%}
              {%- endfor -%}
              
              <div class="text-section-layout" data-stagger-inview=".tooltip-item">
                {{ custom_section_content }}
              </div>
              
              {% if buttons != blank %}
                <div class="button-set {{ content_alignment }}">
                  {%- for block in section.blocks -%}
                    {% case block.type %}
                      {%- when 'button' -%}
                        {% render 'renderer__block-button', block: block %}
                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- render 'component__gradient-bg-styles' -%}
  {%- render 'component__accent-graphics' -%}
  {%- render 'component__section-dividers', is_video_background: true -%}
</section>


